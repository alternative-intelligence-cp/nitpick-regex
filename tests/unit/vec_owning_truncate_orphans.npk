// expect-exit: 92
// mem-cap-mib: 64
//
// `vec_truncate` AT AN OWNING `T` ORPHANS every element it discards -- RX-155.
//
// PINNED, NOT ENDORSED. `Vec<T>` is for a NON-OWNING `T` (`SAFETY.md` S-23a),
// and this file measures what happens outside that, so the restriction rests
// on a run rather than a sentence: a `wild T->` slot does not drop, and `vec_truncate`
// discards an element without moving it out. Each round builds a `Vec<string>`
// of 257-byte bodies, applies `vec_truncate`, and releases the rest with
// `vec_free_owning`; the orphans accumulate across rounds and the program
// meets `HeapOom` under the 64 MiB cap -- **92**. `vec_owning_freed.npk` is
// the control: the same rounds without the verb, the same cap, exit 0 -- and
// the harness runs `/bin/true` under the cap first, because a low cap measures
// the loader.
//
// Measured at `c3bdae2` with the runtime's `NPK_HEAP_STATS` over 1 000 rounds
// of two elements: `peak_live` grows linearly with the rounds for this verb
// and stays flat for the control (the numbers are RX-155's table).
//
// EXIT 0 MEANS THE VERB STOPPED ORPHANING -- `vec.npk` now drops what it
// discards, which is a change to RX-155's per-verb table, so re-read it: the
// restriction may be liftable for this verb.
mod:vec_owning_truncate_orphans;

use "../../src/core/vec.npk".*;

func:main = int32(cstring[]:_~argv) {
    string:filler = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";

    int64:round = 0i64;
    while (round < 500i64) decreases 500i64 - round {
        Vec<string>:v = raw vec_init::<string>(16i64);
        int64:k = 0i64;
        while (k < 1000i64) decreases 1000i64 - k {
            // BOUND, NEVER NESTED -- an owning temporary passed straight into
            // `vec_push` would be the compiler's D-183 leak, not this verb's.
            string:e = string_concat(filler, "k");      // 257 bytes of heap body
            drop vec_push(@v, move(e));
            k = k + 1i64;
        }
        // THE VERB: truncate to empty. Every element past the new count is
        // orphaned, and `vec_free_owning` then drops nothing.
        drop vec_truncate(@v, 0i64);
        drop vec_free_owning(@v);
        round = round + 1i64;
    }

    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated) { exit 109i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
