// expect-exit: 108
//
// AN ARENA THAT IS NOT A TREE STOPS THE DUMP. Cycle 0.2.0, RX-225; `HIR.md` H-15.
//
// The writer walks the tree on an explicit stack, bounded by twice the arena: a tree
// enters and closes each node once. Here a `Repeat` wraps ITSELF, so the walk would
// write it for ever; the bound runs out and the walk traps `DecreasesViolated` (108) --
// a defect in the code that built the arena, stopped at the walk, never a dump that does
// not end. A list that loops is the count's to stop (`hir_dump_count.npk`), and a node with
// two parents is this bound's too (`hir_dump_shared.npk`).
mod:hir_dump_not_a_tree;

use "../../src/core/core.npk".*;
use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    Hir:h = raw hir_init(4i64);
    int64:r = raw hir_push(@h, HirNode{ kind: HirKind.Repeat, flags: 0u32, a: 0i64, b: 0i64, c: HIR_NONE,
                                        next: HIR_NONE });
    drop hir_set_root(@h, r);
    Bytes:b = raw bytes_init(16i64);
    drop hir_dump(@h, @b);
    drop hir_free(@h);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
