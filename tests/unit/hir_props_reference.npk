// expect-exit: 0
//
// THE COMPUTED PROPERTIES AGAINST A HAND-COMPUTED REFERENCE: FIFTY PATTERNS. Cycle 0.2.4, RX-238 and
// RX-239; `meta/specs/HIR.md` rules H-9, H-17 and H-18, and the cycle README's fourth 0.2.4 box.
//
// HAND-COMPUTED MEANS THIS. Each row below is a pattern and the four facts of its normal form's root,
// written by hand from H-17's table -- `E` the subtree may match the empty string, `S` every match begins
// at the haystack's start, `T` every match ends at its end, `L` it is a plain literal or a union of plain
// literals, `-` where a fact does not hold -- with the reading that gives them beside it. No value was
// printed by the code and copied here: every row was written from the rule's text before the pass first
// ran, and a row the pass disagrees with is read against H-17 again -- never changed to the pass's
// answer. The mutants of the pass that break H-17 -- every facet of it alone, by a row of its own -- are
// each red here but the seven that no row reaches: a list of no member or of one, and a lazy repetition,
// which `hir_props.npk` asks (the plan's block 2m).
//
// EVERY ROW ASKS THE NORMAL FORM (RX-236): each pattern is parsed, built, normalised, and the normal
// form's root asked through `hir_props`, the query a later stage will call. A row that differs, or a
// pattern that does not build, exits with the row's number; the program exits 0 only after every
// `hir_free` and `ast_free`.
mod:hir_props_reference;

use "../../src/core/core.npk".*;
use "../../src/syntax/syntax.npk".*;
use "../../src/hir/hir.npk".*;

// The facts a four-letter row names: `E`, `S`, `T` and `L` in their places, `-` for a fact that does not hold.
func:want_of = uint32(string:row) never fails {
    fixed uint8[]:w = string_bytes(row);
    uint32:f = 0u32;
    if (w[0i64] == 69u8) { f = f | HIR_CAN_MATCH_EMPTY; }
    if (w[1i64] == 83u8) { f = f | HIR_IS_ANCHORED_START; }
    if (w[2i64] == 84u8) { f = f | HIR_IS_ANCHORED_END; }
    if (w[3i64] == 76u8) { f = f | HIR_IS_ALTERNATION_LITERAL; }
    pass f;
};

// Whether `pattern`'s normal form's root has exactly the facts `row` names.
func:holds = bool(string:pattern, string:row) never fails {
    fixed uint8[]:pat = string_bytes(pattern);
    Ast:t = raw ast_init(8i64);
    bool:ok = false;
    if ((raw parse_pattern(pat, @t)) == NIL) {
        Hir:h = raw hir_init(8i64);
        if ((raw hir_build(pat, t, @h)) == HIR_NONE) {
            Hir:n = raw hir_init(8i64);
            drop hir_normalise(@h, @n);
            int64:r = n.root;
            ok = (raw hir_props(@n, r)) == (raw want_of(row));
            drop hir_free(@n);
        }
        drop hir_free(@h);
    }
    drop ast_free(@t);
    pass ok;
};

func:run = int32() never fails {
    // ---- plain literals, literal runs, and unions of them
    if (!(raw holds("a", "---L")))              { pass 1i32; }    // a `Literal`
    if (!(raw holds("abc", "---L")))            { pass 2i32; }    // a literal run: a `Concat` of `Literal`s
    if (!(raw holds("é", "---L")))              { pass 3i32; }    // one codepoint, two bytes of UTF-8
    if (!(raw holds("(?-u)a", "---L")))         { pass 4i32; }    // a byte: no fact reads the byte bit, so as `a`
    if (!(raw holds("(?-u)\\xFF", "---L")))     { pass 5i32; }    // a byte past ASCII
    if (!(raw holds("[a]", "---L")))            { pass 6i32; }    // a class of one codepoint is a `Literal` (RX-235)
    if (!(raw holds("a(?:bc)", "---L")))        { pass 7i32; }    // flattened, one run of three
    if (!(raw holds("a|b", "---L")))            { pass 8i32; }    // a union of two
    if (!(raw holds("foo|bar|baz", "---L")))    { pass 9i32; }    // a union of three runs
    if (!(raw holds("[a]|b", "---L")))          { pass 10i32; }   // two `Literal`s in the normal form (0.2.3's hand-on)
    if (!(raw holds("a|(?:b|c)", "---L")))      { pass 11i32; }   // flattened, a union of three
    if (!(raw holds("(?-u:\\xFF)|é", "---L")))  { pass 12i32; }   // a byte and a codepoint, both plain
    if (!(raw holds("a|", "E---")))             { pass 13i32; }   // the `Empty` alternative: empty, and no plain literal
    if (!(raw holds("(a)|b", "----")))          { pass 14i32; }   // a group is no plain literal
    if (!(raw holds("a|[bc]", "----")))         { pass 15i32; }   // nor is a class of two
    if (!(raw holds("a(?:b|c)", "----")))       { pass 16i32; }   // a `Concat` holding an `Alternate`: not a run
    if (!(raw holds("ab*|c", "----")))          { pass 17i32; }   // an alternative that is no run
    if (!(raw holds("(abc)", "----")))          { pass 18i32; }   // a group of a run: no plain literal
    // ---- the empty string
    if (!(raw holds("", "E---")))               { pass 19i32; }   // `Empty`
    if (!(raw holds("a*", "E---")))             { pass 20i32; }   // minimum 0
    if (!(raw holds("a+", "----")))             { pass 21i32; }   // minimum 1, and `a` cannot
    if (!(raw holds("a$|b", "----")))           { pass 22i32; }   // one alternative ends at the end, not both
    if (!(raw holds("a{0}", "E---")))           { pass 23i32; }   // minimum 0 and maximum 0
    if (!(raw holds("a{2,}", "----")))          { pass 24i32; }   // minimum 2, and `a` cannot
    if (!(raw holds("(?:a*)+", "E---")))        { pass 25i32; }   // minimum 1, and its body can
    if (!(raw holds("(a*)", "E---")))           { pass 26i32; }   // a group is its body's
    if (!(raw holds("a*b", "----")))            { pass 27i32; }   // one piece cannot
    if (!(raw holds("a*b*", "E---")))           { pass 28i32; }   // every piece can
    if (!(raw holds("\\b", "E---")))            { pass 29i32; }   // an assertion is zero-width (Y-20)
    if (!(raw holds("(?-u)\\b", "E---")))       { pass 30i32; }   // the byte bit read by none, so as `\b`
    if (!(raw holds("\\B", "E---")))            { pass 31i32; }   // not a boundary: an assertion, zero-width too
    if (!(raw holds("[a-z]", "----")))          { pass 32i32; }   // a class matches one codepoint
    if (!(raw holds("(?-u)[a-z]", "----")))     { pass 33i32; }   // or one byte, so as `[a-z]`
    if (!(raw holds("(?s).", "----")))          { pass 34i32; }   // `.` is a class
    // ---- the anchors, and the multi-line flag (`SYNTAX.md` §6, Y-19)
    if (!(raw holds("^", "ES--")))              { pass 35i32; }   // `HIR_TEXT_START`: zero-width, and at the start
    if (!(raw holds("$", "E-T-")))              { pass 36i32; }   // `HIR_TEXT_END`: only at the end
    if (!(raw holds("^$", "EST-")))             { pass 37i32; }   // first piece `^`, last `$`, both empty
    if (!(raw holds("^abc", "-S--")))           { pass 38i32; }   // its first piece anchors the start
    if (!(raw holds("abc$", "--T-")))           { pass 39i32; }   // its last the end
    if (!(raw holds("\\Aabc\\z", "-ST-")))      { pass 40i32; }   // `\A` and `\z` are the text's anchors always
    if (!(raw holds("(?m)^abc$", "----")))      { pass 41i32; }   // under `m` the lines' anchors: after and before every `\n` too
    if (!(raw holds("^a|^b", "-S--")))          { pass 42i32; }   // every alternative anchored at the start
    if (!(raw holds("^a|b", "----")))           { pass 43i32; }   // not every one
    if (!(raw holds("a$|b$", "--T-")))          { pass 44i32; }   // every alternative anchored at the end
    if (!(raw holds("(?:^a$)+", "-ST-")))       { pass 45i32; }   // minimum 1: every match begins with its body
    if (!(raw holds("(?:^a$)*", "E---")))       { pass 46i32; }   // minimum 0: the empty match anywhere
    if (!(raw holds("(^a$)", "-ST-")))          { pass 47i32; }   // a group is its body's
    if (!(raw holds("\\b^a", "----")))          { pass 48i32; }   // its first piece is `\b`, which anchors nothing
    if (!(raw holds("$a", "----")))             { pass 49i32; }   // its last piece is `a`
    if (!(raw holds("(?:)^a", "-S--")))         { pass 50i32; }   // the `Empty` piece goes in the normal form: `^` is first
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    exit raw run();
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
