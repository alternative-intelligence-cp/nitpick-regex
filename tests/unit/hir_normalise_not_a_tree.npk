// expect-exit: 108
//
// AN ARENA THAT IS NOT A TREE STOPS NORMALISATION. Cycle 0.2.3, RX-236; `HIR.md` H-13 and H-16.
//
// `hir_normalise` walks the tree it reads on an explicit stack, bounded by twice the arena: a tree
// enters and leaves each node once. Here a `Group` holds ITSELF, so the walk would enter it for
// ever; the bound runs out and the walk traps `DecreasesViolated` (108) -- a defect in the code
// that built the arena, stopped at the walk, as the dump stops it (`hir_dump_not_a_tree.npk`),
// never a normal form that does not end.
mod:hir_normalise_not_a_tree;

use "../../src/core/core.npk".*;
use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    Hir:h = raw hir_init(4i64);
    int64:k = raw hir_add_group(@h, string_bytes(""));
    int64:g = raw hir_push(@h, HirNode{ kind: HirKind.Group, flags: 0u32, a: 0i64, b: k, c: 0i64, next: HIR_NONE });
    drop hir_set_root(@h, g);
    Hir:out = raw hir_init(4i64);
    drop hir_normalise(@h, @out);
    drop hir_free(@out);
    drop hir_free(@h);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
