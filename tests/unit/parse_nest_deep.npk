// expect-exit: 0
// stress: 40
//
// THE GATE OF CYCLE 0.1.2 (RX-194): A PATTERN NESTED FAR PAST THE BOUND IS A
// REFUSAL, AND THE PROGRAM IS STILL RUNNING TO SAY SO. Three patterns, each
// `NestTooDeep` at the 251st `(`, one byte long, its detail the bound, with no node
// built -- the parse stopped where the bound is (`SYNTAX.md` Y-35, RX-193):
//
//   1. `(` 10 000 times, then `)` 10 000 times -- the cycle README's gate -- byte 250;
//   2. `(` 65 536 times -- the whole of `NREGEX_PATTERN_BYTES`, the deepest any
//      pattern can ask -- byte 250;
//   3. `(?:` 21 845 times and `a` -- 65 536 bytes, no group capturing, so the
//      capture bound plays no part -- byte 750.
//
// *(2026-10-01, cycle 0.1.3 -- RX-198: and classes, which nest too and count with groups
// (Y-35): `[` 10 000 times and `]` 10 000 times, and `[` 65 536 times, each `NestTooDeep`
// at the 251st `[`, byte 250; and `(` 200 times then `[` 10 000 times, at the 51st `[`,
// byte 250 (cases 7-12).)*
//
// WHY 65 536 AND NOT 10 000 ALONE. At `5fbaf4a` a recursive descent of the parser's
// frame size runs 10 000 levels at both legs without exhausting the main thread's
// stack, and traps `StackExhausted` at 65 536 at both (probe 19, RX-191). So 10 000
// shows the bound stopping the parser, and 65 536 is the input a recursive parser
// would not survive. `check_no_recursion` is the half that sees a recursion at any
// depth, and in any function (RX-192).
//
// WHY `stress: 40`. The runner requires the same exit on all forty runs of each leg.
// The cycle README asked for it because "a stack overflow is timing-shaped"; at
// `5fbaf4a` it is not -- the depth a recursion traps at is the same on every run
// (RX-191) -- and the forty runs hold the parse itself to one answer.
//
// "NOT ON A SIGNAL" IS THE RUNNER'S READING. It reads a killed process as
// `0 - signal`, so `expect-exit: 0` is met by a normal exit alone; self-check case 31
// shows it red for a unit killed by SIGSEGV and for one killed by SIGKILL (RX-194).
mod:parse_nest_deep;

use "../../src/core/core.npk".*;
use "../../src/syntax/syntax.npk".*;

// `piece` `n` times, then `tail` `m` times.
func:pattern = Bytes(string:piece, int64:n, string:tail, int64:m) never fails {
    Bytes:b = raw bytes_init(8i64);
    int64:i = 0i64;
    while (i < n) decreases n - i {
        drop bytes_extend_str(@b, piece);
        i = i + 1i64;
    }
    i = 0i64;
    while (i < m) decreases m - i {
        drop bytes_extend_str(@b, tail);
        i = i + 1i64;
    }
    pass move(b);
};

// `NestTooDeep` at byte `at`, one byte long, its detail the bound, and no node built?
func:refused_at = bool(string:pat, int64:at) never fails {
    Ast:t = raw ast_init(8i64);
    PatternError?:r = raw parse_pattern(string_bytes(pat), @t);
    int64:nodes = raw ast_len(t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (e.kind != PatternErrorKind.NestTooDeep) { pass false; }
    if ((e.offset != at) || (e.span_len != 1i64) || (e.detail != 250u32)) { pass false; }
    pass nodes == 0i64;
};

func:run = int32() never fails {
    // 1. 10 000 levels, and their 10 000 closers
    Bytes:a = raw pattern("(", 10000i64, ")", 10000i64);
    string:sa = raw bytes_copy_string(@a);
    fixed uint8[]:va = string_bytes(sa);
    if (va.len != 20000i64) { pass 1i32; }
    if (!(raw refused_at(sa, 250i64))) { pass 2i32; }
    // 2. the longest pattern there is, every byte a `(`
    Bytes:b = raw pattern("(", 65536i64, "", 0i64);
    string:sb = raw bytes_copy_string(@b);
    fixed uint8[]:vb = string_bytes(sb);
    if (vb.len != 65536i64) { pass 3i32; }
    if (!(raw refused_at(sb, 250i64))) { pass 4i32; }
    // 3. the longest pattern there is, nested without capturing
    Bytes:c = raw pattern("(?:", 21845i64, "a", 1i64);
    string:sc = raw bytes_copy_string(@c);
    fixed uint8[]:vc = string_bytes(sc);
    if (vc.len != 65536i64) { pass 5i32; }
    if (!(raw refused_at(sc, 750i64))) { pass 6i32; }
    // 4. 10 000 nested classes, and their 10 000 closers
    Bytes:d = raw pattern("[", 10000i64, "]", 10000i64);
    string:sd = raw bytes_copy_string(@d);
    fixed uint8[]:vd = string_bytes(sd);
    if (vd.len != 20000i64) { pass 7i32; }
    if (!(raw refused_at(sd, 250i64))) { pass 8i32; }
    // 5. the longest pattern there is, every byte a `[`
    Bytes:f = raw pattern("[", 65536i64, "", 0i64);
    string:sf = raw bytes_copy_string(@f);
    fixed uint8[]:vf = string_bytes(sf);
    if (vf.len != 65536i64) { pass 9i32; }
    if (!(raw refused_at(sf, 250i64))) { pass 10i32; }
    // 6. groups and classes together: 200 groups, then the 51st `[` is the 251st level
    Bytes:g = raw pattern("(", 200i64, "[", 10000i64);
    string:sg = raw bytes_copy_string(@g);
    fixed uint8[]:vg = string_bytes(sg);
    if (vg.len != 10200i64) { pass 11i32; }
    if (!(raw refused_at(sg, 250i64))) { pass 12i32; }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    int32:r = raw run();
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
