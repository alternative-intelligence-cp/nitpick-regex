// expect-exit: 0
//
// WHAT A PERSON READS (`SYNTAX.md` Y-34; RX-187): `pattern_error_text` says what
// is wrong, at which byte, and what to write instead, for every refusal cycle
// 0.1.1 makes, cycle 0.1.2's `NestTooDeep` (23; RX-193), and every one cycle 0.1.3's
// classes make (24-38; RX-197 … RX-200) -- each case parses a pattern and holds the
// text to the letter, so a message changed by accident is a red run. Then every kind,
// built by `pattern_error` at byte 7, renders a text that names byte 7 (40), so no
// kind is left without a sentence.
// *(2026-10-01, cycle 0.1.4 -- and every one cycle 0.1.4's escapes and flags make: 39 and
// 41-66, RX-203 … RX-208.)*
// *(2026-10-02, cycle 0.1.5 -- RX-212: and every refusal of what `SYNTAX.md` §8 declines, each saying
// what is wrong, where, and the guarantee or the alternative, none saying it is unsupported -- 16-21
// rewritten so, and 67-78; the Unicode block's sentence, which cycle 0.3.1 raises (79); and no kind's
// sentence holding the word, over every kind and twelve details (80).)*
// *(2026-10-02, cycle 0.1.5 -- RX-210, the author's amendment of 2026-10-02: and `\K`, refused as
// lookaround -- its kind, its byte and the lookaround's sentence (82).)*
mod:pattern_error_text;

use "../../src/core/core.npk".*;
use "../../src/syntax/syntax.npk".*;

func:same = bool(string:got, string:want) never fails {
    uint8[]:g = string_bytes(got);
    uint8[]:w = string_bytes(want);
    if (g.len != w.len) { pass false; }
    int64:i = 0i64;
    while (i < w.len) decreases w.len - i {
        if (g[i] != w[i]) { pass false; }
        i = i + 1i64;
    }
    pass true;
};

func:says = bool(string:pattern, string:want) never fails {
    Ast:t = raw ast_init(4i64);
    PatternError?:r = raw parse_pattern(string_bytes(pattern), @t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    string:got = raw pattern_error_text(e);
    pass raw same(got, want);
};

// The same, and the refusal is `kind` at `off` -- its kind and its byte held apart from its text.
func:says_kind = bool(string:pattern, PatternErrorKind:kind, int64:off, string:want) never fails {
    Ast:t = raw ast_init(4i64);
    PatternError?:r = raw parse_pattern(string_bytes(pattern), @t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (e.kind != kind)  { pass false; }
    if (e.offset != off) { pass false; }
    string:got = raw pattern_error_text(e);
    pass raw same(got, want);
};

// Does `text` contain `part`?
func:has = bool(string:text, string:part) never fails {
    uint8[]:t = string_bytes(text);
    uint8[]:p = string_bytes(part);
    int64:i = 0i64;
    while ((i + p.len) <= t.len) decreases t.len - i {
        int64:k = 0i64;
        bool:hit = true;
        while (k < p.len) decreases p.len - k {
            if (t[i + k] != p[k]) { hit = false; }
            k = k + 1i64;
        }
        if (hit) { pass true; }
        i = i + 1i64;
    }
    pass false;
};

func:run = int32() never fails {
    if (!(raw says("(a", "unclosed group at byte 0: this `(` has no matching `)`. Add a `)`, or write `\\(` to match a parenthesis."))) { pass 1i32; }
    if (!(raw says("(a(b", "unclosed group at byte 2: this `(` has no matching `)`; 2 groups are still open at the end of the pattern, and this is the innermost. Add a `)`, or write `\\(` to match a parenthesis."))) { pass 2i32; }
    if (!(raw says("a)", "unopened group at byte 1: this `)` closes no group. Remove it, or write `\\)` to match a parenthesis."))) { pass 3i32; }
    if (!(raw says("\\", "trailing backslash at byte 0: the pattern ends inside an escape. Write `\\\\` to match a backslash."))) { pass 4i32; }
    if (!(raw says("*", "nothing to repeat at byte 0: the `*` follows no expression -- it opens the pattern, a group or an alternative. Write `\\*` to match it."))) { pass 5i32; }
    if (!(raw says("a**", "double repetition at byte 2: this `*` repeats a repetition. Group what it repeats, as in `(?:a+)*`, or remove one of the two."))) { pass 6i32; }
    if (!(raw says("a{3,1}", "bad repetition bounds at byte 1: the minimum is greater than the maximum. Write the smaller bound first."))) { pass 7i32; }
    if (!(raw says("a{x", "bad repetition bounds at byte 1: a `{` must begin `{n}`, `{n,}` or `{n,m}`, in decimal digits. Write `\\{` to match a brace."))) { pass 8i32; }
    if (!(raw says("a{1001}", "repetition too large at byte 2: a bound may be at most 1000 (NREGEX_REPEAT_MAX). Repeat a group instead, as in `(?:a{1000}){2}`."))) { pass 9i32; }
    if (!(raw says("(?<n>a)(?<n>b)", "duplicate group name at byte 10: this name already names group 1. Rename one of the two."))) { pass 10i32; }
    if (!(raw says("(?<1>x)", "bad group name at byte 3: a name is ASCII letters, digits and `_`, and does not begin with a digit."))) { pass 11i32; }
    if (!(raw says("(?<>x)", "bad group name at byte 3: the name is empty. Write one between `<` and `>`, as in `(?<name>...)`."))) { pass 12i32; }
    if (!(raw says("(?<ab", "bad group name at byte 3: the name has no closing `>`. End it with `>`, as in `(?<name>...)`."))) { pass 13i32; }
    if (!(raw says("(?P<n>a)", "wrong named-group spelling at byte 0: `(?P<name>...)` is Python's spelling. Write `(?<name>...)`."))) { pass 14i32; }
    if (!(raw says("(?'n'a)", "wrong named-group spelling at byte 0: `(?'name'...)` is the .NET spelling. Write `(?<name>...)`."))) { pass 15i32; }
    if (!(raw says("(?=a)", "lookaround at byte 0: nregex's automata read no lookahead or lookbehind, and they are what make every search take linear time. Match the larger text and inspect its captures instead."))) { pass 16i32; }
    if (!(raw says("a*+", "possessive repetition at byte 1: the `+` stops backtracking into the repetition, and nregex never backtracks -- every search takes linear time. Remove the `+` for an ordinary repetition, which may match where the possessive one would not."))) { pass 17i32; }
    if (!(raw says("(?>a)", "atomic group at byte 0: `(?>` stops backtracking into the group, and nregex never backtracks -- every search takes linear time. Write a plain group, `(?:...)`, which may match where the atomic one would not."))) { pass 18i32; }
    if (!(raw says("(?R)", "recursion at byte 0: `(?R)` calls the whole pattern in Perl and PCRE and turns on CRLF mode in Rust's `regex`, and nregex has neither: a call lets a pattern match nested text, which no automaton can, and an automaton is what keeps every nregex search linear in time. Parse nested structure with a parser, and under `m` write `\\r?$` for a line that may end `\\r\\n`."))) { pass 19i32; }
    if (!(raw says("(?P=n)", "backreference at byte 0: it matches the text a group captured, which no automaton can, so the pattern could not be matched in linear time, as every nregex search is. Capture both parts and compare them yourself."))) { pass 20i32; }
    if (!(raw says("(?#c)", "comment group at byte 0: nregex has one way to write a comment -- under `x`, a `#` outside a class begins one that runs to the end of the line. Remove the group, or turn on `x` with `(?x)` and write the comment after a `#`, escaping any white space or `#` the pattern matches, as `\\ ` and `\\#`."))) { pass 21i32; }
    uint8[1]:ff = [255u8];
    Ast:t = raw ast_init(4i64);
    PatternError?:r = raw parse_pattern(ff[0i64...1i64], @t);
    drop ast_free(@t);
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    string:enc = raw pattern_error_text(e);
    if (!(raw same(enc, "invalid UTF-8 at byte 0: a pattern is UTF-8 text, and this sequence is not well-formed."))) { pass 22i32; }
    // 251 groups nested: the 251st `(`, byte 250 (Y-35)
    Bytes:deep = raw bytes_init(256i64);
    int64:n = 0i64;
    while (n < 251i64) decreases 251i64 - n {
        drop bytes_extend_str(@deep, "(");
        n = n + 1i64;
    }
    string:ds = raw bytes_copy_string(@deep);
    if (!(raw says(ds, "nesting too deep at byte 250: the `(` or `[` here would nest groups and classes 251 deep, and they may nest at most 250 deep (NREGEX_NEST_DEPTH). Nest fewer: write `(?:a)` as `a`, and `[[a]]` as `[a]`."))) { pass 23i32; }
    // cycle 0.1.3's classes (Y-36 … Y-38), each sentence to the letter
    if (!(raw says("[a", "unclosed class at byte 0: this `[` has no matching `]`. Add a `]`, or write `\\[` to match a bracket."))) { pass 24i32; }
    if (!(raw says("[]", "unclosed class at byte 0: this `[` has no matching `]` -- a `]` straight after `[` or `[^` is a member of the class, not its end. Add a `]`, as in `[]]` for a class of `]`, or write `\\[` to match a bracket."))) { pass 25i32; }
    if (!(raw says("[z-a]", "bad class range at byte 1: a range must not end before it starts. Write the lower bound first."))) { pass 26i32; }
    if (!(raw says("[\\w-.]", "bad class range at byte 1: a range joins two codepoints, and an end of this one is a class. To match `-` itself, put it first or last in the class, or write `\\-`."))) { pass 27i32; }
    if (!(raw says("[a&&]", "class operator at byte 2 is missing an operand: `&&` needs members on both sides, as in `[a-z&&aeiou]`. Write `\\&` to match `&` itself."))) { pass 28i32; }
    if (!(raw says("[--a]", "class operator at byte 1 is missing an operand: `--` needs members on both sides, as in `[a-z--aeiou]`. Write `\\-` to match `-` itself."))) { pass 29i32; }
    if (!(raw says("[a~~]", "class operator at byte 2 is missing an operand: `~~` needs members on both sides, as in `[a-z~~aeiou]`. Write `\\~` to match `~` itself."))) { pass 30i32; }
    if (!(raw says("[[:alpah:]]", "unknown POSIX class at byte 1: a POSIX class is `[:name:]` inside a class, as in `[[:alpha:]]`, and the names are alpha, digit, alnum, space, upper, lower, punct, print, graph, cntrl, xdigit, blank, word and ascii. Write `\\:` to match a `:`."))) { pass 31i32; }
    if (!(raw says("[\\p]", "unknown Unicode property at byte 1: `\\p` and `\\P` take a one-letter name, as in `\\pL`, or a name in braces, as in `\\p{Greek}`."))) { pass 32i32; }
    if (!(raw says("[\\p{Greek", "unknown Unicode property at byte 1: the name in braces has no closing `}`. End it with `}`, as in `\\p{Greek}`."))) { pass 33i32; }
    if (!(raw says("[\\p{}]", "unknown Unicode property at byte 1: the braces hold no name. Write one between them, as in `\\p{Greek}`."))) { pass 34i32; }
    // 251 classes nested: the 251st `[`, byte 250 (Y-35)
    Bytes:cdeep = raw bytes_init(256i64);
    int64:cn = 0i64;
    while (cn < 251i64) decreases 251i64 - cn {
        drop bytes_extend_str(@cdeep, "[");
        cn = cn + 1i64;
    }
    string:cds = raw bytes_copy_string(@cdeep);
    if (!(raw says(cds, "nesting too deep at byte 250: the `(` or `[` here would nest groups and classes 251 deep, and they may nest at most 250 deep (NREGEX_NEST_DEPTH). Nest fewer: write `(?:a)` as `a`, and `[[a]]` as `[a]`."))) { pass 35i32; }
    // outside a class, the same sentence (Y-37, RX-199)
    if (!(raw says("\\p", "unknown Unicode property at byte 0: `\\p` and `\\P` take a one-letter name, as in `\\pL`, or a name in braces, as in `\\p{Greek}`."))) { pass 36i32; }
    // a whole class in a POSIX class's own form (Y-38, RX-200)
    if (!(raw says("[:alpha:]", "POSIX class outside a class at byte 0: `[:alpha:]` is the POSIX class alpha only inside a class, and written as a class of its own its bytes are its members, `:` and the letters in `alpha`. Write `[[:alpha:]]` for the POSIX class, `[[:^alpha:]]` for its complement, or `[\\:alpha:]` for its bytes."))) { pass 37i32; }
    if (!(raw says("[:alhpa:]", "unknown POSIX class at byte 0: a POSIX class is `[:name:]` inside a class, as in `[[:alpha:]]`, and the names are alpha, digit, alnum, space, upper, lower, punct, print, graph, cntrl, xdigit, blank, word and ascii. Write `\\:` to match a `:`."))) { pass 38i32; }
    // a NUL in a name reads as the malformed name it is, not as an unfinished one (RX-203)
    uint8[8]:nul = [40u8, 63u8, 60u8, 97u8, 0u8, 62u8, 120u8, 41u8];
    Ast:tn = raw ast_init(4i64);
    PatternError?:rn = raw parse_pattern(nul[0i64...8i64], @tn);
    drop ast_free(@tn);
    PatternError:en = rn ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (!(raw same(raw pattern_error_text(en), "bad group name at byte 4: a name is ASCII letters, digits and `_`, and does not begin with a digit."))) { pass 39i32; }
    // every kind renders a sentence naming its byte
    int64:k = 0i64;
    while (k < 38i64) decreases 38i64 - k {
        PatternErrorKind:kind = (k =>! int32) =>! PatternErrorKind;
        string:s = raw pattern_error_text(raw pattern_error(kind, 7i64, 1i64, 0u32));
        if (!(raw has(s, " at byte 7"))) { pass 40i32; }
        k = k + 1i64;
    }
    // cycle 0.1.4's escapes (Y-40), each sentence to the letter
    if (!(raw says("\\q", "unknown escape at byte 0: `\\q` is not an escape nregex defines, and a `\\` before a letter or a digit never stands for that letter or digit. Write `q` to match it, or `\\\\` to match a backslash."))) { pass 41i32; }
    if (!(raw says("a\\012", "unknown escape at byte 1: `\\0` before a digit begins an octal escape in Perl, PCRE, Python and Java, and nregex reads no octal. Write the codepoint in hex instead, as in `\\x0A` for `\\012`, or `\\x00` and then the digit for a NUL and a digit."))) { pass 42i32; }
    if (!(raw says("[\\b]", "unknown escape at byte 1: `\\b` is a word boundary, a position, and a class holds codepoints. Move it out of the class, or write `\\x08` to match a backspace, as Perl and Python read `[\\b]`."))) { pass 43i32; }
    if (!(raw says("[\\A]", "unknown escape at byte 1: `\\A` matches a position, and a class holds codepoints. Move it out of the class."))) { pass 44i32; }
    if (!(raw says("\\é", "unknown escape at byte 0: a `\\` before a codepoint past ASCII escapes nothing. Write `é` without it."))) { pass 45i32; }
    if (!(raw says("\\x4g", "bad hex escape at byte 0: `g` is not a hex digit. `\\x` takes exactly two hex digits, as in `\\x41`, or one or more in braces, as in `\\x{1F600}`."))) { pass 46i32; }
    if (!(raw says("\\x{41", "bad hex escape at byte 0: the pattern ends inside it. `\\x` takes exactly two hex digits, as in `\\x41`, or one or more in braces, as in `\\x{1F600}`."))) { pass 47i32; }
    if (!(raw says("\\x{4 1}", "bad hex escape at byte 0: U+0020 is not a hex digit. `\\x` takes exactly two hex digits, as in `\\x41`, or one or more in braces, as in `\\x{1F600}`."))) { pass 48i32; }
    if (!(raw says("\\u{41}", "bad Unicode escape at byte 0: `{` is not a hex digit. `\\u` takes exactly four hex digits, as in `\\u00E9`, and `\\U` exactly eight, as in `\\U0001F600`; a codepoint in braces is `\\x{1F600}`."))) { pass 49i32; }
    if (!(raw says("\\u004", "bad Unicode escape at byte 0: the pattern ends inside it. `\\u` takes exactly four hex digits, as in `\\u00E9`, and `\\U` exactly eight, as in `\\U0001F600`; a codepoint in braces is `\\x{1F600}`."))) { pass 50i32; }
    if (!(raw says("\\uD83D\\uDE00", "invalid codepoint at byte 0: U+D83D is a surrogate, half of a UTF-16 pair, and UTF-8 has no form for it. Write the codepoint the pair stands for, as in `\\x{1F600}` for `\\uD83D\\uDE00`."))) { pass 51i32; }
    if (!(raw says("\\x{110000}", "invalid codepoint at byte 0: the escape names a value past U+10FFFF, the last codepoint. Write one from U+0000 to U+10FFFF."))) { pass 52i32; }
    // `\<` and `\>` (RX-205)
    if (!(raw says("\\<a", "unknown escape at byte 0: `\\<` is a start-of-word assertion in Rust's `regex` and GNU grep, and a `<` in Perl, PCRE, Python and Java, so nregex reads it neither way. Write `\\b` for a word boundary, or `<` to match a `<`."))) { pass 53i32; }
    if (!(raw says("[a\\>]", "unknown escape at byte 2: `\\>` is an end-of-word assertion in Rust's `regex` and GNU grep, and a `>` in Perl, PCRE, Python and Java, so nregex reads it neither way. Write `\\b` for a word boundary, or `>` to match a `>`."))) { pass 54i32; }
    // cycle 0.1.4's flags (Y-41)
    if (!(raw says("(?q)", "unknown flag at byte 2: `q` is not a flag. The flags are `i`, `m`, `s`, `x` and `u`, as in `(?i)` or `(?-u:...)`."))) { pass 55i32; }
    if (!(raw says("(?i-)", "missing flag at byte 4: the flags end here before one is named. Name at least one of `i`, `m`, `s`, `x` and `u` after `(?` and after a `-`, as in `(?i)` or `(?i-s:...)`."))) { pass 56i32; }
    if (!(raw says("(?i-m-s)", "second `-` in a group's flags at byte 5: the flags hold one `-`, and every flag after it is cleared. Write `(?i-ms)`, not `(?i-m-s)`."))) { pass 57i32; }
    if (!(raw says("(?i-i)", "flag named twice at byte 4: `i` already appears in this group's flags, set or cleared. Name each flag once."))) { pass 58i32; }
    if (!(raw says("(?xx)", "flag named twice at byte 3: `x` already appears in this group's flags. Perl's and PCRE2's `(?xx)` also ignores spaces and tabs in a class, and under nregex's `x` a space or a `#` in a class is refused instead: write `(?x)`, and `\\x20` or `\\#` in a class."))) { pass 59i32; }
    // cycle 0.1.4's `x` (Y-39, Y-42)
    if (!(raw says("(?x)[a b]", "white space in a class at byte 6 under `x`: Rust's `regex` and Java skip it here, and Perl, Python and .NET match it, so nregex refuses it. Write `\\x20` to match it, or remove it."))) { pass 60i32; }
    if (!(raw says("(?x)[a\tb]", "white space in a class at byte 6 under `x`: Rust's `regex` and Java skip it here, and Perl, Python and .NET match it, so nregex refuses it. Write `\\t` to match it, or remove it."))) { pass 61i32; }
    if (!(raw says("(?x)[a#b]", "`#` in a class at byte 6 under `x`: Rust's `regex` and Java begin a comment here, and Perl, Python and .NET match a `#`, so nregex refuses it. Write `\\#` to match a `#`."))) { pass 62i32; }
    if (!(raw says("(?x)a\u{A0}b", "white space past ASCII at byte 5 under `x`: U+00A0 is skipped there by some engines and matched by others -- Rust's `regex` skips Unicode's White_Space, Perl its Pattern_White_Space, and Python and Java ASCII white space alone -- so nregex refuses it. Write `\\x{A0}` to match it, or remove it."))) { pass 63i32; }
    // cycle 0.1.4's `(?-u)` (Y-43)
    if (!(raw says("(?-u)é", "non-ASCII literal at byte 5 under `(?-u)`: U+00E9 takes 2 bytes in UTF-8, and in byte mode a literal is one byte. Write its UTF-8 bytes as `\\xC3\\xA9`, the byte E9 as `\\xE9`, or turn `u` back on around it, as in `(?u:...)`."))) { pass 64i32; }
    if (!(raw says("(?-u)\\x{20AC}", "non-ASCII literal at byte 5 under `(?-u)`: U+20AC takes 3 bytes in UTF-8, and in byte mode a literal is one byte. Write its UTF-8 bytes as `\\xE2\\x82\\xAC`, or turn `u` back on around it, as in `(?u:...)`."))) { pass 65i32; }
    if (!(raw says("(?-u)\\pL", "Unicode property at byte 5 under `(?-u)`: a property names codepoints, and byte mode matches bytes. Turn `u` back on around it, as in `(?u:\\p{Greek})`, or write the bytes it should match as a class."))) { pass 66i32; }
    // cycle 0.1.5's refusals of what SYNTAX.md §8 declines (Y-44), each sentence to the letter (RX-212)
    if (!(raw says("(a)\\1", "backreference at byte 3: it matches the text a group captured, which no automaton can, so the pattern could not be matched in linear time, as every nregex search is. Capture both parts and compare them yourself."))) { pass 67i32; }
    if (!(raw says("\\k<n>", "backreference at byte 0: it matches the text a group captured, which no automaton can, so the pattern could not be matched in linear time, as every nregex search is. Capture both parts and compare them yourself."))) { pass 68i32; }
    if (!(raw says("(a)\\g1", "backreference at byte 3: it matches the text a group captured, which no automaton can, so the pattern could not be matched in linear time, as every nregex search is. Capture both parts and compare them yourself."))) { pass 69i32; }
    if (!(raw says("(?1)", "recursion at byte 0: a call of the pattern or of a group lets it match nested text, which no automaton can, and an automaton is what keeps every nregex search linear in time. Parse nested structure with a parser instead."))) { pass 70i32; }
    if (!(raw says("(a)\\g<1>", "recursion at byte 3: a call of the pattern or of a group lets it match nested text, which no automaton can, and an automaton is what keeps every nregex search linear in time. Parse nested structure with a parser instead."))) { pass 71i32; }
    if (!(raw says("a\\Z", "anchor `\\Z` at byte 1: Perl and PCRE match it at the end or before a final `\\n`, Java before any final line end, and Python at the end alone, so nregex takes none of the three readings. Write `\\z` for the end alone, or `\\n?\\z` to take a final `\\n` into the match too."))) { pass 72i32; }
    if (!(raw says("\\Ga", "anchor `\\G` at byte 0: Perl, PCRE and Java match it where the previous match ended or the search began, and an nregex search keeps no previous match. Search from an offset with regex_find_at, and check that the match starts there."))) { pass 73i32; }
    if (!(raw says("\\Qa.b\\E", "quotation at byte 0: nregex reads no `\\Q...\\E`, a quotation that a `\\E` in its own text ends early. Build the pattern from the text with regex_escape() instead, which escapes every byte that means something in a pattern."))) { pass 74i32; }
    if (!(raw says("a\\E", "quotation end at byte 1: `\\E` ends a `\\Q...\\E` quotation in Perl, PCRE and Java, and nregex reads none, so there is nothing for it to end. Remove it, and build any quoted text with regex_escape()."))) { pass 75i32; }
    if (!(raw says("[\\Q]", "quotation at byte 1: nregex reads no `\\Q...\\E`, a quotation that a `\\E` in its own text ends early. Build the pattern from the text with regex_escape() instead, which escapes every byte that means something in a pattern."))) { pass 76i32; }
    if (!(raw says("[\\1]", "unknown escape at byte 1: `\\1` in a class begins an octal escape in Perl, PCRE and Python, and nregex reads no octal. Write the codepoint in hex instead, as in `\\x01` for `\\1` and `\\x0A` for `\\12`, or `1` to match the digit."))) { pass 77i32; }
    if (!(raw says("[\\8]", "unknown escape at byte 1: `\\8` is not an escape nregex defines, and a `\\` before a letter or a digit never stands for that letter or digit. Write `8` to match it, or `\\\\` to match a backslash."))) { pass 78i32; }
    // a Unicode block, which cycle 0.3.1 refuses where it resolves the name (`UNICODE.md` U-8)
    string:blk = raw pattern_error_text(raw pattern_error(PatternErrorKind.UnknownUnicodeProperty, 0i64, 11i64, 4u32));
    if (!(raw same(blk, "Unicode block at byte 0: a block, as `\\p{InGreek}` or `\\p{Block=Greek}` names one, is a range of codepoints set aside by history -- the Greek block holds Coptic letters, and Greek letters lie outside it too. Write its script instead, as in `\\p{Script=Greek}` for `\\p{InGreek}`."))) { pass 79i32; }
    // no sentence says a construct is unsupported: it names the guarantee or the alternative (`COMPAT.md` K-1)
    uint32[12]:details = [0u32, 1u32, 2u32, 4u32, 43u32, 49u32, 60u32, 69u32, 71u32, 81u32, 82u32, 90u32];
    int64:kk = 0i64;
    while (kk < 38i64) decreases 38i64 - kk {
        PatternErrorKind:kind2 = (kk =>! int32) =>! PatternErrorKind;
        int64:d = 0i64;
        while (d < 12i64) decreases 12i64 - d {
            string:s2 = raw pattern_error_text(raw pattern_error(kind2, 7i64, 1i64, details[d]));
            if (raw has(s2, "support")) { pass 80i32; }
            d = d + 1i64;
        }
        kk = kk + 1i64;
    }
    // `\K`, Perl's and PCRE's reset of a match's start, refused as lookaround by the author's amendment of
    // 2026-10-02 (RX-210): its kind, its byte, and the lookaround's sentence to the letter
    if (!(raw says_kind("foo\\Kbar", PatternErrorKind.LookaroundUnsupported, 3i64, "lookaround at byte 3: nregex's automata read no lookahead or lookbehind, and they are what make every search take linear time. Match the larger text and inspect its captures instead."))) { pass 82i32; }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    int32:r = raw run();
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
