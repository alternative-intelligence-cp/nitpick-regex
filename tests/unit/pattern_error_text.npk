// expect-exit: 0
//
// WHAT A PERSON READS (`SYNTAX.md` Y-34; RX-187): `pattern_error_text` says what
// is wrong, at which byte, and what to write instead, for every refusal cycle
// 0.1.1 makes -- each case parses a pattern and holds the text to the letter,
// so a message changed by accident is a red run. Then every kind, built by
// `pattern_error` at byte 7, renders a text that names byte 7 (40), so no kind
// is left without a sentence.
mod:pattern_error_text;

use "../../src/core/core.npk".*;
use "../../src/syntax/syntax.npk".*;

func:same = bool(string:got, string:want) never fails {
    uint8[]:g = string_bytes(got);
    uint8[]:w = string_bytes(want);
    if (g.len != w.len) { pass false; }
    int64:i = 0i64;
    while (i < w.len) decreases w.len - i {
        if (g[i] != w[i]) { pass false; }
        i = i + 1i64;
    }
    pass true;
};

func:says = bool(string:pattern, string:want) never fails {
    Ast:t = raw ast_init(4i64);
    PatternError?:r = raw parse_pattern(string_bytes(pattern), @t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    string:got = raw pattern_error_text(e);
    pass raw same(got, want);
};

// Does `text` contain `part`?
func:has = bool(string:text, string:part) never fails {
    uint8[]:t = string_bytes(text);
    uint8[]:p = string_bytes(part);
    int64:i = 0i64;
    while ((i + p.len) <= t.len) decreases t.len - i {
        int64:k = 0i64;
        bool:hit = true;
        while (k < p.len) decreases p.len - k {
            if (t[i + k] != p[k]) { hit = false; }
            k = k + 1i64;
        }
        if (hit) { pass true; }
        i = i + 1i64;
    }
    pass false;
};

func:run = int32() never fails {
    if (!(raw says("(a", "unclosed group at byte 0: this `(` has no matching `)`. Add a `)`, or write `\\(` to match a parenthesis."))) { pass 1i32; }
    if (!(raw says("(a(b", "unclosed group at byte 2: this `(` has no matching `)`; 2 groups are still open at the end of the pattern, and this is the innermost. Add a `)`, or write `\\(` to match a parenthesis."))) { pass 2i32; }
    if (!(raw says("a)", "unopened group at byte 1: this `)` closes no group. Remove it, or write `\\)` to match a parenthesis."))) { pass 3i32; }
    if (!(raw says("\\", "trailing backslash at byte 0: the pattern ends inside an escape. Write `\\\\` to match a backslash."))) { pass 4i32; }
    if (!(raw says("*", "nothing to repeat at byte 0: the `*` follows no expression -- it opens the pattern, a group or an alternative. Write `\\*` to match it."))) { pass 5i32; }
    if (!(raw says("a**", "double repetition at byte 2: this `*` repeats a repetition. Group what it repeats, as in `(?:a+)*`, or remove one of the two."))) { pass 6i32; }
    if (!(raw says("a{3,1}", "bad repetition bounds at byte 1: the minimum is greater than the maximum. Write the smaller bound first."))) { pass 7i32; }
    if (!(raw says("a{x", "bad repetition bounds at byte 1: a `{` must begin `{n}`, `{n,}` or `{n,m}`, in decimal digits. Write `\\{` to match a brace."))) { pass 8i32; }
    if (!(raw says("a{1001}", "repetition too large at byte 2: a bound may be at most 1000 (NREGEX_REPEAT_MAX). Repeat a group instead, as in `(?:a{1000}){2}`."))) { pass 9i32; }
    if (!(raw says("(?<n>a)(?<n>b)", "duplicate group name at byte 10: this name already names group 1. Rename one of the two."))) { pass 10i32; }
    if (!(raw says("(?<1>x)", "bad group name at byte 3: a name is ASCII letters, digits and `_`, and does not begin with a digit."))) { pass 11i32; }
    if (!(raw says("(?<>x)", "bad group name at byte 3: the name is empty. Write one between `<` and `>`, as in `(?<name>...)`."))) { pass 12i32; }
    if (!(raw says("(?<ab", "bad group name at byte 3: the name has no closing `>`. End it with `>`, as in `(?<name>...)`."))) { pass 13i32; }
    if (!(raw says("(?P<n>a)", "wrong named-group spelling at byte 0: `(?P<name>...)` is Python's spelling. Write `(?<name>...)`."))) { pass 14i32; }
    if (!(raw says("(?'n'a)", "wrong named-group spelling at byte 0: `(?'name'...)` is the .NET spelling. Write `(?<name>...)`."))) { pass 15i32; }
    if (!(raw says("(?=a)", "lookaround at byte 0 is not supported: it cannot be matched in linear time, which every nregex search guarantees. Match the larger text and inspect its captures instead."))) { pass 16i32; }
    if (!(raw says("a*+", "possessive repetition at byte 1 is not supported: it steers backtracking, and nregex never backtracks -- every search takes linear time. Remove the `+` for an ordinary repetition."))) { pass 17i32; }
    if (!(raw says("(?>a)", "atomic group at byte 0 is not supported: it steers backtracking, and nregex never backtracks -- every search takes linear time. Write a plain group, `(?:...)`."))) { pass 18i32; }
    if (!(raw says("(?R)", "recursion at byte 0 is not supported: a recursive pattern is not a regular expression and cannot be matched in linear time. Parse nested structure with a parser instead."))) { pass 19i32; }
    if (!(raw says("(?P=n)", "backreference at byte 0 is not supported: matching one is NP-hard in general, and every nregex search takes linear time. Capture both parts and compare them yourself."))) { pass 20i32; }
    if (!(raw says("(?#c)", "comment group at byte 0 is not supported: in `x` mode, `#` starts a comment that runs to the end of the line."))) { pass 21i32; }
    uint8[1]:ff = [255u8];
    Ast:t = raw ast_init(4i64);
    PatternError?:r = raw parse_pattern(ff[0i64...1i64], @t);
    drop ast_free(@t);
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    string:enc = raw pattern_error_text(e);
    if (!(raw same(enc, "invalid UTF-8 at byte 0: a pattern is UTF-8 text, and this sequence is not well-formed."))) { pass 22i32; }
    // every kind renders a sentence naming its byte
    int64:k = 0i64;
    while (k < 36i64) decreases 36i64 - k {
        PatternErrorKind:kind = (k =>! int32) =>! PatternErrorKind;
        string:s = raw pattern_error_text(raw pattern_error(kind, 7i64, 1i64, 0u32));
        if (!(raw has(s, " at byte 7"))) { pass 40i32; }
        k = k + 1i64;
    }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    int32:r = raw run();
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
