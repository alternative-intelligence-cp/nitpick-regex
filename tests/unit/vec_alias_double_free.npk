// expect-exit: 95
//
// A WHOLE-`Vec` COPY IS A SECOND HANDLE ON THE BLOCK, AND FREEING BOTH IS A
// DOUBLE FREE THE GUARD CANNOT SEE -- N-15, the fourth cycle-0.0 audit's BL-8.
//
// PINNED, NOT ENDORSED. `Vec<int64>:w = v;` names no field, so neither `hidden`
// nor `sealed` sees it (RX-153), and it copies the header: `items`, `count`
// and `cap`. `vec_free(@v)` releases the block and poisons `v`'s own header
// (`cap = 0`); `w` still says `cap == 4`, so `vec_free`'s `cap <= 0` guard
// (RX-144) passes, and `dalloc` meets a block it has already reclaimed -- the
// runtime's `-4102 HEAP_INTEGRITY`, the prelude's `Unreachable`, **95**
// (RX-156). The guard reaches ONE binding.
//
// DEFERRED TO 0.0.4d, BEFORE CYCLE 0.0 CLOSES, by the author's decision on the
// board's question 9 (2026-09-25): `Vec` becomes MOVE-ONLY BY CONSTRUCTION. On
// that day this file stops compiling -- `NITPICK-TYPE-046`, as a `Bytes` copy
// already does (`../rejection/bytes_copy.npk`) -- and 0.0.4d turns it into a
// rejection fixture, so the shape it pins is proved REFUSED rather than argued.
//
// Measured at `c3bdae2`: 95 at -O0 and through `opt -O2` (RX-160).
mod:vec_alias_double_free;

use "../../src/core/vec.npk".*;

func:main = int32(cstring[]:_~argv) {
    Vec<int64>:v = raw vec_init::<int64>(4i64);
    drop vec_push(@v, 7i64);
    Vec<int64>:w = v;
    drop vec_free(@v);
    drop vec_free(@w);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
