// expect-exit: 0
//
// ANY STRUCT HOLDING A `Vec` IS SILENTLY COPYABLE, AND THE COPY ALIASES THE
// BLOCK -- N-15's reach, the fourth cycle-0.0 audit's BL-8.
//
// PINNED, NOT ENDORSED. `Prog` is `COMPILE.md` C-1's `Program` in miniature: a
// `Vec` and a scalar. C-1 calls a `Program` "copyable"; `Prog:q = p;` copies
// the `Vec`'s header with it, so after `p`'s block is freed, `q`'s read is the
// `0xAA` poison -- **exit 0 here** (21: the value survived; 22: something else
// came back). The parser's state holds a `Vec<Frame>` from cycle 0.1 on
// (`SYNTAX.md` Y-9), so this is the next cycle's shape, not a distant one.
//
// DEFERRED TO 0.0.4d, BEFORE CYCLE 0.0 CLOSES, by the author's decision on the
// board's question 9 (2026-09-25): `Vec` becomes MOVE-ONLY BY CONSTRUCTION. On
// that day this file stops compiling -- `NITPICK-TYPE-046`, as a `Bytes` copy
// already does (`../rejection/bytes_copy.npk`) -- and 0.0.4d turns it into a
// rejection fixture, so the shape it pins is proved REFUSED rather than argued.
//
// Measured at `c3bdae2`: 0 at -O0 and through `opt -O2` (RX-160).
mod:vec_alias_struct_copy;

use "../../src/core/vec.npk".*;

struct:Prog = {
    Vec<int64>:insts;
    int32:start;
};

func:main = int32(cstring[]:_~argv) {
    Prog:p = Prog{ insts: raw vec_init::<int64>(4i64), start: 0i32 };
    drop vec_push(@p.insts, 7i64);
    Prog:q = p;
    drop vec_free(@p.insts);
    int64:x = raw vec_get(q.insts, 0i64);
    if (x == 7i64) { exit 21i32; }
    if ((x & 255i64) != 170i64) { exit 22i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
