// expect-exit: 0
//
// THE BOUNDS THE CORE GRAMMAR SPENDS, EACH ON ITS LIMIT AND ONE PAST IT
// (`SAFETY.md` S-12; RX-184, RX-185): `NREGEX_CAPTURE_GROUPS` -- 250 groups
// parse, the 251st is `TooManyCaptureGroups` at its `(` (named groups count the
// same); `NREGEX_PATTERN_BYTES` through `parse_pattern` -- 65 536 bytes parse and
// one more is `PatternTooLong` before anything reads a byte. And 250 groups
// nested, which the explicit stack holds without a native frame per level
// (RX-032): `NREGEX_NEST_DEPTH` is 250, and since cycle 0.1.2 the 251st `(` is
// `NestTooDeep` at it, before a byte after it is read (Y-35, RX-193) -- 251
// non-capturing groups at byte 750; 251 capturing groups at byte 250, past both
// bounds, the depth decided first; and a lookahead or a `(?` the 251st `(` would
// open, never read. (`NREGEX_REPEAT_MAX` is `parse_grammar`'s case 31 and
// `parse_refusals`' 33; 10 000 levels and the longest pattern's are
// `parse_nest_deep`'s.)
// *(2026-10-01, cycle 0.1.3 -- RX-198: classes nest too, and groups and classes count
// together against `NREGEX_NEST_DEPTH` (Y-35): 250 nested classes parse and the 251st
// `[` is `NestTooDeep` at byte 250; so is a `[` inside 250 groups, and the 126th `[`
// inside 125 groups; 249 groups around a class parse (cases 19-24).)*
// *(2026-10-01, cycle 0.1.4: "19-24" above read "19-23" until this subcycle, where the cases
// are 19-24 -- cycle 0.1.3's verifier's finding.)*
mod:parse_limits;

use "../../src/core/core.npk".*;
use "../../src/syntax/syntax.npk".*;

func:many = Bytes(int64:groups, string:piece, string:tail) never fails {
    Bytes:b = raw bytes_init(8i64);
    int64:i = 0i64;
    while (i < groups) decreases groups - i {
        drop bytes_extend_str(@b, piece);
        i = i + 1i64;
    }
    drop bytes_extend_str(@b, tail);
    pass move(b);
};

// `piece` `groups` times then `tail`: `NestTooDeep` at byte `at`, one byte long, its
// detail the bound, and no node built?
func:too_deep = bool(int64:groups, string:piece, string:tail, int64:at) never fails {
    Bytes:b = raw many(groups, piece, tail);
    string:s = raw bytes_copy_string(@b);
    Ast:t = raw ast_init(8i64);
    PatternError?:r = raw parse_pattern(string_bytes(s), @t);
    int64:nodes = raw ast_len(t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (e.kind != PatternErrorKind.NestTooDeep) { pass false; }
    if ((e.offset != at) || (e.span_len != 1i64) || (e.detail != 250u32)) { pass false; }
    pass nodes == 0i64;
};

// `first` `n` times, then `second` `m` times, then `tail`.
func:two = Bytes(string:first, int64:n, string:second, int64:m, string:tail) never fails {
    Bytes:b = raw many(n, first, "");
    int64:i = 0i64;
    while (i < m) decreases m - i {
        drop bytes_extend_str(@b, second);
        i = i + 1i64;
    }
    drop bytes_extend_str(@b, tail);
    pass move(b);
};

// The pattern parses?
func:parses = bool(Bytes->:b) never fails {
    string:s = raw bytes_copy_string(b);
    Ast:t = raw ast_init(8i64);
    PatternError?:r = raw parse_pattern(string_bytes(s), @t);
    drop ast_free(@t);
    pass r == NIL;
};

// The pattern is `NestTooDeep` at byte `at`, one byte long, its detail the bound, with no
// node built?
func:deep_at = bool(Bytes->:b, int64:at) never fails {
    string:s = raw bytes_copy_string(b);
    Ast:t = raw ast_init(8i64);
    PatternError?:r = raw parse_pattern(string_bytes(s), @t);
    int64:nodes = raw ast_len(t);
    drop ast_free(@t);
    if (r == NIL) { pass false; }
    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (e.kind != PatternErrorKind.NestTooDeep) { pass false; }
    if ((e.offset != at) || (e.span_len != 1i64) || (e.detail != 250u32)) { pass false; }
    pass nodes == 0i64;
};

func:run = int32() never fails {
    // 250 capture groups: accepted, the root a `Concat` of 250, the last group number 250
    Bytes:ok = raw many(250i64, "()", "");
    string:os = raw bytes_copy_string(@ok);
    Ast:t = raw ast_init(8i64);
    PatternError?:r = raw parse_pattern(string_bytes(os), @t);
    if (r != NIL) { drop ast_free(@t); pass 1i32; }
    AstNode:root = raw ast_get(t, t.root);
    drop ast_free(@t);
    if ((root.kind != AstKind.Concat) || (root.b != 250i64)) { pass 2i32; }
    // 251: refused at the 251st `(`, byte 500, its detail the bound
    Bytes:over = raw many(250i64, "()", "()");
    string:s = raw bytes_copy_string(@over);
    Ast:u = raw ast_init(8i64);
    PatternError?:q = raw parse_pattern(string_bytes(s), @u);
    drop ast_free(@u);
    if (q == NIL) { pass 3i32; }
    PatternError:e = q ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if (e.kind != PatternErrorKind.TooManyCaptureGroups) { pass 4i32; }
    if ((e.offset != 500i64) || (e.span_len != 1i64) || (e.detail != 250u32)) { pass 5i32; }
    // a named group is numbered too: 249 and one named parse; one more named is refused
    Bytes:named = raw many(249i64, "()", "(?<z>)(?<y>)");
    string:ns = raw bytes_copy_string(@named);
    Ast:v = raw ast_init(8i64);
    PatternError?:w = raw parse_pattern(string_bytes(ns), @v);
    drop ast_free(@v);
    if (w == NIL) { pass 6i32; }
    PatternError:f = w ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
    if ((f.kind != PatternErrorKind.TooManyCaptureGroups) || (f.offset != 504i64)) { pass 7i32; }
    // 250 non-capturing groups nested around one literal
    Bytes:deep = raw many(250i64, "(?:", "a");
    int64:k = 0i64;
    while (k < 250i64) decreases 250i64 - k {
        drop bytes_extend_str(@deep, ")");
        k = k + 1i64;
    }
    string:ds = raw bytes_copy_string(@deep);
    Ast:x = raw ast_init(8i64);
    PatternError?:y = raw parse_pattern(string_bytes(ds), @x);
    if (y != NIL) { drop ast_free(@x); pass 8i32; }
    int64:at = x.root;
    int64:levels = 0i64;
    AstNode:n = raw ast_get(x, at);
    while ((n.kind == AstKind.Group) && (levels <= 250i64)) decreases 251i64 - levels {
        levels = levels + 1i64;
        n = raw ast_get(x, n.a);
    }
    drop ast_free(@x);
    if (levels != 250i64) { pass 9i32; }
    if ((n.kind != AstKind.Literal) || (n.a != 97i64)) { pass 10i32; }
    // the length, through `parse_pattern`: on the bound, then one past it
    Bytes:longest = raw many(65536i64, "a", "");
    string:ls = raw bytes_copy_string(@longest);
    Ast:l = raw ast_init(8i64);
    PatternError?:lr = raw parse_pattern(string_bytes(ls), @l);
    drop ast_free(@l);
    if (lr != NIL) { pass 11i32; }
    Bytes:too = raw many(65536i64, "a", "a");
    string:ts = raw bytes_copy_string(@too);
    Ast:m = raw ast_init(8i64);
    PatternError?:mr = raw parse_pattern(string_bytes(ts), @m);
    int64:nodes = raw ast_len(m);
    drop ast_free(@m);
    if (mr == NIL) { pass 12i32; }
    PatternError:g = mr ?? raw pattern_error(PatternErrorKind.UnclosedGroup, 0i64, 0i64, 0u32);
    if ((g.kind != PatternErrorKind.PatternTooLong) || (g.offset != 65536i64) || (g.detail != 65536u32)) { pass 13i32; }
    if (nodes != 0i64) { pass 14i32; }
    // the depth (Y-35): 251 non-capturing groups nested -- refused at the 251st `(`,
    // byte 750, its detail the bound
    if (!(raw too_deep(251i64, "(?:", "a", 750i64))) { pass 15i32; }
    // 251 capturing groups nested: the 251st `(` is past NREGEX_CAPTURE_GROUPS too,
    // and the depth is decided first -- NestTooDeep at byte 250, not TooManyCaptureGroups
    if (!(raw too_deep(251i64, "(", "", 250i64))) { pass 16i32; }
    // what the 251st `(` would open is never read: a lookahead, and `(?` at the end
    if (!(raw too_deep(250i64, "(?:", "(?=a)", 750i64))) { pass 17i32; }
    if (!(raw too_deep(250i64, "(?:", "(?", 750i64))) { pass 18i32; }
    // classes nest too, and count with groups (Y-35): 250 nested classes around `a` parse,
    // the innermost member `a` at the bottom of 250 levels
    Bytes:cl = raw two("[", 250i64, "a", 1i64, "");
    int64:j = 0i64;
    while (j < 250i64) decreases 250i64 - j {
        drop bytes_extend_str(@cl, "]");
        j = j + 1i64;
    }
    string:cs = raw bytes_copy_string(@cl);
    Ast:ct = raw ast_init(8i64);
    PatternError?:cr = raw parse_pattern(string_bytes(cs), @ct);
    if (cr != NIL) { drop ast_free(@ct); pass 19i32; }
    int64:depth = 0i64;
    AstNode:cn = raw ast_get(ct, ct.root);
    while ((cn.kind == AstKind.Class) && (depth <= 250i64)) decreases 251i64 - depth {
        depth = depth + 1i64;
        cn = raw ast_get(ct, cn.a);
    }
    drop ast_free(@ct);
    if ((depth != 250i64) || (cn.kind != AstKind.ClassRange) || (cn.a != 97i64)) { pass 20i32; }
    // the 251st `[`, at byte 250
    Bytes:c1 = raw two("[", 251i64, "", 0i64, "");
    if (!(raw deep_at(@c1, 250i64))) { pass 21i32; }
    // a `[` inside 250 groups, at byte 250 -- and inside 249 groups a class parses
    Bytes:c2 = raw two("(", 250i64, "[a]", 1i64, "");
    if (!(raw deep_at(@c2, 250i64))) { pass 22i32; }
    Bytes:c3 = raw two("(", 249i64, "[a]", 1i64, "");
    int64:k3 = 0i64;
    while (k3 < 249i64) decreases 249i64 - k3 {
        drop bytes_extend_str(@c3, ")");
        k3 = k3 + 1i64;
    }
    if (!(raw parses(@c3))) { pass 23i32; }
    // the 126th `[` inside 125 groups, at byte 250
    Bytes:c4 = raw two("(", 125i64, "[", 126i64, "");
    if (!(raw deep_at(@c4, 250i64))) { pass 24i32; }
    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    int32:r = raw run();
    exit r;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
