// expect-exit: 40
//
// `#size_of<HirNode>()` IS 40, AND THIS PROGRAM'S EXIT CODE IS THE MEASUREMENT.
// Cycle 0.2.0, RX-223; `HIR.md` H-2.
//
// Measured, never derived from field widths (RX-135): the exit code is the size, so the
// number cannot be transcribed wrongly. Two four-byte fields first and together, then four
// eight-byte ones, so nothing pads. `HIR.md` H-2's drawing -- a kind, three `int32`s and a
// `uint32` -- measures 20 at `5fbaf4a`, and it is not this node: it has no room for a
// `Repeat`'s sibling, and its operands would be narrowed at every write (`repr.npk`'s
// header). A type's size, not an emission's: nothing here reads the IR.
mod:hir_size;

use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    exit (#size_of<HirNode>() =>! int32);
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
