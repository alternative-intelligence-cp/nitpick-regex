// expect-exit: 94
//
// A NODE THE ROOT DOES NOT REACH HAS NO FACTS: `hir_props` STOPS. Cycle 0.2.4, RX-239; `HIR.md` H-18.
// `(literal 97)` is read, and an `Empty` pushed beside it, which no path from the root reaches. Asked for
// that node, the query computes the tree's facts -- the literal's -- and finds none on it: `OutOfBounds`,
// never an answer of no bits, which would read "not computed" as "false" (the compiler's D-227). Exit 2
// says the query answered.
mod:hir_props_not_in_tree;

use "../../src/core/core.npk".*;
use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    Hir:h = raw hir_init(8i64);
    if ((raw hir_read(string_bytes("(literal 97)"), @h)) != HIR_NONE) { exit 3i32; }
    int64:x = raw hir_push(@h, HirNode{ kind: HirKind.Empty, flags: 0u32, a: 0i64, b: 0i64, c: 0i64, next: HIR_NONE });
    discard(raw hir_props(@h, x));
    drop hir_free(@h);
    exit 2i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
