// expect-exit: 0
//
// A `for` BINDING OVER AN ARRAY OF CONTAINERS IS A LOAN -- AND THE LOOP'S BODY
// STILL FREES THE ELEMENT'S BLOCK THROUGH IT. The fifth cycle-0.0 audit's N-26:
// a sixth loan shape, beside the four `*_alias_param_*` units and probe 17.
//
// PINNED, NOT ENDORSED. `for (Vec<int64>:x in arr)` binds each element as a
// parameter is bound -- the parser builds the binding as a full `ParamDecl` -- so
// `x` is LENT, not copied (a copy of a `Vec` is NITPICK-TYPE-046 since cycle
// 0.0.4d, RX-161). `vec_free(@x)` frees the element's block through the loan's
// address, and the element in `arr` still says `count == 1`: its next `vec_get`
// reads the `0xAA` free poison, exit 0 here (21: the value survived; 22:
// something else came back). Measured at `c3bdae2`, at -O0 and through
// `opt -O2`. Freeing `arr`'s elements afterwards would be a double free, 95 --
// `vec_free`'s guard reads `arr[0]`'s header, which the loop never zeroed.
//
// WHEN THIS REDDENS. The same compiler defect as its four siblings -- a loan is not
// held read-only -- raised as the workbench registry's O-N21, the compiler's
// DEF-102 (NITPICK-TYPE-085, its 1.6.0 step 3g, not in the pin `c3bdae2`). By 3g's
// source this binding is a loan, so `@x` should be refused NITPICK-TYPE-085; the
// re-pin MEASURES that rather than assuming it, and if the file still compiles
// there, 3g does not close the loan and cycle 0.0's gate stays unmet for it. When
// refused, it moves to `../rejection/` with `// expect-error: NITPICK-TYPE-085` at
// the `@`. `src/` has no `for` in code (RX-167).
mod:vec_alias_for_binding_free;

use "../../src/core/vec.npk".*;

func:main = int32(cstring[]:_~argv) {
    Vec<int64>:a = raw vec_init::<int64>(2i64);
    drop vec_push(@a, 7i64);
    Vec<int64>:b = raw vec_init::<int64>(2i64);
    drop vec_push(@b, 8i64);
    Vec<int64>[2]:arr = [move(a), move(b)];
    for (Vec<int64>:x in arr) {
        drop vec_free(@x);
    }
    int64:y = raw vec_get(arr[0i64], 0i64);
    if (y == 7i64) { exit 21i32; }
    if ((y & 255i64) != 170i64) { exit 22i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
