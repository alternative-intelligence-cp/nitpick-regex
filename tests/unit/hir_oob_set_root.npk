// expect-exit: 94
//
// `hir_set_root` AT AN INDEX NO NODE HAS STOPS. Cycle 0.2.0, RX-223.
//
// The root is `sealed` and set only here, so the check here is the whole of the
// guarantee that `root` names a node or `HIR_NONE`. This sets root 1 in a
// one-node arena and must trap (94, `OutOfBounds`).
mod:hir_oob_set_root;

use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    Hir:h = raw hir_init(4i64);
    discard(raw hir_push(@h, HirNode{ kind: HirKind.Empty, flags: 0u32, a: 0i64, b: 0i64, c: 0i64,
                                      next: HIR_NONE }));
    drop hir_set_root(@h, 1i64);
    drop hir_free(@h);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
