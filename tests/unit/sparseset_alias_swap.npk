// expect-exit: 0
//
// THE SWAP `ENGINES.md` R-5 NEEDS, THROUGH A TEMPORARY, EACH BLOCK FREED ONCE
// -- HARMLESS TODAY, AND THE CONTROL FOR 0.0.4d.
//
// Not a defect: the positive twin of the alias units beside it. The Pike VM
// swaps its current and next thread sets every haystack byte (R-5, subcycle
// 0.7.0). Through a temporary that is three whole-`SparseSet` copies, and the
// temporary is left aliasing one block -- but it is never used or freed, so
// each block is freed exactly once and the answer is right: **0** (21 or 22:
// the swap did not swap).
//
// WHY IT IS COMMITTED. Under the author's decision on question 9 (2026-09-25),
// `Vec` becomes MOVE-ONLY at 0.0.4d, before cycle 0.0 closes, and this spelling
// then stops compiling. 0.0.4d rewrites it with `move(...)`, and it must still
// exit 0: a move-only `Vec` that made the engines' swap unwritable would be a
// design the next cycles could not use. The alias units are what 0.0.4d must
// REFUSE; this is what it must still ALLOW.
//
// Measured at `c3bdae2`: 0 at -O0 and through `opt -O2` (RX-160).
mod:sparseset_alias_swap;

use "../../src/core/sparseset.npk".*;

func:main = int32(cstring[]:_~argv) {
    SparseSet:cur = raw sset_init(8i64);
    SparseSet:nxt = raw sset_init(8i64);
    drop sset_insert(@cur, 1i64);
    drop sset_insert(@nxt, 5i64);
    SparseSet:tmp = cur;
    cur = nxt;
    nxt = tmp;
    if (!(raw sset_contains(@cur, 5i64))) { exit 21i32; }
    if (!(raw sset_contains(@nxt, 1i64))) { exit 22i32; }
    drop sset_free(@cur);
    drop sset_free(@nxt);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
