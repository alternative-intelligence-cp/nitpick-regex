// expect-exit: 108
//
// A NODE WITH TWO PARENTS STOPS THE DUMP. Cycle 0.2.0, RX-225; `HIR.md` H-15.
//
// The writer's walk takes at most twice the arena in steps -- a tree enters and closes each
// node once -- so a node entered twice runs it out of steps when every node hangs from the
// root. Here a `Repeat`'s child is also the last member of the `Concat` that holds the
// `Repeat`, its `next` HIR_NONE, so no other check sees it: the walk would write the literal
// twice, and the text would read back as four nodes. It traps `DecreasesViolated` (108)
// instead. Beside a node nothing reaches the bound has room, and a shared node is written
// once for each parent -- a builder builds a tree (H-15).
mod:hir_dump_shared;

use "../../src/core/core.npk".*;
use "../../src/hir/hir.npk".*;

func:main = int32(cstring[]:_~argv) {
    Hir:h = raw hir_init(4i64);
    int64:x = raw hir_push(@h, HirNode{ kind: HirKind.Literal, flags: 0u32, a: 97i64, b: 0i64, c: 0i64,
                                        next: HIR_NONE });
    int64:r = raw hir_push(@h, HirNode{ kind: HirKind.Repeat, flags: 0u32, a: x, b: 0i64, c: HIR_NONE,
                                        next: x });
    int64:cat = raw hir_push(@h, HirNode{ kind: HirKind.Concat, flags: 0u32, a: r, b: 2i64, c: 0i64,
                                          next: HIR_NONE });
    drop hir_set_root(@h, cat);
    Bytes:b = raw bytes_init(16i64);
    drop hir_dump(@h, @b);
    drop hir_free(@h);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (ShiftRange)        { exit 115i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
