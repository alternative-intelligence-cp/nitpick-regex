//
// AN OWNING ELEMENT IS REFUSED AT THE TYPE, AT EVERY VERB, SINCE CYCLE 0.1.1b:
// `Vec` is `Vec<T: Copy>` (RX-188; `SAFETY.md` S-23a) and an owning type cannot
// implement `Copy`. One site per line above (B-7b): the type where `Vec<string>` is
// first written, then one call per verb, thirteen, each diagnostic naming its verb --
// "`string` does not implement `Copy`, which `vec_push`'s parameter `T` requires".
// Never built -- refused before it could run -- so `z` goes unfreed, one call per verb.
//
// THE NAME IS HISTORY, KEPT SO RX-155's AND RX-168's CITATIONS FIND THE FILE.
// Through `c3bdae2` `vec_get` at `T = string` MOVED the element out -- the slot
// emptied and still counted, a second read empty, exit 0 when this was a unit that
// read twice (RX-155). From cycle 0.0.4e `vec_get` alone was refused, `T: Pod`
// (RX-168) and then `T: Copy` (RX-177), at one site: this file's `vec_get` call.
//
// A TEST OF THE BOUND: against the tree before cycle 0.1.1b this body reports
// `vec_get`'s site and no other, at `5fbaf4a` (`0.1.1b.md` step 1) -- so the other
// thirteen are the type's.
mod:vec_owning_get_moves_out;

use "../../src/core/vec.npk".*;

func:main = int32(cstring[]:_~argv) {
    Vec<string>:v = raw vec_init::<string>(4i64);
    Vec<string>:z = raw vec_init_zeroed::<string>(2i64);
    drop vec_reserve(@v, 8i64);
    string:e = string_concat("abcdefghij", "k");
    drop vec_push(@v, move(e));
    string:f = string_concat("abcdefghij", "l");
    drop vec_insert(@v, 0i64, move(f));
    string:g = string_concat("abcdefghij", "m");
    drop vec_set(@v, 0i64, move(g));
    string:first = raw vec_get(v, 0i64);
    string:last = raw vec_pop(@v);
    drop vec_remove(@v, 0i64);
    drop vec_swap_remove(@v, 0i64);
    drop vec_truncate(@v, 0i64);
    drop vec_clear(@z);
    drop vec_free(@v);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated) { exit 109i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
