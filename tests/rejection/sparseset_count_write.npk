// expect-error: NITPICK-TYPE-079
// expect-error-at: 25:5
//
// A CONSUMER CANNOT WRITE A `SparseSet`'S COUNT. Cycle 0.0.4c, `SAFETY.md` S-24a.
//
// WHAT IT PINS. Membership is `sparse[k] < count && dense[sparse[k]] == k`, and
// `sset_at` walks `dense` below `count`, so `count` decides which of the stale
// entries a clear left behind are members. A count raised from outside turns
// them back into members -- the phantom member `sparseset.npk`'s own header
// warns of, which is a Pike VM walking a thread for a state the automaton is
// not in, and a match that is not there. Since 0.0.4c `count` is
// `sealed limit<ListLen> int64` (the compiler's D-313 and D-308), and the write
// below is `NITPICK-TYPE-079` at compile time. The refusal is the assertion.
//
// A TEST OF THE SEAL, NOT OF THIS FILE: against the tree before 0.0.4c's
// declarations it compiles cleanly (`meta/roadmap/0.0/0.0.4c.md` step 4), and
// `tests/unit/sealed_reads.npk` READS this field and runs.
mod:sparseset_count_write;

use "../../src/core/vec.npk".*;
use "../../src/core/sparseset.npk".*;

func:main = int32(cstring[]:_~argv) {
    SparseSet:s = raw sset_init(8i64);
    s.count = 1i64;
    drop sset_free(@s);
    exit 0i32;
};

// A SUPERSET of what REACH asks, on purpose: a later change in the compiler's
// phase order must not add a stray `REACH-002` beside this file's one code.
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
