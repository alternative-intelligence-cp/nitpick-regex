// expect-exit: 117
//
// PROBE 13h — AN `ensures` VIOLATION TRAPS, AND NO FALLBACK CATCHES IT.
//
// ASKS: when a live postcondition is violated at run time, what happens -- and
// can the caller recover?
//
// MATTERS BECAUSE `refused/probe13d_ensures_arm_missing.npk` can only show that
// an `ensures` charges its consumer an arm, and rule B-7 checks a refusal's
// CODES, not which identity a `REACH-002` line names. This file is the positive
// twin: the same kind of contract, checked at the callee's return, trapping. A
// trapping call cannot be followed by an assertion in the same program, which
// is why this is a separate file.
//
// `expect-exit: 117` is this file's `EnsuresViolated` arm, so reaching
// `failsafe` through that arm IS the assertion. Every other path out of `main`
// exits with a code that names the line it came from, so a wrong answer is
// never 117. With the clause deleted the same file exits 60 -- measured at
// cycle 0.0.4b at `c3bdae2`, at -O0 and through `opt -O2` -- so this file
// tells "checked" from "not checked" by itself.
//
// THE `?|` IS THE POINT, NOT AN IDIOM. If a contract violation were an
// ordinary `Result` error, `v` would be 55 and this program would exit 55. It
// exits 117: the violation takes the TRAP route (the compiler's D-241).
//
// THE ARGUMENT IS DERIVED FROM `argv`, NOT WRITTEN AS A LITERAL. `argv.len` is
// 1 for a program run with no arguments, so `m` is -6 and `successor(m)` is
// -5, computed at run time: no folding can turn the violation into a
// compile-time question and quietly change what this file measures.
mod:probe13h_ensures_violation_traps;

func:successor = int32(int32:a) ensures result > 0i32 {
    pass (a + 1i32);
};

func:main = int32(cstring[]:argv) {
    int32:m = 0i32 - 5i32 - (argv.len =>! int32);
    int32:v = successor(m) ?| 55i32;
    if (v == 55i32)    { exit 55i32; }     // the fallback fired: recoverable
    if (v == m + 1i32) { exit 60i32; }     // the contract was not checked
    exit 61i32;                            // neither, and that is a third finding
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)  { exit 91i32; },
        (HeapOom)         { exit 92i32; },
        (IntOverflow)     { exit 93i32; },
        (OutOfBounds)     { exit 94i32; },
        (Unreachable)     { exit 95i32; },
        (WildLeak)        { exit 96i32; },
        (StackExhausted)  { exit 106i32; },
        (MachineFault)    { exit 107i32; },
        (EnsuresViolated) { exit 117i32; },
        (*)               { exit 99i32; }
    }
    exit 9i32;
};
