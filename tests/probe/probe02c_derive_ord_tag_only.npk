// expect-exit: 0
//
// PROBE 02c — `#[derive(Ord)]` ON A PAYLOAD ENUM COMPILES AND IGNORES THE
// PAYLOAD. The refusal in `probe02b` is a bad afternoon; this one is a wrong
// answer that no diagnostic mentions.
//
// NOT A NEW FINDING. It is the second half of **O-N10** in the workbench
// registry, found by `nitpick-time` cycle 0.0.0 on 2026-09-03. What is new here
// is the ARITY: `nitpick-time` established it for a single-field payload, and
// this file establishes that a variant with TWO payload fields is compared no
// more carefully -- `Repeat(2,5)` and `Repeat(9,9)` are `Equal`.
//
// THE ASSERTIONS BELOW SPELL OUT THE DEFECT rather than the correct answer, and
// that is deliberate: this probe is green while the compiler is wrong, and it
// turns RED on the day O-N10 lands. That is the signal the library wants -- the
// day `cmp` starts reading payloads is the day `hir_eq`'s hand-written nesting
// can be deleted, and a probe that silently kept passing would never say so.
//
// WHY IT MATTERS TO THIS LIBRARY: `HIR.md` H-2's `Hir` is compared whole in
// `TESTING.md`'s fixture diffs, and `API.md`'s `PatternErrorKind` is a closed
// enum a caller is expected to switch on and compare. A `cmp` that answers
// `Equal` for two different repetition bounds would make a fixture diff report
// no change where the desugarer changed `a{2,5}` into `a{9,9}`.
mod:probe02c_derive_ord_tag_only;

error:E9;

#[derive(Ord)]
enum:HirKind = {
    Literal(uint32);
    ClassRef(int32);
    Repeat(int32, int32);
    Empty;
};

func:main = int32(cstring[]:_~argv) {
    // ---- across variants, the derived order is DECLARATION order ----------
    // This half is correct, and it is why the defect is easy to miss: every
    // assertion a reader is likely to write first passes.

    HirKind:lit = HirKind.Literal(97u32);
    HirKind:cls = HirKind.ClassRef(3i32);
    HirKind:emp = HirKind.Empty;

    bool:ok = false;
    pick (lit.cmp(cls) ?! E9) { (Ordering.Less)    { ok = true; }, (*) { } }
    if (!ok)                                            { exit 10i32; }
    ok = false;
    pick (emp.cmp(lit) ?! E9) { (Ordering.Greater) { ok = true; }, (*) { } }
    if (!ok)                                            { exit 11i32; }

    // ---- WITHIN a variant, the payload is not read ------------------------

    // ONE payload field: `nitpick-time`'s finding, confirmed on this enum.
    ok = false;
    pick (HirKind.Literal(7u32).cmp(HirKind.Literal(9u32)) ?! E9) {
        (Ordering.Equal) { ok = true; },
        (*)              { }
    }
    // If this line ever exits 20, O-N10 HAS LANDED: `cmp` now reads payloads,
    // and `probe02_payload_enum.npk`'s `hir_eq` is ready to be replaced by a
    // derive. Do not "fix" the probe -- read the header and delete the nesting.
    if (!ok)                                            { exit 20i32; }

    // TWO payload fields -- THE NEW QUESTION. Not merely a differing second
    // field: BOTH fields differ, and by a wide margin, and it is still `Equal`.
    ok = false;
    pick (HirKind.Repeat(2i32, 5i32).cmp(HirKind.Repeat(9i32, 9i32)) ?! E9) {
        (Ordering.Equal) { ok = true; },
        (*)              { }
    }
    if (!ok)                                            { exit 21i32; }

    // And the direction that would be `Greater` under any payload-aware order.
    ok = false;
    pick (HirKind.Repeat(9i32, 9i32).cmp(HirKind.Repeat(2i32, 5i32)) ?! E9) {
        (Ordering.Equal) { ok = true; },
        (*)              { }
    }
    if (!ok)                                            { exit 22i32; }

    // The hand-written comparison in `probe02_payload_enum.npk` gets all three
    // of the above right. That contrast IS the finding.
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (E9)             { exit 80i32; },
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
