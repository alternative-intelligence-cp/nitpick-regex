// `src/syntax/pattern_error.npk` — WHAT A PATTERN CAN GET WRONG, AND THE ONE
// WAY TO SAY SO. Cycle 0.1.0, RX-172.
//
// `PatternErrorKind` is `meta/specs/SYNTAX.md` §9's closed list: every kind, in
// that section's order, declared complete before the parser produces any of
// them. `check_error_kinds_tested`, cycle 0.1's gate at 0.1.6, diffs this enum
// against the tests that provoke each kind, and it cannot be written against an
// enum that is still moving; a kind added later is a kind nobody notices is
// untested.
//
// `PatternError` is `SAFETY.md` rule S-9's value: the kind, the byte offset into
// the pattern (`SYNTAX.md` Y-10), a length where the construct spans more than a
// point, and a kind-specific detail. EVERY FIELD IS `sealed` (the compiler's
// D-313): read anywhere, written only here -- so outside this file a
// `PatternError{ … }` literal is NITPICK-TYPE-079, and `pattern_error(…)` below
// is the only way anything can build one. No site can forget an offset, because
// there is no other way to build the value than to pass one
// (`tests/rejection/pattern_error_literal.npk`).
//
// A VALUE, NOT AN `error:` IDENTITY. The library has one identity,
// `ERegexPattern`, and it is `api`'s (S-8); `syntax` sits below `api` (`BUILD.md`
// B-16), so the parser hands a `PatternError` back as a value and `api` turns it
// into the identity (RX-175).
//
// THE FILE IS NOT `error.npk`, AND CANNOT BE. `error` is a keyword (the
// `error:` declaration), a file's `mod:` name must equal its basename (B-13), and
// `mod:error;` is refused NITPICK-RESOLVE-012 at 1:1 -- measured at `c970483`. So
// the module is named for the value it builds. *(At `5fbaf4a` the refusal is
// NITPICK-PARSE-001 at 1:5, the keyword itself -- the compiler's DEF-143, the
// second half of our O-N32; cycle 0.1.0b, RX-176.)*
//
// LAYERING (`BUILD.md` §6, rule B-16). `syntax` may import `unicode` and `core`;
// this file imports `core` for one thing, its out-of-range stop `vec_oob`, so a
// program importing it owes `core`'s eleven arms. *(For two since cycle 0.1.1:
// `pattern_error_text` builds its sentence in `core`'s `Bytes` -- RX-187. The
// bill is the same eleven.)*
mod:pattern_error;

use "../core/core.npk".*;

// `SYNTAX.md` §9, in its order. `tests/unit/pattern_error_unit.npk` holds this
// list to that order with an exhaustive `pick`, so a kind added, dropped or
// moved here is a red run, not a review comment. Thirty-six since cycle 0.1.1:
// `EmptyAlternate` is retired, an empty alternative being `Y-27`'s `Empty` (RX-181).
pub enum:PatternErrorKind = {
    // structure
    UnclosedGroup;
    UnopenedGroup;
    UnclosedClass;
    EmptyClass;
    NestTooDeep;
    TrailingBackslash;

    // quantifiers
    NothingToRepeat;
    DoubleRepeat;
    BadRepeatBounds;
    RepeatTooLarge;
    RepeatProductTooLarge;

    // classes
    BadClassRange;
    UnknownPosixClass;
    UnknownUnicodeProperty;
    ClassOpMismatch;
    ClassTooLarge;

    // escapes
    UnknownEscape;
    BadHexEscape;
    BadUnicodeEscape;
    InvalidCodepoint;

    // groups and flags
    DuplicateGroupName;
    BadGroupName;
    UnknownFlag;
    TooManyCaptureGroups;
    WrongNamedGroupSpelling;

    // refusals (§8)
    BackreferenceUnsupported;
    LookaroundUnsupported;
    AtomicGroupUnsupported;
    RecursionUnsupported;
    UnsupportedAnchor;
    UnsupportedGroup;
    UnsupportedQuoting;

    // limits and encoding
    PatternTooLong;
    ProgramTooLarge;
    InvalidPatternEncoding;
    ByteModeNonAscii;
};

// `SAFETY.md` S-9, field for field. Thirty-two bytes, measured at `c970483`:
// S-9 fixes the fields and their order, and the padding that order costs is
// harmless because nothing stores a `PatternError` in a `Vec` -- a parse stops
// at its first error.
pub struct:PatternError = {
    sealed PatternErrorKind:kind;    // SYNTAX.md §9's closed list
    sealed int64:offset;             // byte offset into the pattern (Y-10)
    sealed int64:span_len;           // 0 when the position is a point
    sealed uint32:detail;            // kind-specific: the offending codepoint, the bound exceeded
};

// obligation: never fails requires offset >= 0i64 && span_len >= 0i64
//
// THE ONE CONSTRUCTOR (RX-172). A negative offset or length is a defect in the
// code that built the error, never in the pattern, and it stops HERE, on `core`'s
// one out-of-range stop (exit 94, `OutOfBounds`), rather than reaching a user as
// a position that is not in their pattern. `tests/unit/pattern_error_offset_negative.npk`
// and `pattern_error_span_negative.npk` are the two stops.
pub func:pattern_error = PatternError(PatternErrorKind:kind, int64:offset, int64:span_len, uint32:detail) never fails {
    if (offset < 0i64)   { drop vec_oob(offset); }
    if (span_len < 0i64) { drop vec_oob(span_len); }
    pass PatternError{ kind: kind, offset: offset, span_len: span_len, detail: detail };
};

// ---- a detail that names no codepoint (`SYNTAX.md` §9; RX-203) ------------------------

// U+110000, one past the last codepoint, U+10FFFF. A refusal whose detail is a codepoint --
// the one it found where it wanted another -- says with this what no codepoint can: that the
// pattern ENDED where one was due (`BadGroupName`, `BadHexEscape`, `BadUnicodeEscape`), or that
// an escape named a value past the last (`InvalidCodepoint`). Until cycle 0.1.4 `BadGroupName`
// said the first with 0, which is U+0000's value too, so a NUL in a name read "the name has no
// closing `>`" (0.1.1's record).
pub fixed uint32:NOT_A_CODEPOINT = 1114112u32;

// ---- the POSIX class names (`SYNTAX.md` §5.1, Y-38; RX-197) ----------------------

// How many names §5.1 lists. A `PosixClass` node's `a` is a name's place in that list,
// from 0 (Y-27), and these are the only names a class may write as `[:name:]`.
pub fixed int64:POSIX_CLASS_NAMES = 14i64;

// obligation: never fails
//
// The `k`th name of `SYNTAX.md` §5.1's list, in its order -- `""` for a `k` outside it.
// The ONE home of the list: the parser matches a written name against it and the text
// below renders from it, so the two cannot disagree.
pub func:posix_class_name = string(int64:k) never fails {
    if (k == 0i64)  { pass "alpha"; }
    if (k == 1i64)  { pass "digit"; }
    if (k == 2i64)  { pass "alnum"; }
    if (k == 3i64)  { pass "space"; }
    if (k == 4i64)  { pass "upper"; }
    if (k == 5i64)  { pass "lower"; }
    if (k == 6i64)  { pass "punct"; }
    if (k == 7i64)  { pass "print"; }
    if (k == 8i64)  { pass "graph"; }
    if (k == 9i64)  { pass "cntrl"; }
    if (k == 10i64) { pass "xdigit"; }
    if (k == 11i64) { pass "blank"; }
    if (k == 12i64) { pass "word"; }
    if (k == 13i64) { pass "ascii"; }
    pass "";
};

// ---- the text a person reads (RX-187; `SYNTAX.md` Y-34) -------------------------

func:put = NIL(Bytes->:b, string:s) never fails {
    drop bytes_extend_str(b, s);
    pass NIL;
};

func:num = NIL(Bytes->:b, int64:n) never fails {
    drop bytes_put_uint(b, n =>! uint64);
    pass NIL;
};

// The byte a refusal names, as the character it is (`detail` holds it).
func:ch = NIL(Bytes->:b, uint32:d) never fails {
    drop bytes_push(b, d =>! uint8);
    pass NIL;
};

// ---- codepoints in a sentence (RX-204) -------------------------------------------

// The first codepoint UTF-8 writes in two bytes, in three, in four (RFC 3629 §3).
fixed int64:UTF8_TWO = 128i64;
fixed int64:UTF8_THREE = 2048i64;
fixed int64:UTF8_FOUR = 65536i64;

// `v` in upper-case hex, at least `min` digits -- a shift and a mask a digit, no division
// (`SAFETY.md` S-25). `v` is at most U+110000 here, six digits; eight bound the loop.
func:hex = NIL(Bytes->:b, int64:v, int64:min) never fails {
    uint8[]:digit = string_bytes("0123456789ABCDEF");
    int64:n = 1i64;
    while ((n < 8i64) && ((v >> (4i64 * n)) != 0i64)) decreases 8i64 - n {
        n = n + 1i64;
    }
    if (n < min) { n = min; }
    while (n > 0i64) decreases n {
        n = n - 1i64;
        drop bytes_push(b, digit[(v >> (4i64 * n)) & 15i64]);
    }
    pass NIL;
};

// How many bytes UTF-8 writes the codepoint `cp` in.
func:utf8_count = int64(int64:cp) never fails {
    if (cp < UTF8_TWO) { pass 1i64; }
    if (cp < UTF8_THREE) { pass 2i64; }
    if (cp < UTF8_FOUR) { pass 3i64; }
    pass 4i64;
};

// The `k`th byte, from 0, of the codepoint `cp` in UTF-8.
func:utf8_at = int64(int64:cp, int64:k) never fails {
    int64:n = raw utf8_count(cp);
    if (n == 1i64) { pass cp; }
    if (k > 0i64) { pass 128i64 | ((cp >> (6i64 * (n - 1i64 - k))) & 63i64); }
    if (n == 2i64) { pass 192i64 | (cp >> 6i64); }
    if (n == 3i64) { pass 224i64 | (cp >> 12i64); }
    pass 240i64 | (cp >> 18i64);
};

// The codepoint `cp`, written as itself.
func:utf8 = NIL(Bytes->:b, int64:cp) never fails {
    int64:k = 0i64;
    int64:n = raw utf8_count(cp);
    while (k < n) decreases n - k {
        drop bytes_push(b, (raw utf8_at(cp, k)) =>! uint8);
        k = k + 1i64;
    }
    pass NIL;
};

// The codepoint a sentence names: printable ASCII as itself between backticks, and a space, a
// control, a backtick or anything past ASCII as `U+` and four or more hex digits, so no sentence
// carries a byte a reader cannot see.
func:shown = NIL(Bytes->:b, uint32:d) never fails {
    if ((d > 32u32) && (d < 127u32) && (d != 96u32)) {
        drop put(b, "`"); drop bytes_push(b, d =>! uint8); drop put(b, "`");
        pass NIL;
    }
    drop put(b, "U+"); drop hex(b, d => int64, 4i64);
    pass NIL;
};

// obligation: never fails
//
// WHAT IS WRONG, WHERE, AND WHAT TO WRITE INSTEAD (Y-34). One sentence naming the
// kind and the byte offset, then the reason, then the fix wherever the library
// can tell what the author meant -- `\(` for a literal parenthesis, `(?<name>…)`
// for Python's spelling, `(?:…)` for a group that need not capture. A refusal of
// a construct nregex declines (`SYNTAX.md` §8) names the guarantee it would break
// or the alternative, never "unsupported" alone (`COMPAT.md` K-1). Built in a
// `Bytes`, so no number costs an allocation or a division (`bytes_put_uint`,
// S-25), and a program that never calls it pays nothing for it.
pub func:pattern_error_text = string(PatternError:e) never fails {
    Bytes:b = raw bytes_init(160i64);
    pick (e.kind) {
        (PatternErrorKind.UnclosedGroup) {
            drop put(@b, "unclosed group at byte "); drop num(@b, e.offset);
            drop put(@b, ": this `(` has no matching `)`");
            if (e.detail > 1u32) {
                drop put(@b, "; "); drop num(@b, e.detail => int64);
                drop put(@b, " groups are still open at the end of the pattern, and this is the innermost");
            }
            drop put(@b, ". Add a `)`, or write `\\(` to match a parenthesis.");
        },
        (PatternErrorKind.UnopenedGroup) {
            drop put(@b, "unopened group at byte "); drop num(@b, e.offset);
            drop put(@b, ": this `)` closes no group. Remove it, or write `\\)` to match a parenthesis.");
        },
        (PatternErrorKind.UnclosedClass) {
            drop put(@b, "unclosed class at byte "); drop num(@b, e.offset);
            if (e.detail == 93u32) {
                drop put(@b, ": this `[` has no matching `]` -- a `]` straight after `[` or `[^` is a member of the class, not its end. Add a `]`, as in `[]]` for a class of `]`, or write `\\[` to match a bracket.");
            }
            else {
                drop put(@b, ": this `[` has no matching `]`. Add a `]`, or write `\\[` to match a bracket.");
            }
        },
        (PatternErrorKind.EmptyClass) {
            drop put(@b, "empty class at byte "); drop num(@b, e.offset);
            drop put(@b, ": a class matches one of its items, and this one has none.");
        },
        (PatternErrorKind.NestTooDeep) {
            drop put(@b, "nesting too deep at byte "); drop num(@b, e.offset);
            drop put(@b, ": the `(` or `[` here would nest groups and classes "); drop num(@b, (e.detail => int64) + 1i64);
            drop put(@b, " deep, and they may nest at most "); drop num(@b, e.detail => int64);
            drop put(@b, " deep (NREGEX_NEST_DEPTH). Nest fewer: write `(?:a)` as `a`, and `[[a]]` as `[a]`.");
        },
        (PatternErrorKind.TrailingBackslash) {
            drop put(@b, "trailing backslash at byte "); drop num(@b, e.offset);
            drop put(@b, ": the pattern ends inside an escape. Write `\\\\` to match a backslash.");
        },
        (PatternErrorKind.NothingToRepeat) {
            drop put(@b, "nothing to repeat at byte "); drop num(@b, e.offset);
            drop put(@b, ": the `"); drop ch(@b, e.detail);
            drop put(@b, "` follows no expression -- it opens the pattern, a group or an alternative. Write `\\");
            drop ch(@b, e.detail); drop put(@b, "` to match it.");
        },
        (PatternErrorKind.DoubleRepeat) {
            drop put(@b, "double repetition at byte "); drop num(@b, e.offset);
            drop put(@b, ": this `"); drop ch(@b, e.detail);
            drop put(@b, "` repeats a repetition. Group what it repeats, as in `(?:a+)*`, or remove one of the two.");
        },
        (PatternErrorKind.BadRepeatBounds) {
            drop put(@b, "bad repetition bounds at byte "); drop num(@b, e.offset);
            if (e.detail == 1u32) {
                drop put(@b, ": the minimum is greater than the maximum. Write the smaller bound first.");
            }
            else {
                drop put(@b, ": a `{` must begin `{n}`, `{n,}` or `{n,m}`, in decimal digits. Write `\\{` to match a brace.");
            }
        },
        (PatternErrorKind.RepeatTooLarge) {
            drop put(@b, "repetition too large at byte "); drop num(@b, e.offset);
            drop put(@b, ": a bound may be at most "); drop num(@b, e.detail => int64);
            drop put(@b, " (NREGEX_REPEAT_MAX). Repeat a group instead, as in `(?:a{1000}){2}`.");
        },
        (PatternErrorKind.RepeatProductTooLarge) {
            drop put(@b, "repetition too large at byte "); drop num(@b, e.offset);
            drop put(@b, ": nested repetitions multiply, and this one takes the product past ");
            drop num(@b, e.detail => int64); drop put(@b, " (NREGEX_REPEAT_PRODUCT).");
        },
        (PatternErrorKind.BadClassRange) {
            drop put(@b, "bad class range at byte "); drop num(@b, e.offset);
            if (e.detail == 1u32) {
                drop put(@b, ": a range joins two codepoints, and an end of this one is a class. To match `-` itself, put it first or last in the class, or write `\\-`.");
            }
            else {
                drop put(@b, ": a range must not end before it starts. Write the lower bound first.");
            }
        },
        (PatternErrorKind.UnknownPosixClass) {
            if (e.detail > 0u32) {
                string:name = raw posix_class_name((e.detail => int64) - 1i64);
                drop put(@b, "POSIX class outside a class at byte "); drop num(@b, e.offset);
                drop put(@b, ": `[:"); drop put(@b, name);
                drop put(@b, ":]` is the POSIX class "); drop put(@b, name);
                drop put(@b, " only inside a class, and written as a class of its own its bytes are its members, `:` and the letters in `");
                drop put(@b, name);
                drop put(@b, "`. Write `[[:"); drop put(@b, name);
                drop put(@b, ":]]` for the POSIX class, `[[:^"); drop put(@b, name);
                drop put(@b, ":]]` for its complement, or `[\\:"); drop put(@b, name);
                drop put(@b, ":]` for its bytes.");
            }
            else {
                drop put(@b, "unknown POSIX class at byte "); drop num(@b, e.offset);
                drop put(@b, ": a POSIX class is `[:name:]` inside a class, as in `[[:alpha:]]`, and the names are ");
                int64:k = 0i64;
                while (k < POSIX_CLASS_NAMES) decreases POSIX_CLASS_NAMES - k {
                    if (k > 0i64) {
                        if ((k + 1i64) == POSIX_CLASS_NAMES) { drop put(@b, " and "); }
                        else { drop put(@b, ", "); }
                    }
                    drop put(@b, raw posix_class_name(k));
                    k = k + 1i64;
                }
                drop put(@b, ". Write `\\:` to match a `:`.");
            }
        },
        (PatternErrorKind.UnknownUnicodeProperty) {
            drop put(@b, "unknown Unicode property at byte "); drop num(@b, e.offset);
            if (e.detail == 1u32) {
                drop put(@b, ": `\\p` and `\\P` take a one-letter name, as in `\\pL`, or a name in braces, as in `\\p{Greek}`.");
            }
            else if (e.detail == 2u32) {
                drop put(@b, ": the name in braces has no closing `}`. End it with `}`, as in `\\p{Greek}`.");
            }
            else if (e.detail == 3u32) {
                drop put(@b, ": the braces hold no name. Write one between them, as in `\\p{Greek}`.");
            }
            else {
                drop put(@b, ": nregex does not know this property.");
            }
        },
        (PatternErrorKind.ClassOpMismatch) {
            drop put(@b, "class operator at byte "); drop num(@b, e.offset);
            drop put(@b, " is missing an operand: `"); drop ch(@b, e.detail); drop ch(@b, e.detail);
            drop put(@b, "` needs members on both sides, as in `[a-z"); drop ch(@b, e.detail); drop ch(@b, e.detail);
            drop put(@b, "aeiou]`. Write `\\"); drop ch(@b, e.detail);
            drop put(@b, "` to match `"); drop ch(@b, e.detail); drop put(@b, "` itself.");
        },
        (PatternErrorKind.ClassTooLarge) {
            drop put(@b, "class too large at byte "); drop num(@b, e.offset);
            drop put(@b, ": after case folding it has more than "); drop num(@b, e.detail => int64);
            drop put(@b, " ranges (NREGEX_CLASS_RANGES).");
        },
        (PatternErrorKind.UnknownEscape) {
            drop put(@b, "unknown escape at byte "); drop num(@b, e.offset);
            if (e.detail == 48u32) {
                drop put(@b, ": `\\0` before a digit begins an octal escape in Perl, PCRE, Python and Java, and nregex reads no octal. Write the codepoint in hex instead, as in `\\x0A` for `\\012`, or `\\x00` and then the digit for a NUL and a digit.");
            }
            else if (e.detail == 98u32) {
                drop put(@b, ": `\\b` is a word boundary, a position, and a class holds codepoints. Move it out of the class, or write `\\x08` to match a backspace, as Perl and Python read `[\\b]`.");
            }
            else if ((e.detail == 66u32) || (e.detail == 65u32) || (e.detail == 122u32)) {
                drop put(@b, ": `\\"); drop ch(@b, e.detail);
                drop put(@b, "` matches a position, and a class holds codepoints. Move it out of the class.");
            }
            else if (e.detail >= 128u32) {
                drop put(@b, ": a `\\` before a codepoint past ASCII escapes nothing. Write `");
                drop utf8(@b, e.detail => int64); drop put(@b, "` without it.");
            }
            else {
                drop put(@b, ": `\\"); drop ch(@b, e.detail);
                drop put(@b, "` is not an escape nregex defines, and a `\\` before a letter or a digit never stands for that letter or digit. Write `");
                drop ch(@b, e.detail); drop put(@b, "` to match it, or `\\\\` to match a backslash.");
            }
        },
        (PatternErrorKind.BadHexEscape) {
            drop put(@b, "bad hex escape at byte "); drop num(@b, e.offset);
            if (e.detail == NOT_A_CODEPOINT) { drop put(@b, ": the pattern ends inside it."); }
            else { drop put(@b, ": "); drop shown(@b, e.detail); drop put(@b, " is not a hex digit."); }
            drop put(@b, " `\\x` takes exactly two hex digits, as in `\\x41`, or one or more in braces, as in `\\x{1F600}`.");
        },
        (PatternErrorKind.BadUnicodeEscape) {
            drop put(@b, "bad Unicode escape at byte "); drop num(@b, e.offset);
            if (e.detail == NOT_A_CODEPOINT) { drop put(@b, ": the pattern ends inside it."); }
            else { drop put(@b, ": "); drop shown(@b, e.detail); drop put(@b, " is not a hex digit."); }
            drop put(@b, " `\\u` takes exactly four hex digits, as in `\\u00E9`, and `\\U` exactly eight, as in `\\U0001F600`; a codepoint in braces is `\\x{1F600}`.");
        },
        (PatternErrorKind.InvalidCodepoint) {
            drop put(@b, "invalid codepoint at byte "); drop num(@b, e.offset);
            if (e.detail == NOT_A_CODEPOINT) {
                drop put(@b, ": the escape names a value past U+10FFFF, the last codepoint. Write one from U+0000 to U+10FFFF.");
            }
            else {
                drop put(@b, ": "); drop shown(@b, e.detail);
                drop put(@b, " is a surrogate, half of a UTF-16 pair, and UTF-8 has no form for it. Write the codepoint the pair stands for, as in `\\x{1F600}` for `\\uD83D\\uDE00`.");
            }
        },
        (PatternErrorKind.DuplicateGroupName) {
            drop put(@b, "duplicate group name at byte "); drop num(@b, e.offset);
            drop put(@b, ": this name already names group "); drop num(@b, e.detail => int64);
            drop put(@b, ". Rename one of the two.");
        },
        (PatternErrorKind.BadGroupName) {
            drop put(@b, "bad group name at byte "); drop num(@b, e.offset);
            if (e.detail == NOT_A_CODEPOINT) {
                drop put(@b, ": the name has no closing `>`. End it with `>`, as in `(?<name>...)`.");
            }
            else if (e.detail == 62u32) {
                drop put(@b, ": the name is empty. Write one between `<` and `>`, as in `(?<name>...)`.");
            }
            else {
                drop put(@b, ": a name is ASCII letters, digits and `_`, and does not begin with a digit.");
            }
        },
        (PatternErrorKind.UnknownFlag) {
            drop put(@b, "unknown flag at byte "); drop num(@b, e.offset);
            drop put(@b, ": a flag is one of `i`, `m`, `s`, `x` and `u`.");
        },
        (PatternErrorKind.TooManyCaptureGroups) {
            drop put(@b, "too many capture groups at byte "); drop num(@b, e.offset);
            drop put(@b, ": this group would be number "); drop num(@b, (e.detail => int64) + 1i64);
            drop put(@b, ", and a pattern may have "); drop num(@b, e.detail => int64);
            drop put(@b, " (NREGEX_CAPTURE_GROUPS). Make the groups you do not read non-capturing, `(?:...)`.");
        },
        (PatternErrorKind.WrongNamedGroupSpelling) {
            drop put(@b, "wrong named-group spelling at byte "); drop num(@b, e.offset);
            if (e.detail == 39u32) { drop put(@b, ": `(?'name'...)` is the .NET spelling. Write `(?<name>...)`."); }
            else { drop put(@b, ": `(?P<name>...)` is Python's spelling. Write `(?<name>...)`."); }
        },
        (PatternErrorKind.BackreferenceUnsupported) {
            drop put(@b, "backreference at byte "); drop num(@b, e.offset);
            drop put(@b, " is not supported: matching one is NP-hard in general, and every nregex search takes linear time. Capture both parts and compare them yourself.");
        },
        (PatternErrorKind.LookaroundUnsupported) {
            drop put(@b, "lookaround at byte "); drop num(@b, e.offset);
            drop put(@b, " is not supported: it cannot be matched in linear time, which every nregex search guarantees. Match the larger text and inspect its captures instead.");
        },
        (PatternErrorKind.AtomicGroupUnsupported) {
            if (e.detail == 43u32) {
                drop put(@b, "possessive repetition at byte "); drop num(@b, e.offset);
                drop put(@b, " is not supported: it steers backtracking, and nregex never backtracks -- every search takes linear time. Remove the `+` for an ordinary repetition.");
            }
            else {
                drop put(@b, "atomic group at byte "); drop num(@b, e.offset);
                drop put(@b, " is not supported: it steers backtracking, and nregex never backtracks -- every search takes linear time. Write a plain group, `(?:...)`.");
            }
        },
        (PatternErrorKind.RecursionUnsupported) {
            drop put(@b, "recursion at byte "); drop num(@b, e.offset);
            drop put(@b, " is not supported: a recursive pattern is not a regular expression and cannot be matched in linear time. Parse nested structure with a parser instead.");
        },
        (PatternErrorKind.UnsupportedAnchor) {
            drop put(@b, "unsupported anchor at byte "); drop num(@b, e.offset);
            if (e.detail == 90u32) { drop put(@b, ": there is no `\\Z`. Write `\\n?\\z` to match at the end or before a final newline."); }
            else { drop put(@b, ": there is no `\\G`. Search from an offset with regex_find_at instead."); }
        },
        (PatternErrorKind.UnsupportedGroup) {
            drop put(@b, "comment group at byte "); drop num(@b, e.offset);
            drop put(@b, " is not supported: in `x` mode, `#` starts a comment that runs to the end of the line.");
        },
        (PatternErrorKind.UnsupportedQuoting) {
            drop put(@b, "quoting at byte "); drop num(@b, e.offset);
            drop put(@b, " is not supported: build a pattern that matches a literal string with regex_escape() instead of `\\Q...\\E`.");
        },
        (PatternErrorKind.PatternTooLong) {
            drop put(@b, "pattern too long at byte "); drop num(@b, e.offset);
            drop put(@b, ": a pattern may be at most "); drop num(@b, e.detail => int64);
            drop put(@b, " bytes (NREGEX_PATTERN_BYTES).");
        },
        (PatternErrorKind.ProgramTooLarge) {
            drop put(@b, "pattern too large at byte "); drop num(@b, e.offset);
            drop put(@b, ": its compiled program would exceed "); drop num(@b, e.detail => int64);
            drop put(@b, " instructions (NREGEX_PROGRAM_INSTRUCTIONS).");
        },
        (PatternErrorKind.InvalidPatternEncoding) {
            drop put(@b, "invalid UTF-8 at byte "); drop num(@b, e.offset);
            drop put(@b, ": a pattern is UTF-8 text, and this sequence is not well-formed.");
        },
        (PatternErrorKind.ByteModeNonAscii) {
            drop put(@b, "non-ASCII literal at byte "); drop num(@b, e.offset);
            drop put(@b, " under `(?-u)`: in byte mode a literal is one byte. Write the bytes as `\\xHH` escapes, or leave `u` on.");
        }
    }
    pass raw bytes_copy_string(@b);
};
