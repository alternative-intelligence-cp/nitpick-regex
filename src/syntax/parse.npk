// `src/syntax/parse.npk` — THE PARSER: PATTERN TEXT TO AN AST. Cycle 0.1.0 wrote
// its entry's first refusal (RX-175); cycle 0.1.1 writes the core grammar
// (RX-182 … RX-186; `meta/specs/SYNTAX.md` §1 and Y-28 … Y-33); cycle 0.1.3 its
// classes (RX-197, RX-198; Y-35 … Y-38); cycle 0.1.4 its escapes and flags (RX-203 …
// RX-208; Y-40 … Y-43); cycle 0.1.5 its refusals of what §8 declines, and `regex_escape`
// (RX-209 … RX-213; Y-44, Y-45).
//
// HOW `syntax` SAYS A PATTERN IS WRONG: WITH A VALUE. The library's one `error:`
// identity, `ERegexPattern`, is `api`'s (`SAFETY.md` S-8), and `syntax` sits
// below `api` (`BUILD.md` B-16), so the parser answers a `PatternError` as a
// value -- `PatternError?`, `NIL` when nothing is wrong -- and `api` turns the
// first one into the identity. A parse stops at its first error.
//
// THREE REFUSALS BEFORE ANY GRAMMAR, IN THIS ORDER. The length (RX-175), which
// bounds everything after it; then the encoding (Y-28): a pattern is UTF-8 text,
// checked whole against RFC 3629 before a byte of grammar is read, so every
// later step decodes without checking; then the grammar.
//
// AN EXPLICIT STACK, NEVER NATIVE RECURSION (RX-032, `SAFETY.md` S-18). One
// `while` walks the pattern once. A `(` saves the frame being built on a
// `Vec<Frame>` and starts the group's; its `)` builds the group's node and takes
// the saved frame back. No function here calls itself, and `check_no_recursion`
// says so on every run (RX-192). `NREGEX_NEST_DEPTH` bounds the stack since cycle
// 0.1.2: a `(` that would nest groups deeper is `NestTooDeep` at that `(`, before
// a byte after it is read (Y-35, RX-193). Until then the pattern's length bounded it.
// *(2026-10-01, cycle 0.1.3 -- RX-197, RX-198: a class is read by a `while` of its own,
// `parse_class`'s, which the walk's calls at a `[` -- still once over the pattern, on
// an explicit stack of its own, `Vec<ClassFrame>` -- and groups and classes nest at
// most `NREGEX_NEST_DEPTH` deep together, refused at the `(` or `[` that would go
// deeper.)*
//
// THE TREE IS BUILT BOTTOM-UP INTO THE ARENA (Y-26, Y-27, Y-33). A frame keeps two
// lists: the alternatives closed so far, and the pieces of the current one. A
// list is its first node and each node's `next`, linked by rewriting the node
// before (`ast_get`, then `ast_set`). The LAST atom is held back, PENDING, so a
// quantifier after it can wrap it in a `Repeat` before it joins its list.
//
// EVERY LOOP IS A `while` OVER AN `int64`, `decreases` WHAT IS LEFT -- never a
// `for` over a range, a `loop` or a `till`.
//
// LAYERING (`BUILD.md` §6, B-16). Imports `core` and the layer's own three
// modules; a program importing it owes `core`'s eleven arms.
mod:parse;

use "../core/core.npk".*;
use "./pattern_error.npk".*;
use "./cursor.npk".*;
use "./ast.npk".*;

// ---- the bytes the grammar names, as the cursor answers them ---------------
fixed int32:CH_TAB = 9i32;           // the first of five white-space controls, tab … carriage return,
fixed int32:CH_LF = 10i32;           // line feed, which ends an `x` comment (§4)
fixed int32:CH_CR = 13i32;           // carriage return, the last
fixed int32:CH_SPACE = 32i32;        // and the space: the white space `x` skips (Y-42)
fixed int32:CH_BANG = 33i32;         // `!`, the first ASCII punctuation
fixed int32:CH_DEL = 127i32;         // the last ASCII byte (Y-2)
fixed int32:CH_HASH = 35i32;         // `#`
fixed int32:CH_DOLLAR = 36i32;       // `$`
fixed int32:CH_AMP = 38i32;          // `&`
fixed int32:CH_QUOTE = 39i32;        // `'`
fixed int32:CH_LPAREN = 40i32;       // `(`
fixed int32:CH_RPAREN = 41i32;       // `)`
fixed int32:CH_STAR = 42i32;         // `*`
fixed int32:CH_PLUS = 43i32;         // `+`
fixed int32:CH_COMMA = 44i32;        // `,`
fixed int32:CH_MINUS = 45i32;        // `-`
fixed int32:CH_DOT = 46i32;          // `.`
fixed int32:CH_0 = 48i32;
fixed int32:CH_9 = 57i32;
fixed int32:CH_COLON = 58i32;        // `:`, the first punctuation after the digits
fixed int32:CH_LT = 60i32;           // `<`
fixed int32:CH_EQ = 61i32;           // `=`
fixed int32:CH_GT = 62i32;           // `>`
fixed int32:CH_QUESTION = 63i32;     // `?`
fixed int32:CH_UPPER_A = 65i32;
fixed int32:CH_UPPER_B = 66i32;      // `\B`, not a word boundary (§6)
fixed int32:CH_UPPER_D = 68i32;      // `\D`, not a digit (Y-37)
fixed int32:CH_UPPER_E = 69i32;      // `\E`, which ends Perl's quotation (§8)
fixed int32:CH_UPPER_F = 70i32;      // the last capital hex digit
fixed int32:CH_UPPER_G = 71i32;      // `\G`, Perl's anchor at the previous match's end (§8)
fixed int32:CH_UPPER_K = 75i32;      // `\K`, Perl's and PCRE's reset of a match's start (§8, RX-210)
fixed int32:CH_UPPER_P = 80i32;
fixed int32:CH_UPPER_Q = 81i32;      // `\Q`, which begins Perl's quotation (§8)
fixed int32:CH_UPPER_R = 82i32;
fixed int32:CH_UPPER_S = 83i32;      // `\S`, not white space
fixed int32:CH_UPPER_U = 85i32;      // `\U` and eight hex digits (§1's `Escape`)
fixed int32:CH_UPPER_W = 87i32;      // `\W`, not a word codepoint
fixed int32:CH_UPPER_Z = 90i32;
fixed int32:CH_LBRACKET = 91i32;     // `[`, the first punctuation after the capitals
fixed int32:CH_BACKSLASH = 92i32;    // `\`
fixed int32:CH_RBRACKET = 93i32;     // `]`
fixed int32:CH_CARET = 94i32;        // `^`
fixed int32:CH_UNDERSCORE = 95i32;   // `_`
fixed int32:CH_LOWER_A = 97i32;      // `\a`, the bell
fixed int32:CH_LOWER_B = 98i32;      // `\b`, a word boundary (§6)
fixed int32:CH_LOWER_D = 100i32;     // `\d`, a digit (Y-37)
fixed int32:CH_LOWER_E = 101i32;     // `\e`, escape
fixed int32:CH_LOWER_F = 102i32;     // `\f`, form feed; and the last small hex digit
fixed int32:CH_LOWER_G = 103i32;     // `\g`, Perl's and PCRE's backreference, and PCRE's call (§8)
fixed int32:CH_LOWER_I = 105i32;     // `i`, the flag: case-insensitive (§4)
fixed int32:CH_LOWER_K = 107i32;     // `\k`, a backreference by name (§8)
fixed int32:CH_LOWER_M = 109i32;     // `m`, the flag: multi-line
fixed int32:CH_LOWER_N = 110i32;     // `\n`, line feed
fixed int32:CH_LOWER_P = 112i32;     // `\p`, a Unicode property (Y-37)
fixed int32:CH_LOWER_R = 114i32;     // `\r`, carriage return
fixed int32:CH_LOWER_S = 115i32;     // `\s`, white space
fixed int32:CH_LOWER_T = 116i32;     // `\t`, tab
fixed int32:CH_LOWER_U = 117i32;     // `\u` and four hex digits (§1's `Escape`)
fixed int32:CH_LOWER_V = 118i32;     // `\v`, vertical tab
fixed int32:CH_LOWER_W = 119i32;     // `\w`, a word codepoint
fixed int32:CH_LOWER_X = 120i32;     // `\x` and hex digits (§1's `Escape`)
fixed int32:CH_LOWER_Z = 122i32;
fixed int32:CH_LBRACE = 123i32;      // `{`, the first punctuation after the small letters
fixed int32:CH_PIPE = 124i32;        // `|`
fixed int32:CH_RBRACE = 125i32;      // `}`
fixed int32:CH_TILDE = 126i32;       // `~`, the last ASCII punctuation

// ---- RFC 3629's table, as `int64` byte values (Y-28) ------------------------
fixed int64:U8_CONT_LO = 128i64;     // 0x80: a continuation byte's floor
fixed int64:U8_CONT_HI = 191i64;     // 0xBF: and its ceiling
fixed int64:U8_LEAD2_LO = 194i64;    // 0xC2: the first two-byte lead (0xC0, 0xC1 are overlong)
fixed int64:U8_LEAD2_HI = 223i64;    // 0xDF
fixed int64:U8_E0 = 224i64;          // 0xE0: three bytes, the second 0xA0 … 0xBF
fixed int64:U8_E0_SECOND = 160i64;   // 0xA0
fixed int64:U8_EC = 236i64;          // 0xE1 … 0xEC: three bytes, any continuation
fixed int64:U8_ED = 237i64;          // 0xED: three bytes, the second 0x80 … 0x9F (no surrogates)
fixed int64:U8_ED_SECOND = 159i64;   // 0x9F
fixed int64:U8_EF = 239i64;          // 0xEE … 0xEF: three bytes, any continuation
fixed int64:U8_F0 = 240i64;          // 0xF0: four bytes, the second 0x90 … 0xBF
fixed int64:U8_F0_SECOND = 144i64;   // 0x90
fixed int64:U8_F3 = 243i64;          // 0xF1 … 0xF3: four bytes, any continuation
fixed int64:U8_F4 = 244i64;          // 0xF4: four bytes, the second 0x80 … 0x8F (no more than U+10FFFF)
fixed int64:U8_F4_SECOND = 143i64;   // 0x8F

// ---- white space past ASCII that some engine skips under `x` (Y-42; RX-207) -------
// Unicode's White_Space, which Rust's `regex` skips, and Pattern_White_Space, which Perl skips --
// `PropList.txt` of the UCD, the same in 16.0.0, 17.0.0 and 18.0.0.
fixed int64:WS_NEL = 133i64;             // U+0085, next line: both
fixed int64:WS_NBSP = 160i64;            // U+00A0, no-break space: White_Space
fixed int64:WS_OGHAM = 5760i64;          // U+1680
fixed int64:WS_EN_QUAD = 8192i64;        // U+2000 … U+200A, the typographic spaces
fixed int64:WS_HAIR = 8202i64;
fixed int64:WS_LRM = 8206i64;            // U+200E, U+200F, the direction marks: Pattern_White_Space
fixed int64:WS_RLM = 8207i64;
fixed int64:WS_LSEP = 8232i64;           // U+2028, U+2029, the separators: both
fixed int64:WS_PSEP = 8233i64;
fixed int64:WS_NNBSP = 8239i64;          // U+202F, U+205F, U+3000
fixed int64:WS_MMSP = 8287i64;
fixed int64:WS_IDEO = 12288i64;

// ---- the codepoints an escape may name (§1's `Escape`; RX-204) ---------------
fixed int64:CP_SURROGATE_LO = 55296i64;  // U+D800, the first surrogate: half of a UTF-16 pair, no codepoint
fixed int64:CP_SURROGATE_HI = 57343i64;  // U+DFFF, the last
fixed int64:CP_MAX = 1114111i64;         // U+10FFFF, the last codepoint

// ---- the class operators and what a class read last (Y-27, Y-36) ------------
fixed int64:CLASS_AND = 0i64;        // `&&`, Y-27's `ClassOp` code
fixed int64:CLASS_DIFF = 1i64;       // `--`
fixed int64:CLASS_XOR = 2i64;        // `~~`
fixed int64:AFTER_START = 0i64;      // a member may start: the class's start, after its first `]`, a range or an operator
fixed int64:AFTER_ONE = 1i64;        // one codepoint, which a `-` joins to the next in a range
fixed int64:AFTER_CLASS = 2i64;      // a class -- `\d`, `\p{…}`, `[:name:]`, `[…]` -- which no `-` may join

// One open group, or the pattern itself at the bottom of the stack: the two
// lists being built at its level, and what its `Group` node will carry.
#[derive(Copy)]
struct:Frame = {
    int64:alt_first;     // the alternatives closed so far: the first, the last, how many
    int64:alt_last;
    int64:alt_count;
    int64:alt_pos;       // where the body starts: after the group's head, or 0
    int64:cat_first;     // the current alternative's linked pieces
    int64:cat_last;
    int64:cat_count;
    int64:cat_pos;       // where the current alternative starts
    int64:pending;       // the last atom, not linked yet, which a quantifier may wrap
    int64:open;          // the group's `(`, or AST_NONE for the pattern itself
    int64:cap;           // its capture index, 0 if it captures nothing (Y-6)
    int64:name_len;      // its name's length, the name at `open + 3` (Y-27); 0 if unnamed
    uint32:flags;        // the flags in force (Y-12, Y-41): AST_FLAG_U until a flag group changes them
};

// A named group seen so far, for `DuplicateGroupName` (Y-8).
#[derive(Copy)]
struct:GroupName = {
    int64:off;           // the name's first byte in the pattern
    int64:len;           // its length
    int64:cap;           // its group's capture index
};

// What an escape names, once read (Y-2, §1's `Escape`): whether it names a codepoint, which, and
// whether it was written `\x` and two hex digits -- which names a byte under `(?-u)` (Y-13).
struct:Esc = {
    bool:named;          // the escape names the codepoint `cp`; false for every other escape
    bool:byte;           // written `\xHH`
    int64:cp;
};

// One open class (Y-36): the union of members being read, the operators before it
// folded left, and what its `Class` node will carry.
#[derive(Copy)]
struct:ClassFrame = {
    int64:open;          // its `[`
    uint32:neg;          // AST_FLAG_NEGATED for `[^`, else 0
    bool:lead;           // its first member is a `]`, which an unclosed class's message names
    int64:expr;          // the unions and operators before the current union, folded left; AST_NONE before the first operator
    int64:op;            // the operator after `expr`: CLASS_AND, CLASS_DIFF or CLASS_XOR
    int64:op_at;         // that operator's first byte
    int64:first;         // the union being read: its first member, its last, how many
    int64:last;
    int64:count;
    int64:upos;          // where the union starts
    int64:uend;          // where its last member ends
    int64:after;         // AFTER_START, AFTER_ONE or AFTER_CLASS
};

// The whole state of one parse. MOVE-ONLY, because it holds three `Vec`s
// (`SAFETY.md` S-23b): built by `parse_pattern`, lent by pointer, freed there.
struct:Parser = {
    Cursor:c;                  // the pattern, read once, left to right
    Frame:f;                   // the frame being built
    int64:next_cap;            // the next capture index to hand out, from 1
    Vec<Frame>:stack;          // the frames of the enclosing groups, innermost last
    Vec<GroupName>:names;      // every named group so far
    Vec<ClassFrame>:classes;   // the classes enclosing the one being read, innermost last
};

// ---- characters --------------------------------------------------------------

func:is_digit = bool(int32:b) never fails {
    pass (b >= CH_0) && (b <= CH_9);
};

// `Name ::= [A-Za-z_][A-Za-z0-9_]*` (SYNTAX.md §1).
func:is_name_start = bool(int32:b) never fails {
    if ((b >= CH_UPPER_A) && (b <= CH_UPPER_Z)) { pass true; }
    if ((b >= CH_LOWER_A) && (b <= CH_LOWER_Z)) { pass true; }
    pass b == CH_UNDERSCORE;
};

func:is_name_char = bool(int32:b) never fails {
    if (raw is_digit(b)) { pass true; }
    pass raw is_name_start(b);
};

func:is_lower = bool(int32:b) never fails {
    pass (b >= CH_LOWER_A) && (b <= CH_LOWER_Z);
};

func:is_letter = bool(int32:b) never fails {
    if (raw is_lower(b)) { pass true; }
    pass (b >= CH_UPPER_A) && (b <= CH_UPPER_Z);
};

// The letters after `\` that make a class rather than a codepoint: `\d \D \w \W
// \s \S` and `\p \P` (Y-37).
func:is_class_letter = bool(int32:b) never fails {
    if ((b == CH_LOWER_D) || (b == CH_UPPER_D) || (b == CH_LOWER_W) || (b == CH_UPPER_W)) { pass true; }
    if ((b == CH_LOWER_S) || (b == CH_UPPER_S)) { pass true; }
    pass (b == CH_LOWER_P) || (b == CH_UPPER_P);
};

// ASCII that is neither a letter nor a digit -- punctuation, a space, a control, DEL -- which a
// `\` before it writes literally (Y-2, as RX-204 widens it from punctuation alone): all but `<`
// and `>`, which Rust's `regex` and GNU `grep` read as word assertions and Perl, PCRE, Python and
// Java as the bytes, so nregex reads them neither way (RX-205).
func:is_literal_escape = bool(int32:b) never fails {
    if ((b < 0i32) || (b > CH_DEL)) { pass false; }
    if ((b == CH_LT) || (b == CH_GT)) { pass false; }
    if (raw is_letter(b)) { pass false; }
    pass !(raw is_digit(b));
};

// White space as `x` skips it outside a class (§4, Y-42): tab, line feed, vertical tab, form feed,
// carriage return and space -- the six every engine measured skips.
func:is_space = bool(int32:b) never fails {
    if ((b >= CH_TAB) && (b <= CH_CR)) { pass true; }
    pass b == CH_SPACE;
};

// White space past ASCII that some engine skips under `x` and another reads as itself (Y-42).
func:is_wide_space = bool(int64:cp) never fails {
    if ((cp == WS_NEL) || (cp == WS_NBSP) || (cp == WS_OGHAM)) { pass true; }
    if ((cp >= WS_EN_QUAD) && (cp <= WS_HAIR)) { pass true; }
    if ((cp == WS_LRM) || (cp == WS_RLM) || (cp == WS_LSEP) || (cp == WS_PSEP)) { pass true; }
    pass (cp == WS_NNBSP) || (cp == WS_MMSP) || (cp == WS_IDEO);
};

// A hex digit's value, or -1 for any other byte -- `CURSOR_END` included.
func:hex_value = int64(int32:b) never fails {
    if (raw is_digit(b)) { pass (b - CH_0) => int64; }
    if ((b >= CH_UPPER_A) && (b <= CH_UPPER_F)) { pass ((b - CH_UPPER_A) => int64) + 10i64; }
    if ((b >= CH_LOWER_A) && (b <= CH_LOWER_F)) { pass ((b - CH_LOWER_A) => int64) + 10i64; }
    pass -1i64;
};

// The codepoint a control escape's letter names -- `\a` bell, `\t` tab, `\n` line feed, `\v`
// vertical tab, `\f` form feed, `\r` carriage return, `\e` escape (§1's `Escape`) -- or -1.
func:control_cp = int64(int32:d) never fails {
    if (d == CH_LOWER_A) { pass 7i64; }
    if (d == CH_LOWER_T) { pass 9i64; }
    if (d == CH_LOWER_N) { pass 10i64; }
    if (d == CH_LOWER_V) { pass 11i64; }
    if (d == CH_LOWER_F) { pass 12i64; }
    if (d == CH_LOWER_R) { pass 13i64; }
    if (d == CH_LOWER_E) { pass 27i64; }
    pass -1i64;
};

// The bit a flag's letter sets -- `i`, `m`, `s`, `x`, `u`, Y-26's `AST_FLAG_` bits (§4) -- or 0 for a
// byte that is no flag.
func:flag_bit = uint32(int32:b) never fails {
    if (b == CH_LOWER_I) { pass AST_FLAG_I; }
    if (b == CH_LOWER_M) { pass AST_FLAG_M; }
    if (b == CH_LOWER_S) { pass AST_FLAG_S; }
    if (b == CH_LOWER_X) { pass AST_FLAG_X; }
    if (b == CH_LOWER_U) { pass AST_FLAG_U; }
    pass 0u32;
};

// The length of the UTF-8 sequence a lead byte begins, in a VALIDATED pattern.
func:utf8_len = int64(int64:lead) never fails {
    if (lead < U8_CONT_LO) { pass 1i64; }
    if (lead < U8_E0) { pass 2i64; }
    if (lead < U8_F0) { pass 3i64; }
    pass 4i64;
};

// The codepoint whose UTF-8 sequence starts at `i` in a VALIDATED pattern.
func:decode_at = int64(uint8[]:pat, int64:i) never fails {
    int64:lead = pat[i] => int64;
    int64:n = raw utf8_len(lead);
    int64:cp = lead;
    if (n == 2i64) { cp = lead - U8_LEAD2_LO + 2i64; }
    if (n == 3i64) { cp = lead - U8_E0; }
    if (n == 4i64) { cp = lead - U8_F0; }
    int64:k = 1i64;
    while (k < n) decreases n - k {
        cp = (cp * 64i64) + ((pat[i + k] => int64) - U8_CONT_LO);
        k = k + 1i64;
    }
    pass cp;
};

// ---- the two refusals before the grammar ------------------------------------

// obligation: never fails ensures result == NIL iff pat is well-formed UTF-8 (RFC 3629)
//
// `NIL` if the whole pattern is well-formed UTF-8, else `InvalidPatternEncoding`
// at the FIRST ill-formed sequence (Y-28): its offset the sequence's first byte,
// its length the bytes read up to and including the one that broke it, its
// detail that byte -- or 0 when the pattern ended inside the sequence.
pub func:parse_check_encoding = PatternError?(uint8[]:pat) never fails {
    int64:i = 0i64;
    while (i < pat.len) decreases pat.len - i {
        int64:b = pat[i] => int64;
        int64:need = 0i64;
        int64:lo = U8_CONT_LO;
        int64:hi = U8_CONT_HI;
        if (b < U8_CONT_LO) { need = 0i64; }
        else if ((b >= U8_LEAD2_LO) && (b <= U8_LEAD2_HI)) { need = 1i64; }
        else if (b == U8_E0) { need = 2i64; lo = U8_E0_SECOND; }
        else if ((b > U8_E0) && (b <= U8_EC)) { need = 2i64; }
        else if (b == U8_ED) { need = 2i64; hi = U8_ED_SECOND; }
        else if ((b > U8_ED) && (b <= U8_EF)) { need = 2i64; }
        else if (b == U8_F0) { need = 3i64; lo = U8_F0_SECOND; }
        else if ((b > U8_F0) && (b <= U8_F3)) { need = 3i64; }
        else if (b == U8_F4) { need = 3i64; hi = U8_F4_SECOND; }
        else {
            // a continuation byte where a character must start, 0xC0, 0xC1, or 0xF5 … 0xFF
            pass raw pattern_error(PatternErrorKind.InvalidPatternEncoding, i, 1i64, b =>! uint32);
        }
        int64:k = 1i64;
        while (k <= need) decreases need + 1i64 - k {
            if ((i + k) >= pat.len) {
                pass raw pattern_error(PatternErrorKind.InvalidPatternEncoding, i, k, 0u32);
            }
            int64:x = pat[i + k] => int64;
            if ((x < lo) || (x > hi)) {
                pass raw pattern_error(PatternErrorKind.InvalidPatternEncoding, i, k + 1i64, x =>! uint32);
            }
            lo = U8_CONT_LO;
            hi = U8_CONT_HI;
            k = k + 1i64;
        }
        i = i + need + 1i64;
    }
    pass NIL;
};

// obligation: never fails ensures (result == NIL) == (pat.len <= NREGEX_PATTERN_BYTES)
//
// `NIL` if the pattern is at most `NREGEX_PATTERN_BYTES` long, else
// `PatternTooLong`: its offset the first byte past the bound, its length the bytes
// over it, its detail the bound. The bound is 65 536, which a `uint32` holds, so
// the narrowing truncates nothing (`SAFETY.md` S-12).
pub func:parse_check_length = PatternError?(uint8[]:pat) never fails {
    if (pat.len > NREGEX_PATTERN_BYTES) {
        pass raw pattern_error(PatternErrorKind.PatternTooLong, NREGEX_PATTERN_BYTES,
                               pat.len - NREGEX_PATTERN_BYTES, NREGEX_PATTERN_BYTES =>! uint32);
    }
    pass NIL;
};

// ---- building the tree -----------------------------------------------------

func:node = AstNode(AstKind:k, uint32:flags, int64:a, int64:b, int64:c, int64:pos, int64:len) never fails {
    pass AstNode{ kind: k, flags: flags, a: a, b: b, c: c, next: AST_NONE, pos: pos, len: len };
};

// Makes `n` the sibling after `last`.
func:link = NIL(Ast->:out, int64:last, int64:n) never fails {
    AstNode:prev = raw ast_get(<-out, last);
    prev.next = n;
    drop ast_set(out, last, prev);
    pass NIL;
};

func:frame = Frame(int64:open, int64:start, int64:cap, int64:name_len, uint32:flags) never fails {
    pass Frame{ alt_first: AST_NONE, alt_last: AST_NONE, alt_count: 0i64, alt_pos: start,
                cat_first: AST_NONE, cat_last: AST_NONE, cat_count: 0i64, cat_pos: start,
                pending: AST_NONE, open: open, cap: cap, name_len: name_len, flags: flags };
};

// Links the pending atom into the current alternative.
func:commit = NIL(Ast->:out, Frame->:f) never fails {
    if (f.pending == AST_NONE) { pass NIL; }
    if (f.cat_last == AST_NONE) { f.cat_first = f.pending; }
    else { drop link(out, f.cat_last, f.pending); }
    f.cat_last = f.pending;
    f.cat_count = f.cat_count + 1i64;
    f.pending = AST_NONE;
    pass NIL;
};

// A new atom: the one before it joins its list, and this one is held pending.
func:atom = NIL(Ast->:out, Frame->:f, AstKind:k, int64:a, int64:pos, int64:len) never fails {
    drop commit(out, f);
    f.pending = raw ast_push(out, raw node(k, f.flags, a, 0i64, 0i64, pos, len));
    pass NIL;
};

// The same, for an atom whose node is built already: a Perl class or a property
// outside a class (Y-37).
func:atom_node = NIL(Ast->:out, Frame->:f, AstNode:n) never fails {
    drop commit(out, f);
    f.pending = raw ast_push(out, n);
    pass NIL;
};

// Closes the current alternative, which ends at `upto`, into ONE piece -- `Empty`
// if it has none, the piece itself if it has one, a `Concat` if more -- and adds
// it to the alternation.
func:close_alt = NIL(Ast->:out, Frame->:f, int64:upto) never fails {
    drop commit(out, f);
    int64:piece = f.cat_first;
    if (f.cat_count == 0i64) {
        piece = raw ast_push(out, raw node(AstKind.Empty, f.flags, 0i64, 0i64, 0i64, upto, 0i64));
    }
    else if (f.cat_count > 1i64) {
        piece = raw ast_push(out, raw node(AstKind.Concat, f.flags, f.cat_first, f.cat_count, 0i64,
                                           f.cat_pos, upto - f.cat_pos));
    }
    if (f.alt_last == AST_NONE) { f.alt_first = piece; }
    else { drop link(out, f.alt_last, piece); }
    f.alt_last = piece;
    f.alt_count = f.alt_count + 1i64;
    f.cat_first = AST_NONE;
    f.cat_last = AST_NONE;
    f.cat_count = 0i64;
    pass NIL;
};

// Closes the alternation at `upto` and answers the body's node: the one
// alternative, or an `Alternate` of them all.
func:close_body = int64(Ast->:out, Frame->:f, int64:upto) never fails {
    drop close_alt(out, f, upto);
    if (f.alt_count == 1i64) { pass f.alt_first; }
    pass raw ast_push(out, raw node(AstKind.Alternate, f.flags, f.alt_first, f.alt_count, 0i64,
                                    f.alt_pos, upto - f.alt_pos));
};

// ---- groups (Y-29, Y-30) ---------------------------------------------------

// Starts a group's frame: the one being built is saved on the stack. Every call is
// made after `open_group`'s first line -- there, or in `named_group`, which only
// `open_group` calls -- so the stack never holds more than `NREGEX_NEST_DEPTH` frames
// (Y-35).
func:push_group = NIL(Parser->:p, int64:open, int64:cap, int64:name_len) never fails {
    uint32:fl = p.f.flags;
    drop vec_push(@p.stack, p.f);
    p.f = raw frame(open, p.c.pos, cap, name_len, fl);
    pass NIL;
};

// The next capture index, or `TooManyCaptureGroups` at the group's `(` when the
// pattern already has `NREGEX_CAPTURE_GROUPS` (S-12).
func:take_cap = PatternError?(Parser->:p, int64:open) never fails {
    if (p.next_cap > NREGEX_CAPTURE_GROUPS) {
        pass raw pattern_error(PatternErrorKind.TooManyCaptureGroups, open, 1i64,
                               NREGEX_CAPTURE_GROUPS =>! uint32);
    }
    pass NIL;
};

// `(?<name>` with `(?<` read: the name, its `>`, and the checks on both (Y-8, Y-29). A pattern
// that ends inside the name is `BadGroupName` with `NOT_A_CODEPOINT`, which no codepoint is, so a
// NUL in the name keeps its own detail, 0 (RX-203).
func:named_group = PatternError?(uint8[]:pat, Parser->:p, int64:open) never fails {
    int64:start = p.c.pos;
    int32:b = raw cursor_peek(@p.c);
    if (b == CURSOR_END) {
        pass raw pattern_error(PatternErrorKind.BadGroupName, start, 0i64, NOT_A_CODEPOINT);
    }
    if (b == CH_GT) {
        pass raw pattern_error(PatternErrorKind.BadGroupName, start, 1i64, CH_GT =>! uint32);
    }
    if (!(raw is_name_start(b))) {
        pass raw pattern_error(PatternErrorKind.BadGroupName, start, raw utf8_len(b => int64),
                               raw decode_at(pat, start) =>! uint32);
    }
    while (raw is_name_char(raw cursor_peek(@p.c))) decreases pat.len - p.c.pos {
        discard(raw cursor_bump(@p.c));
    }
    int64:len = p.c.pos - start;
    int32:t = raw cursor_peek(@p.c);
    if (t == CURSOR_END) {
        pass raw pattern_error(PatternErrorKind.BadGroupName, start, len, NOT_A_CODEPOINT);
    }
    if (t != CH_GT) {
        pass raw pattern_error(PatternErrorKind.BadGroupName, p.c.pos, raw utf8_len(t => int64),
                               raw decode_at(pat, p.c.pos) =>! uint32);
    }
    discard(raw cursor_bump(@p.c));
    PatternError?:full = raw take_cap(p, open);
    if (full != NIL) { pass full; }
    int64:j = 0i64;
    while (j < p.names.count) decreases p.names.count - j {
        GroupName:g = raw vec_get(p.names, j);
        if (g.len == len) {
            int64:k = 0i64;
            bool:same = true;
            while (k < len) decreases len - k {
                if (pat[g.off + k] != pat[start + k]) { same = false; }
                k = k + 1i64;
            }
            if (same) {
                pass raw pattern_error(PatternErrorKind.DuplicateGroupName, start, len, g.cap =>! uint32);
            }
        }
        j = j + 1i64;
    }
    drop vec_push(@p.names, GroupName{ off: start, len: len, cap: p.next_cap });
    drop push_group(p, open, p.next_cap, len);
    p.next_cap = p.next_cap + 1i64;
    pass NIL;
};

// `(?` read at `open`, then flags (Y-12, Y-41; §1's `Flags`): the letters `imsxu`, at most one `-`,
// and at least one letter after `(?` and after the `-` -- `neg` says the `-` came first, `(?-i)`.
// Then `:` opens a group with them in force, and `)` ends a `Flags` node that sets them for the rest
// of the enclosing group, linked at once, so no quantifier can take it (RX-206). A byte that is no
// flag is `UnknownFlag` at it, its detail that codepoint -- a `)` or `:` where a flag is due, and a
// second `-`, included; a flag named twice is `DuplicateFlag` at the second, its detail the letter;
// and a pattern that ends inside the flags is `UnclosedGroup` spanning them, as `(?` at the end is.
func:read_flags = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, int64:open, bool:neg) never fails {
    uint32:set = 0u32;
    uint32:clear = 0u32;
    bool:minus = neg;
    bool:named = false;
    while (!(raw cursor_at_end(@p.c))) decreases pat.len - p.c.pos {
        int64:at = p.c.pos;
        int32:b = raw cursor_peek(@p.c);
        if ((b == CH_COLON) || (b == CH_RPAREN)) {
            if (!named) {
                pass raw pattern_error(PatternErrorKind.UnknownFlag, at, 1i64, b =>! uint32);
            }
            discard(raw cursor_bump(@p.c));
            uint32:fl = (p.f.flags | set) & ~clear;
            if (b == CH_COLON) {
                drop push_group(p, open, 0i64, 0i64);
                p.f.flags = fl;
                pass NIL;
            }
            drop commit(out, @p.f);
            p.f.pending = raw ast_push(out, raw node(AstKind.Flags, p.f.flags, set => int64, clear => int64, 0i64,
                                                     open, p.c.pos - open));
            drop commit(out, @p.f);
            p.f.flags = fl;
            pass NIL;
        }
        else if (b == CH_MINUS) {
            if (minus) {
                pass raw pattern_error(PatternErrorKind.UnknownFlag, at, 1i64, CH_MINUS =>! uint32);
            }
            minus = true;
            named = false;
            discard(raw cursor_bump(@p.c));
        }
        else {
            uint32:bit = raw flag_bit(b);
            if (bit == 0u32) {
                pass raw pattern_error(PatternErrorKind.UnknownFlag, at, raw utf8_len(b => int64),
                                       raw decode_at(pat, at) =>! uint32);
            }
            if (((set | clear) & bit) != 0u32) {
                pass raw pattern_error(PatternErrorKind.DuplicateFlag, at, 1i64, b =>! uint32);
            }
            if (minus) { clear = clear | bit; }
            else { set = set | bit; }
            named = true;
            discard(raw cursor_bump(@p.c));
        }
    }
    pass raw pattern_error(PatternErrorKind.UnclosedGroup, open, p.c.pos - open,
                           (p.stack.count + 1i64) =>! uint32);
};

// A refusal of a group head, spanning it from its `(` through the byte just read.
func:head_refused = PatternError?(Parser->:p, PatternErrorKind:k, int64:open, int32:b) never fails {
    pass raw pattern_error(k, open, p.c.pos - open, b =>! uint32);
};

// `(` read at `open`. First the depth (Y-35): a `(` that would nest groups deeper
// than `NREGEX_NEST_DEPTH` is `NestTooDeep` here, before a byte after it is read --
// so no frame past the bound is pushed, and the parse stops where the bound is.
// Then what follows decides the group (Y-29), or the refusal (Y-30).
func:open_group = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, int64:open) never fails {
    if (p.stack.count >= NREGEX_NEST_DEPTH) {
        pass raw pattern_error(PatternErrorKind.NestTooDeep, open, 1i64, NREGEX_NEST_DEPTH =>! uint32);
    }
    drop commit(out, @p.f);
    if (!(raw cursor_eat(@p.c, CH_QUESTION =>! uint8))) {
        PatternError?:full = raw take_cap(p, open);
        if (full != NIL) { pass full; }
        drop push_group(p, open, p.next_cap, 0i64);
        p.next_cap = p.next_cap + 1i64;
        pass NIL;
    }
    int32:b = raw cursor_peek(@p.c);
    if (b == CURSOR_END) {
        pass raw pattern_error(PatternErrorKind.UnclosedGroup, open, p.c.pos - open,
                               (p.stack.count + 1i64) =>! uint32);
    }
    if (b == CH_COLON) {
        discard(raw cursor_bump(@p.c));
        drop push_group(p, open, 0i64, 0i64);
        pass NIL;
    }
    if (b == CH_LT) {
        discard(raw cursor_bump(@p.c));
        int32:d = raw cursor_peek(@p.c);
        if ((d == CH_EQ) || (d == CH_BANG)) {
            discard(raw cursor_bump(@p.c));
            pass raw head_refused(p, PatternErrorKind.LookaroundUnsupported, open, d);
        }
        pass raw named_group(pat, p, open);
    }
    if (b == CH_UPPER_P) {
        discard(raw cursor_bump(@p.c));
        int32:d = raw cursor_peek(@p.c);
        if (d == CH_LT) {
            discard(raw cursor_bump(@p.c));
            pass raw head_refused(p, PatternErrorKind.WrongNamedGroupSpelling, open, CH_UPPER_P);
        }
        if (d == CH_EQ) {
            discard(raw cursor_bump(@p.c));
            pass raw head_refused(p, PatternErrorKind.BackreferenceUnsupported, open, d);
        }
        if (d == CH_GT) {
            discard(raw cursor_bump(@p.c));
            pass raw head_refused(p, PatternErrorKind.RecursionUnsupported, open, d);
        }
        pass raw pattern_error(PatternErrorKind.UnknownFlag, open + 2i64, 1i64, CH_UPPER_P =>! uint32);
    }
    if (b == CH_QUOTE) {
        discard(raw cursor_bump(@p.c));
        pass raw head_refused(p, PatternErrorKind.WrongNamedGroupSpelling, open, b);
    }
    if ((b == CH_EQ) || (b == CH_BANG)) {
        discard(raw cursor_bump(@p.c));
        pass raw head_refused(p, PatternErrorKind.LookaroundUnsupported, open, b);
    }
    if (b == CH_GT) {
        discard(raw cursor_bump(@p.c));
        pass raw head_refused(p, PatternErrorKind.AtomicGroupUnsupported, open, b);
    }
    if (b == CH_HASH) {
        discard(raw cursor_bump(@p.c));
        pass raw head_refused(p, PatternErrorKind.UnsupportedGroup, open, b);
    }
    if ((b == CH_UPPER_R) || (b == CH_AMP) || (b == CH_PLUS) || (raw is_digit(b))) {
        discard(raw cursor_bump(@p.c));
        pass raw head_refused(p, PatternErrorKind.RecursionUnsupported, open, b);
    }
    if (b == CH_MINUS) {
        discard(raw cursor_bump(@p.c));
        int32:d = raw cursor_peek(@p.c);
        if (raw is_digit(d)) {
            discard(raw cursor_bump(@p.c));
            pass raw head_refused(p, PatternErrorKind.RecursionUnsupported, open, d);
        }
        pass raw read_flags(pat, out, p, open, true);
    }
    // A flag, or any other byte no head names: the flags (Y-41, RX-206).
    pass raw read_flags(pat, out, p, open, false);
};

// `)` read at `at`: the group's node, which becomes its parent's pending atom. Its flags are the ones
// in force at its `(`, the parent's -- a `(?i)` inside it ends with it (Y-12, RX-206).
func:close_group = PatternError?(Ast->:out, Parser->:p, int64:at) never fails {
    if (p.stack.count == 0i64) {
        pass raw pattern_error(PatternErrorKind.UnopenedGroup, at, 1i64, 0u32);
    }
    int64:body = raw close_body(out, @p.f, at);
    Frame:inner = p.f;
    p.f = raw vec_pop(@p.stack);
    p.f.pending = raw ast_push(out, raw node(AstKind.Group, p.f.flags, body, inner.cap, inner.name_len,
                                             inner.open, p.c.pos - inner.open));
    pass NIL;
};

// ---- quantifiers (Y-32) ----------------------------------------------------

// Decimal digits at the cursor, at least one known to be there. The value stops
// growing once it passes `NREGEX_REPEAT_MAX`, so no digit string can overflow.
func:digits = int64(Cursor->:c) never fails {
    int64:v = 0i64;
    while (raw is_digit(raw cursor_peek(c))) decreases c.src.len - c.pos {
        int32:d = raw cursor_bump(c);
        if (v <= NREGEX_REPEAT_MAX) { v = (v * 10i64) + ((d - CH_0) => int64); }
    }
    pass v;
};

// A quantifier's first byte `b` read at `at`: wraps the pending atom in a `Repeat`.
func:quantify = PatternError?(Ast->:out, Parser->:p, int64:at, int32:b) never fails {
    if (p.f.pending == AST_NONE) {
        pass raw pattern_error(PatternErrorKind.NothingToRepeat, at, 1i64, b =>! uint32);
    }
    AstNode:target = raw ast_get(<-out, p.f.pending);
    if (target.kind == AstKind.Repeat) {
        pass raw pattern_error(PatternErrorKind.DoubleRepeat, at, 1i64, b =>! uint32);
    }
    int64:min = 0i64;
    int64:max = AST_NONE;
    if (b == CH_PLUS) { min = 1i64; }
    else if (b == CH_QUESTION) { max = 1i64; }
    else if (b == CH_LBRACE) {
        if (!(raw is_digit(raw cursor_peek(@p.c)))) {
            // after `\b` or `\B`, detail 2: Rust's `regex` reads `\b{start}` as a word assertion and
            // Perl `\b{wb}` and `\B{wb}` as Unicode boundaries, and the sentence names both (RX-213) --
            // when a letter follows the `{`, as each name they read begins with one; a comma, a space or
            // nothing there is a bound gone wrong, as after any atom (2026-10-08, cycle 0.1.6a -- RX-215)
            uint32:why = 0u32;
            if ((target.kind == AstKind.WordBoundary) && (raw is_letter(raw cursor_peek(@p.c)))) { why = 2u32; }
            pass raw pattern_error(PatternErrorKind.BadRepeatBounds, at, p.c.pos - at, why);
        }
        int64:min_at = p.c.pos;
        min = raw digits(@p.c);
        int64:min_len = p.c.pos - min_at;
        int64:max_at = min_at;
        int64:max_len = min_len;
        if (raw cursor_eat(@p.c, CH_RBRACE =>! uint8)) { max = min; }
        else if (raw cursor_eat(@p.c, CH_COMMA =>! uint8)) {
            if (!(raw cursor_eat(@p.c, CH_RBRACE =>! uint8))) {
                if (!(raw is_digit(raw cursor_peek(@p.c)))) {
                    pass raw pattern_error(PatternErrorKind.BadRepeatBounds, at, p.c.pos - at, 0u32);
                }
                max_at = p.c.pos;
                max = raw digits(@p.c);
                max_len = p.c.pos - max_at;
                if (!(raw cursor_eat(@p.c, CH_RBRACE =>! uint8))) {
                    pass raw pattern_error(PatternErrorKind.BadRepeatBounds, at, p.c.pos - at, 0u32);
                }
            }
        }
        else {
            pass raw pattern_error(PatternErrorKind.BadRepeatBounds, at, p.c.pos - at, 0u32);
        }
        if (min > NREGEX_REPEAT_MAX) {
            pass raw pattern_error(PatternErrorKind.RepeatTooLarge, min_at, min_len,
                                   NREGEX_REPEAT_MAX =>! uint32);
        }
        if ((max != AST_NONE) && (max > NREGEX_REPEAT_MAX)) {
            pass raw pattern_error(PatternErrorKind.RepeatTooLarge, max_at, max_len,
                                   NREGEX_REPEAT_MAX =>! uint32);
        }
        if ((max != AST_NONE) && (min > max)) {
            pass raw pattern_error(PatternErrorKind.BadRepeatBounds, at, p.c.pos - at, 1u32);
        }
    }
    uint32:bits = p.f.flags;
    if (raw cursor_eat(@p.c, CH_QUESTION =>! uint8)) { bits = bits + AST_FLAG_LAZY; }
    else if (raw cursor_eat(@p.c, CH_PLUS =>! uint8)) {
        pass raw pattern_error(PatternErrorKind.AtomicGroupUnsupported, at, p.c.pos - at,
                               CH_PLUS =>! uint32);
    }
    p.f.pending = raw ast_push(out, raw node(AstKind.Repeat, bits, p.f.pending, min, max,
                                             target.pos, p.c.pos - target.pos));
    pass NIL;
};

// ---- escapes and literals (Y-2, Y-28) --------------------------------------

// `\p` or `\P` read, its `\` at `at`: the name -- one ASCII letter, or everything up to
// the first `}` after a `{` -- read past and kept as text for cycle 0.3 to resolve
// (Y-37). `UnknownUnicodeProperty` at the `\` when the name cannot be read: detail 1,
// neither an ASCII letter nor `{` after the `p`; 2, a `{` with no `}`; 3, braces with
// nothing between.
func:read_property = PatternError?(Parser->:p, int64:at) never fails {
    int32:b = raw cursor_peek(@p.c);
    if (b == CH_LBRACE) {
        discard(raw cursor_bump(@p.c));
        int64:start = p.c.pos;
        while ((!(raw cursor_at_end(@p.c))) && ((raw cursor_peek(@p.c)) != CH_RBRACE)) decreases p.c.src.len - p.c.pos {
            discard(raw cursor_bump(@p.c));
        }
        if (raw cursor_at_end(@p.c)) {
            pass raw pattern_error(PatternErrorKind.UnknownUnicodeProperty, at, p.c.pos - at, 2u32);
        }
        bool:empty = p.c.pos == start;
        discard(raw cursor_bump(@p.c));
        if (empty) {
            pass raw pattern_error(PatternErrorKind.UnknownUnicodeProperty, at, p.c.pos - at, 3u32);
        }
        pass NIL;
    }
    if (raw is_letter(b)) {
        discard(raw cursor_bump(@p.c));
        pass NIL;
    }
    pass raw pattern_error(PatternErrorKind.UnknownUnicodeProperty, at, 2i64, 1u32);
};

// `\d \D \w \W \s \S` or `\p…` `\P…` (Y-37), its `\` at `at` and its name read
// up to `upto`: the node, unresolved -- which class a Perl letter names, or where a
// property's name is in the pattern; cycle 0.3 resolves both. A capital negates.
func:escape_class_node = AstNode(uint8[]:pat, uint32:flags, int64:at, int32:d, int64:upto) never fails {
    uint32:bits = flags;
    if ((d == CH_UPPER_D) || (d == CH_UPPER_W) || (d == CH_UPPER_S) || (d == CH_UPPER_P)) {
        bits = bits + AST_FLAG_NEGATED;
    }
    if ((d == CH_LOWER_D) || (d == CH_UPPER_D)) { pass raw node(AstKind.PerlClass, bits, 0i64, 0i64, 0i64, at, 2i64); }
    if ((d == CH_LOWER_W) || (d == CH_UPPER_W)) { pass raw node(AstKind.PerlClass, bits, 1i64, 0i64, 0i64, at, 2i64); }
    if ((d == CH_LOWER_S) || (d == CH_UPPER_S)) { pass raw node(AstKind.PerlClass, bits, 2i64, 0i64, 0i64, at, 2i64); }
    if ((pat[at + 2i64] => int32) == CH_LBRACE) {
        pass raw node(AstKind.UnicodeClass, bits, at + 3i64, upto - at - 4i64, 0i64, at, upto - at);
    }
    pass raw node(AstKind.UnicodeClass, bits, at + 2i64, 1i64, 0i64, at, upto - at);
};

// ---- escapes that name a codepoint (Y-2, §1's `Escape`; RX-204) --------------------

// The escape at `at` wanted a hex digit and found another byte: `kind` at the `\`, spanning
// through that byte, its detail the codepoint it begins -- or, where the pattern ended, spanning
// what was read, its detail `NOT_A_CODEPOINT` (RX-203).
func:escape_bad_digit = PatternError?(uint8[]:pat, Parser->:p, PatternErrorKind:kind, int64:at) never fails {
    int32:b = raw cursor_peek(@p.c);
    if (b == CURSOR_END) {
        pass raw pattern_error(kind, at, p.c.pos - at, NOT_A_CODEPOINT);
    }
    pass raw pattern_error(kind, at, (p.c.pos - at) + raw utf8_len(b => int64),
                           raw decode_at(pat, p.c.pos) =>! uint32);
};

// The value `v` an escape read through `p.c.pos` from its `\` at `at` names: a codepoint, or
// `InvalidCodepoint` spanning the escape -- its detail a surrogate's value, or `NOT_A_CODEPOINT` for
// any value past U+10FFFF.
func:escape_value = PatternError?(Parser->:p, int64:at, Esc->:e, int64:v) never fails {
    if ((v >= CP_SURROGATE_LO) && (v <= CP_SURROGATE_HI)) {
        pass raw pattern_error(PatternErrorKind.InvalidCodepoint, at, p.c.pos - at, v =>! uint32);
    }
    if (v > CP_MAX) {
        pass raw pattern_error(PatternErrorKind.InvalidCodepoint, at, p.c.pos - at, NOT_A_CODEPOINT);
    }
    e.named = true;
    e.cp = v;
    pass NIL;
};

// `\x` read, its `\` at `at`: exactly two hex digits, a codepoint up to U+00FF that under `(?-u)`
// is a byte (Y-13) -- or one or more in braces, `\x{1F600}`, any codepoint. The value stops growing
// once it passes U+10FFFF, so no run of digits overflows, as `digits` stops (RX-184).
func:hex_escape = PatternError?(uint8[]:pat, Parser->:p, int64:at, Esc->:e) never fails {
    int64:v = 0i64;
    if (raw cursor_eat(@p.c, CH_LBRACE =>! uint8)) {
        int64:n = 0i64;
        while ((raw hex_value(raw cursor_peek(@p.c))) >= 0i64) decreases pat.len - p.c.pos {
            int64:h = raw hex_value(raw cursor_bump(@p.c));
            if (v <= CP_MAX) { v = (v * 16i64) + h; }
            n = n + 1i64;
        }
        if ((n == 0i64) || !(raw cursor_eat(@p.c, CH_RBRACE =>! uint8))) {
            pass raw escape_bad_digit(pat, p, PatternErrorKind.BadHexEscape, at);
        }
        pass raw escape_value(p, at, e, v);
    }
    int64:k = 0i64;
    while (k < 2i64) decreases 2i64 - k {
        int64:h = raw hex_value(raw cursor_peek(@p.c));
        if (h < 0i64) {
            pass raw escape_bad_digit(pat, p, PatternErrorKind.BadHexEscape, at);
        }
        discard(raw cursor_bump(@p.c));
        v = (v * 16i64) + h;
        k = k + 1i64;
    }
    e.named = true;
    e.byte = true;
    e.cp = v;
    pass NIL;
};

// `\u` or `\U` read, its `\` at `at`: exactly `n` hex digits, four or eight (§1) -- a codepoint, not
// a surrogate and not past U+10FFFF. Braces are `\x{…}`'s: `\u{41}` is a `{` where a digit is due.
func:unicode_escape = PatternError?(uint8[]:pat, Parser->:p, int64:at, Esc->:e, int64:n) never fails {
    int64:v = 0i64;
    int64:k = 0i64;
    while (k < n) decreases n - k {
        int64:h = raw hex_value(raw cursor_peek(@p.c));
        if (h < 0i64) {
            pass raw escape_bad_digit(pat, p, PatternErrorKind.BadUnicodeEscape, at);
        }
        discard(raw cursor_bump(@p.c));
        if (v <= CP_MAX) { v = (v * 16i64) + h; }
        k = k + 1i64;
    }
    pass raw escape_value(p, at, e, v);
};

// `\` read at `at`, and the byte after it not yet. If the escape names a codepoint -- `\a \t \n \v
// \f \r \e`, `\0`, `\x`, `\u`, `\U`, or `\` before ASCII that is neither a letter nor a digit
// (Y-2) -- it is read and `e` says what it names; any other escape is left unread, `e.named` false,
// for the caller. `\0` before a digit is `UnknownEscape` at the `\`, spanning the three bytes, its
// detail `0`: elsewhere it begins an octal escape, and nregex reads none (RX-204).
func:escape_cp = PatternError?(uint8[]:pat, Parser->:p, int64:at, Esc->:e) never fails {
    e.named = false;
    e.byte = false;
    e.cp = 0i64;
    int32:d = raw cursor_peek(@p.c);
    int64:c = raw control_cp(d);
    if (c >= 0i64) {
        discard(raw cursor_bump(@p.c));
        e.named = true;
        e.cp = c;
        pass NIL;
    }
    if (d == CH_0) {
        discard(raw cursor_bump(@p.c));
        if (raw is_digit(raw cursor_peek(@p.c))) {
            pass raw pattern_error(PatternErrorKind.UnknownEscape, at, 3i64, CH_0 =>! uint32);
        }
        e.named = true;
        pass NIL;
    }
    if (d == CH_LOWER_X) {
        discard(raw cursor_bump(@p.c));
        pass raw hex_escape(pat, p, at, e);
    }
    if ((d == CH_LOWER_U) || (d == CH_UPPER_U)) {
        discard(raw cursor_bump(@p.c));
        int64:n = 4i64;
        if (d == CH_UPPER_U) { n = 8i64; }
        pass raw unicode_escape(pat, p, at, e, n);
    }
    if (raw is_literal_escape(d)) {
        discard(raw cursor_bump(@p.c));
        e.named = true;
        e.cp = d => int64;
        pass NIL;
    }
    pass NIL;
};

// The `\` at `at` begins an escape no rule reads, in a class or out (Y-2, Y-40, Y-44): `\Q` and `\E`, the
// quotation `SYNTAX.md` §8 declines, are `UnsupportedQuoting`, spanning the two bytes, their detail the letter;
// any other is `UnknownEscape`, spanning the `\` and the codepoint after it, its detail that codepoint.
func:escape_refused = PatternError?(uint8[]:pat, int64:at) never fails {
    int32:d = pat[at + 1i64] => int32;
    if ((d == CH_UPPER_Q) || (d == CH_UPPER_E)) {
        pass raw pattern_error(PatternErrorKind.UnsupportedQuoting, at, 2i64, d =>! uint32);
    }
    pass raw pattern_error(PatternErrorKind.UnknownEscape, at, 1i64 + raw utf8_len(pat[at + 1i64] => int64),
                           raw decode_at(pat, at + 1i64) =>! uint32);
};

// `\` read at `at` outside a class, and `d`, the byte after it, unread: the escapes `SYNTAX.md` §8 declines
// that name a group or a position (Y-44) -- `\1` … `\9` and `\k`, which match again what a group captured,
// are `BackreferenceUnsupported`, and `\G` and `\Z`, anchors nregex does not keep, `UnsupportedAnchor`; each
// at the `\`, spanning it and `d`, its detail `d`. `NIL` for any other escape. A digit here is never `0`,
// which `escape_cp` has read. `\g` is Perl's and PCRE's backreference too, `\g1`, `\g{-1}`, `\g{name}` --
// but before `<` or `'` it is PCRE's subroutine call, `RecursionUnsupported`, spanning the three bytes, its
// detail the third (RX-210). And `\K`, Perl's and PCRE's reset of a match's start -- a lookbehind in effect --
// is `LookaroundUnsupported`, by the author's amendment of 2026-10-02 (RX-210).
func:declined_escape = PatternError?(Parser->:p, int64:at, int32:d) never fails {
    if (d == CH_LOWER_G) {
        discard(raw cursor_bump(@p.c));
        int32:n = raw cursor_peek(@p.c);
        if ((n == CH_LT) || (n == CH_QUOTE)) {
            pass raw pattern_error(PatternErrorKind.RecursionUnsupported, at, 3i64, n =>! uint32);
        }
    }
    if ((raw is_digit(d)) || (d == CH_LOWER_K) || (d == CH_LOWER_G)) {
        pass raw pattern_error(PatternErrorKind.BackreferenceUnsupported, at, 2i64, d =>! uint32);
    }
    if ((d == CH_UPPER_G) || (d == CH_UPPER_Z)) {
        pass raw pattern_error(PatternErrorKind.UnsupportedAnchor, at, 2i64, d =>! uint32);
    }
    if (d == CH_UPPER_K) {
        pass raw pattern_error(PatternErrorKind.LookaroundUnsupported, at, 2i64, d =>! uint32);
    }
    pass NIL;
};

// `\` read at `at`, outside a class. An escape naming a codepoint is a `Literal` spanning it (Y-2, §1's
// `Escape`); a Perl class or a property is a class, unresolved, here as in a class (Y-37); `\A` and `\z`
// are anchors 2 and 3, and `\b` and `\B` word boundaries 0 and 1 (§1's `Anchor`, Y-27); §8's escapes are
// each refused by its own kind (`declined_escape`, `escape_refused`; Y-44); and a `\` before any other
// letter or digit, or before a non-ASCII codepoint, is `UnknownEscape` (RX-204) -- and so is a `\` before
// `<` or `>` (RX-205).
func:escape = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, int64:at) never fails {
    int32:d = raw cursor_peek(@p.c);
    if (d == CURSOR_END) {
        pass raw pattern_error(PatternErrorKind.TrailingBackslash, at, 1i64, 0u32);
    }
    Esc:e = Esc{ named: false, byte: false, cp: 0i64 };
    PatternError?:bad = raw escape_cp(pat, p, at, @e);
    if (bad != NIL) { pass bad; }
    if (e.named) {
        PatternError?:wide = raw byte_mode(p, at, p.c.pos - at, e.cp, e.byte);
        if (wide != NIL) { pass wide; }
        drop literal_atom(out, p, e.cp, at, p.c.pos - at);
        pass NIL;
    }
    if (raw is_class_letter(d)) {
        PatternError?:bytes = raw byte_mode_property(p, at, d);
        if (bytes != NIL) { pass bytes; }
        discard(raw cursor_bump(@p.c));
        if ((d == CH_LOWER_P) || (d == CH_UPPER_P)) {
            PatternError?:prop = raw read_property(p, at);
            if (prop != NIL) { pass prop; }
        }
        drop atom_node(out, @p.f, raw escape_class_node(pat, p.f.flags, at, d, p.c.pos));
        pass NIL;
    }
    if ((d == CH_UPPER_A) || (d == CH_LOWER_Z)) {
        discard(raw cursor_bump(@p.c));
        int64:k = 2i64;
        if (d == CH_LOWER_Z) { k = 3i64; }
        drop atom(out, @p.f, AstKind.Anchor, k, at, 2i64);
        pass NIL;
    }
    if ((d == CH_LOWER_B) || (d == CH_UPPER_B)) {
        discard(raw cursor_bump(@p.c));
        int64:k = 0i64;
        if (d == CH_UPPER_B) { k = 1i64; }
        drop atom(out, @p.f, AstKind.WordBoundary, k, at, 2i64);
        pass NIL;
    }
    PatternError?:declined = raw declined_escape(p, at, d);
    if (declined != NIL) { pass declined; }
    pass raw escape_refused(pat, at);
};

// The flag `x` is in force (§4).
func:extended = bool(Parser->:p) never fails {
    pass (p.f.flags & AST_FLAG_X) != 0u32;
};

// `ExtendedAmbiguity` at the codepoint `cp`, written in `n` bytes at `at`: under `x` the engines read
// it two ways, so nregex reads it neither (Y-39, Y-42; RX-207).
func:ambiguous = PatternError?(int64:at, int64:n, int64:cp) never fails {
    pass raw pattern_error(PatternErrorKind.ExtendedAmbiguity, at, n, cp =>! uint32);
};

// Under `(?-u)` a literal is one byte (Y-13, Y-43): the codepoint `cp`, written in `n` bytes at `at`,
// is `ByteModeNonAscii` past ASCII, its detail the codepoint -- unless it was written `\x` and two hex
// digits, which name a byte (`hex2`). Under `u`, any codepoint (RX-208).
func:byte_mode = PatternError?(Parser->:p, int64:at, int64:n, int64:cp, bool:hex2) never fails {
    if ((p.f.flags & AST_FLAG_U) != 0u32) { pass NIL; }
    if (hex2 || (cp < 128i64)) { pass NIL; }
    pass raw pattern_error(PatternErrorKind.ByteModeNonAscii, at, n, cp =>! uint32);
};

// A `Literal` of `cp`, written in `n` bytes at `at`, as the frame's pending atom -- `AST_FLAG_BYTE`
// on it under `(?-u)`, where its `a` is a byte (Y-26, Y-43).
func:literal_atom = NIL(Ast->:out, Parser->:p, int64:cp, int64:at, int64:n) never fails {
    uint32:fl = p.f.flags;
    if ((fl & AST_FLAG_U) == 0u32) { fl = fl + AST_FLAG_BYTE; }
    drop commit(out, @p.f);
    p.f.pending = raw ast_push(out, raw node(AstKind.Literal, fl, cp, 0i64, 0i64, at, n));
    pass NIL;
};

// Under `(?-u)` a Unicode property names nothing a byte class can hold: `\p` or `\P` at `at` is
// `ByteModeNonAscii` there, spanning the two bytes, its detail the letter -- which no codepoint past
// ASCII is (RX-208).
func:byte_mode_property = PatternError?(Parser->:p, int64:at, int32:d) never fails {
    if ((p.f.flags & AST_FLAG_U) != 0u32) { pass NIL; }
    if ((d != CH_LOWER_P) && (d != CH_UPPER_P)) { pass NIL; }
    pass raw pattern_error(PatternErrorKind.ByteModeNonAscii, at, 2i64, d =>! uint32);
};

// Under `x`, a `#` just read outside a class: the comment runs through the next line feed, or to the
// pattern's end (§4).
func:skip_comment = NIL(Parser->:p) never fails {
    bool:more = true;
    while (more && !(raw cursor_at_end(@p.c))) decreases p.c.src.len - p.c.pos {
        more = (raw cursor_bump(@p.c)) != CH_LF;
    }
    pass NIL;
};

// A literal whose first byte `lead` was read at `at`: one codepoint, decoded -- unless it is white
// space past ASCII under `x`, which is `ExtendedAmbiguity` (Y-42), or past ASCII under `(?-u)`, which
// is `ByteModeNonAscii` (Y-43).
func:literal = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, int64:at, int32:lead) never fails {
    int64:n = raw utf8_len(lead => int64);
    int64:k = 1i64;
    while (k < n) decreases n - k {
        discard(raw cursor_bump(@p.c));
        k = k + 1i64;
    }
    int64:cp = raw decode_at(pat, at);
    if ((raw extended(p)) && (raw is_wide_space(cp))) { pass raw ambiguous(at, n, cp); }
    PatternError?:wide = raw byte_mode(p, at, n, cp, false);
    if (wide != NIL) { pass wide; }
    drop literal_atom(out, p, cp, at, n);
    pass NIL;
};

// ---- classes (Y-36 … Y-38) ------------------------------------------------------
//
// A CLASS IS READ BY ITS OWN `while`, ON ITS OWN EXPLICIT STACK. `[` outside a class
// hands the walk to `parse_class`, which reads to the `]` that closes it: a nested
// `[` saves the class being read on `p.classes` and starts the inner one, and its `]`
// takes the saved one back, the inner `Class` a member of it -- `p.stack`'s shape for
// groups, one level down. Nothing here calls `parse_run`, `open_group` or itself, and
// `check_no_recursion` says so (RX-192). Groups and classes nest at most
// `NREGEX_NEST_DEPTH` deep together, decided at the `(` or `[` that would go deeper
// (Y-35, RX-198).
//
// MEMBERS SIDE BY SIDE ARE A UNION, AND THE OPERATORS FOLD THE UNIONS LEFT TO RIGHT
// (Y-36). A frame holds the union being read and, once an operator has been read,
// everything before it folded into one node: the first union, then a `ClassOp` of that
// and the next, and so on -- so `[a--b&&c]` is `((a -- b) && c)`. Each union an
// operator takes is a `Class` node of its own; a class with no operator holds its
// members directly.

func:class_frame = ClassFrame(int64:open, uint32:neg, int64:upos) never fails {
    pass ClassFrame{ open: open, neg: neg, lead: false, expr: AST_NONE, op: CLASS_AND, op_at: open,
                     first: AST_NONE, last: AST_NONE, count: 0i64, upos: upos, uend: upos,
                     after: AFTER_START };
};

// Links member `n`, which starts at `at` and ends at `upto`, into the union; `after`
// says what the next `-` may do (Y-36).
func:class_add = NIL(Ast->:out, ClassFrame->:cf, int64:n, int64:at, int64:upto, int64:after) never fails {
    if (cf.last == AST_NONE) {
        cf.first = n;
        cf.upos = at;
    }
    else { drop link(out, cf.last, n); }
    cf.last = n;
    cf.count = cf.count + 1i64;
    cf.uend = upto;
    cf.after = after;
    pass NIL;
};

// A member that is one codepoint, `cp`, written in `len` bytes at `at`: a `ClassRange`
// from it to itself, which a `-` may yet widen (Y-27).
func:class_one = NIL(Ast->:out, ClassFrame->:cf, uint32:flags, int64:cp, int64:at, int64:len) never fails {
    int64:n = raw ast_push(out, raw node(AstKind.ClassRange, flags, cp, cp, 0i64, at, len));
    drop class_add(out, cf, n, at, at + len, AFTER_ONE);
    pass NIL;
};

// The `[` read at `open` begins a class: `^` negates it, and a `]` straight after
// either is its first member, after which a `-` is a member too (Y-36).
func:class_start = ClassFrame(Ast->:out, Parser->:p, int64:open) never fails {
    uint32:neg = 0u32;
    if (raw cursor_eat(@p.c, CH_CARET =>! uint8)) { neg = AST_FLAG_NEGATED; }
    ClassFrame:cf = raw class_frame(open, neg, p.c.pos);
    if (raw cursor_peek(@p.c) == CH_RBRACKET) {
        int64:at = p.c.pos;
        discard(raw cursor_bump(@p.c));
        drop class_one(out, @cf, p.f.flags, CH_RBRACKET => int64, at, 1i64);
        cf.lead = true;
        cf.after = AFTER_START;
    }
    pass cf;
};

// The union read so far as an operator's operand: a `Class` of its members, never
// negated (Y-27). At least one member is there: the caller has checked.
func:class_union = int64(Ast->:out, ClassFrame->:cf, uint32:flags) never fails {
    pass raw ast_push(out, raw node(AstKind.Class, flags, cf.first, cf.count, 0i64, cf.upos, cf.uend - cf.upos));
};

// `expr`, the operator after it and the union just read, folded into one `ClassOp`.
func:class_fold = int64(Ast->:out, ClassFrame->:cf, uint32:flags) never fails {
    int64:u = raw class_union(out, cf, flags);
    if (cf.expr == AST_NONE) { pass u; }
    AstNode:x = raw ast_get(<-out, cf.expr);
    pass raw ast_push(out, raw node(AstKind.ClassOp, flags, cf.expr, u, cf.op, x.pos, cf.uend - x.pos));
};

// An operator, `&&`, `--` or `~~`, its first byte `b` read at `at` and its second just
// eaten: the union before it is its left operand, so it must have a member
// (`ClassOpMismatch` otherwise, detail the operator's byte); then a new union starts.
func:class_op = PatternError?(Ast->:out, ClassFrame->:cf, uint32:flags, int64:at, int32:b) never fails {
    if (cf.count == 0i64) {
        pass raw pattern_error(PatternErrorKind.ClassOpMismatch, at, 2i64, b =>! uint32);
    }
    cf.expr = raw class_fold(out, cf, flags);
    cf.op = CLASS_AND;
    if (b == CH_MINUS) { cf.op = CLASS_DIFF; }
    if (b == CH_TILDE) { cf.op = CLASS_XOR; }
    cf.op_at = at;
    cf.first = AST_NONE;
    cf.last = AST_NONE;
    cf.count = 0i64;
    cf.upos = at + 2i64;
    cf.uend = at + 2i64;
    cf.after = AFTER_START;
    pass NIL;
};

// The class's `]` read, `upto` just past it: its node -- its members, or the operators
// folded with the last union -- negated if it began `[^` (Y-27). The last operator, if
// any, must have a member after it.
func:class_close = PatternError?(Ast->:out, ClassFrame->:cf, uint32:flags, int64:upto) never fails {
    if (cf.expr != AST_NONE) {
        if (cf.count == 0i64) {
            int32:b = CH_AMP;
            if (cf.op == CLASS_DIFF) { b = CH_MINUS; }
            if (cf.op == CLASS_XOR) { b = CH_TILDE; }
            pass raw pattern_error(PatternErrorKind.ClassOpMismatch, cf.op_at, 2i64, b =>! uint32);
        }
        cf.first = raw class_fold(out, cf, flags);
        cf.count = 1i64;
    }
    cf.expr = raw ast_push(out, raw node(AstKind.Class, flags + cf.neg, cf.first, cf.count, 0i64,
                                         cf.open, upto - cf.open));
    pass NIL;
};

// `\` read at `at` inside a class: an escape naming a codepoint is a member, which a `-` may make a
// range's first end (Y-36, RX-204); a Perl class or a property is a class member (Y-37); `\Q` and `\E` are
// `UnsupportedQuoting`, as outside a class (Y-44); every other escape is `UnknownEscape` -- `\b`, `\B`, `\A`
// and `\z` too, since a class holds codepoints and they name positions, `\<` and `\>` (RX-205), and the
// digits, `\k`, `\G` and `\Z`, which no engine reads in a class as a group or a position (Y-44).
func:class_escape = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, ClassFrame->:cf, int64:at) never fails {
    int32:d = raw cursor_peek(@p.c);
    if (d == CURSOR_END) {
        pass raw pattern_error(PatternErrorKind.TrailingBackslash, at, 1i64, 0u32);
    }
    Esc:e = Esc{ named: false, byte: false, cp: 0i64 };
    PatternError?:bad = raw escape_cp(pat, p, at, @e);
    if (bad != NIL) { pass bad; }
    if (e.named) {
        PatternError?:wide = raw byte_mode(p, at, p.c.pos - at, e.cp, e.byte);
        if (wide != NIL) { pass wide; }
        drop class_one(out, cf, p.f.flags, e.cp, at, p.c.pos - at);
        pass NIL;
    }
    if (raw is_class_letter(d)) {
        PatternError?:bytes = raw byte_mode_property(p, at, d);
        if (bytes != NIL) { pass bytes; }
        discard(raw cursor_bump(@p.c));
        if ((d == CH_LOWER_P) || (d == CH_UPPER_P)) {
            PatternError?:prop = raw read_property(p, at);
            if (prop != NIL) { pass prop; }
        }
        int64:n = raw ast_push(out, raw escape_class_node(pat, p.f.flags, at, d, p.c.pos));
        drop class_add(out, cf, n, at, p.c.pos, AFTER_CLASS);
        pass NIL;
    }
    pass raw escape_refused(pat, at);
};

// Does the pattern hold `want` at `off`, `len` bytes long?
func:holds = bool(uint8[]:pat, int64:off, int64:len, string:want) never fails {
    uint8[]:w = string_bytes(want);
    if (w.len != len) { pass false; }
    int64:k = 0i64;
    while (k < len) decreases len - k {
        if (pat[off + k] != w[k]) { pass false; }
        k = k + 1i64;
    }
    pass true;
};

// The place in `SYNTAX.md` §5.1's list of the POSIX name at `off`, `len` bytes long, or
// AST_NONE when it is none of them.
func:posix_index = int64(uint8[]:pat, int64:off, int64:len) never fails {
    int64:k = 0i64;
    while (k < POSIX_CLASS_NAMES) decreases POSIX_CLASS_NAMES - k {
        if (raw holds(pat, off, len, raw posix_class_name(k))) { pass k; }
        k = k + 1i64;
    }
    pass AST_NONE;
};

// `[:` read inside a class, its `[` at `at`: a POSIX class, `[:name:]` or `[:^name:]`,
// the name one of §5.1's (Y-38). Anything else is `UnknownPosixClass` at the `[`,
// spanning what was read, detail 0 -- never a nested class, since the cursor does not
// go back.
func:posix_class = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, ClassFrame->:cf, int64:at) never fails {
    uint32:bits = p.f.flags;
    if (raw cursor_eat(@p.c, CH_CARET =>! uint8)) { bits = bits + AST_FLAG_NEGATED; }
    int64:name = p.c.pos;
    while (raw is_lower(raw cursor_peek(@p.c))) decreases pat.len - p.c.pos {
        discard(raw cursor_bump(@p.c));
    }
    int64:len = p.c.pos - name;
    if (!(raw cursor_eat(@p.c, CH_COLON =>! uint8))) {
        pass raw pattern_error(PatternErrorKind.UnknownPosixClass, at, p.c.pos - at, 0u32);
    }
    if (!(raw cursor_eat(@p.c, CH_RBRACKET =>! uint8))) {
        pass raw pattern_error(PatternErrorKind.UnknownPosixClass, at, p.c.pos - at, 0u32);
    }
    int64:k = raw posix_index(pat, name, len);
    if (k == AST_NONE) {
        pass raw pattern_error(PatternErrorKind.UnknownPosixClass, at, p.c.pos - at, 0u32);
    }
    int64:n = raw ast_push(out, raw node(AstKind.PosixClass, bits, k, 0i64, 0i64, at, p.c.pos - at));
    drop class_add(out, cf, n, at, p.c.pos, AFTER_CLASS);
    pass NIL;
};

// The `-` just read joins the member before it -- one codepoint, the frame's last --
// to the one after it, which the caller has seen is there and is no `]` (Y-36): a
// codepoint or an escape naming one (RX-204), not below the first (`BadClassRange`, detail 0);
// a class there is `BadClassRange`, detail 1. Each spans from the range's first byte
// through the byte that made it bad.
func:class_range = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, ClassFrame->:cf) never fails {
    AstNode:lo = raw ast_get(<-out, cf.last);
    int64:at = p.c.pos;
    int32:b = raw cursor_peek(@p.c);
    int64:hi = 0i64;
    if (b == CH_LBRACKET) {
        discard(raw cursor_bump(@p.c));
        pass raw pattern_error(PatternErrorKind.BadClassRange, lo.pos, p.c.pos - lo.pos, 1u32);
    }
    if (b == CH_BACKSLASH) {
        discard(raw cursor_bump(@p.c));
        int32:d = raw cursor_peek(@p.c);
        if (d == CURSOR_END) {
            pass raw pattern_error(PatternErrorKind.TrailingBackslash, at, 1i64, 0u32);
        }
        if (raw is_class_letter(d)) {
            discard(raw cursor_bump(@p.c));
            pass raw pattern_error(PatternErrorKind.BadClassRange, lo.pos, p.c.pos - lo.pos, 1u32);
        }
        Esc:e = Esc{ named: false, byte: false, cp: 0i64 };
        PatternError?:bad = raw escape_cp(pat, p, at, @e);
        if (bad != NIL) { pass bad; }
        if (!e.named) { pass raw escape_refused(pat, at); }
        PatternError?:wide = raw byte_mode(p, at, p.c.pos - at, e.cp, e.byte);
        if (wide != NIL) { pass wide; }
        hi = e.cp;
    }
    else {
        int64:n = raw utf8_len(b => int64);
        int64:k = 0i64;
        while (k < n) decreases n - k {
            discard(raw cursor_bump(@p.c));
            k = k + 1i64;
        }
        hi = raw decode_at(pat, at);
        if ((raw extended(p)) && ((raw is_space(b)) || (b == CH_HASH) || (raw is_wide_space(hi)))) {
            pass raw ambiguous(at, n, hi);
        }
        PatternError?:wide = raw byte_mode(p, at, n, hi, false);
        if (wide != NIL) { pass wide; }
    }
    if (hi < lo.a) {
        pass raw pattern_error(PatternErrorKind.BadClassRange, lo.pos, p.c.pos - lo.pos, 0u32);
    }
    lo.b = hi;
    lo.len = p.c.pos - lo.pos;
    drop ast_set(out, cf.last, lo);
    cf.uend = p.c.pos;
    cf.after = AFTER_START;
    pass NIL;
};

// An outermost class written in a POSIX class's own form -- every member one codepoint
// written as itself, the first and the last `:` and another not, as `[:alpha:]` and
// `[^:alpha:]` -- is a class of those codepoints, and almost never what was meant:
// `UnknownPosixClass` at its `[`, spanning it, its detail the name's place in §5.1's list
// plus one when the bytes between the colons, less a leading `^`, are one of its names,
// else 0 (Y-38, RX-200). A member is written as itself when its node spans exactly the
// UTF-8 sequence its first byte begins: a range, an escape, a nested class, a POSIX or a
// Perl class, a property and the operators' fold each span more, and a class holding one
// is a class written as one -- `[:foo\:]`, `[:a-z:]` and `[:[:digit:]:]` are classes.
func:posix_alone = PatternError?(uint8[]:pat, Ast->:out, ClassFrame:cf, int64:upto) never fails {
    int64:lo = cf.open + 1i64;
    if (cf.neg != 0u32) { lo = lo + 1i64; }
    int64:hi = upto - 2i64;
    if (((pat[lo] => int32) != CH_COLON) || ((pat[hi] => int32) != CH_COLON)) { pass NIL; }
    bool:other = false;
    int64:m = cf.first;
    int64:j = 0i64;
    while (j < cf.count) decreases cf.count - j {
        AstNode:x = raw ast_get(<-out, m);
        if (x.len != raw utf8_len(pat[x.pos] => int64)) { pass NIL; }
        if ((pat[x.pos] => int32) != CH_COLON) { other = true; }
        m = x.next;
        j = j + 1i64;
    }
    if (!other) { pass NIL; }
    int64:name = lo + 1i64;
    if ((pat[name] => int32) == CH_CARET) { name = name + 1i64; }
    int64:k = raw posix_index(pat, name, hi - name);
    uint32:detail = 0u32;
    if (k != AST_NONE) { detail = (k + 1i64) =>! uint32; }
    pass raw pattern_error(PatternErrorKind.UnknownPosixClass, cf.open, upto - cf.open, detail);
};

// `[` read at `open`, outside any class: the class, every class nested in it and
// every member, in one `while` (Y-36); its node becomes the frame's pending atom. A
// class needs no `(` and no `)`, so nothing in here meets a group.
func:parse_class = PatternError?(uint8[]:pat, Ast->:out, Parser->:p, int64:open) never fails {
    if (p.stack.count >= NREGEX_NEST_DEPTH) {
        pass raw pattern_error(PatternErrorKind.NestTooDeep, open, 1i64, NREGEX_NEST_DEPTH =>! uint32);
    }
    ClassFrame:cf = raw class_start(out, p, open);
    while (!(raw cursor_at_end(@p.c))) decreases pat.len - p.c.pos {
        int64:at = p.c.pos;
        int32:b = raw cursor_bump(@p.c);
        PatternError?:e = NIL;
        if ((raw extended(p)) && ((raw is_space(b)) || (b == CH_HASH))) {
            e = raw ambiguous(at, 1i64, b => int64);
        }
        else if (b == CH_RBRACKET) {
            e = raw class_close(out, @cf, p.f.flags, p.c.pos);
            if (e != NIL) { pass e; }
            if (p.classes.count == 0i64) {
                PatternError?:alone = raw posix_alone(pat, out, cf, p.c.pos);
                if (alone != NIL) { pass alone; }
                drop commit(out, @p.f);
                p.f.pending = cf.expr;
                pass NIL;
            }
            int64:inner = cf.expr;
            int64:inner_at = cf.open;
            cf = raw vec_pop(@p.classes);
            drop class_add(out, @cf, inner, inner_at, p.c.pos, AFTER_CLASS);
        }
        else if (b == CH_LBRACKET) {
            if (raw cursor_eat(@p.c, CH_COLON =>! uint8)) { e = raw posix_class(pat, out, p, @cf, at); }
            else if ((p.stack.count + p.classes.count + 1i64) >= NREGEX_NEST_DEPTH) {
                e = raw pattern_error(PatternErrorKind.NestTooDeep, at, 1i64, NREGEX_NEST_DEPTH =>! uint32);
            }
            else {
                drop vec_push(@p.classes, cf);
                cf = raw class_start(out, p, at);
            }
        }
        else if (b == CH_BACKSLASH) { e = raw class_escape(pat, out, p, @cf, at); }
        else if (((b == CH_AMP) || (b == CH_TILDE) || (b == CH_MINUS)) && (raw cursor_eat(@p.c, b =>! uint8))) {
            e = raw class_op(out, @cf, p.f.flags, at, b);
        }
        else if ((b == CH_MINUS) && (cf.after != AFTER_START) && ((raw cursor_peek(@p.c)) != CH_RBRACKET)
                 && ((raw cursor_peek(@p.c)) != CURSOR_END)) {
            if (cf.after == AFTER_CLASS) {
                AstNode:x = raw ast_get(<-out, cf.last);
                e = raw pattern_error(PatternErrorKind.BadClassRange, x.pos, p.c.pos - x.pos, 1u32);
            }
            else { e = raw class_range(pat, out, p, @cf); }
        }
        else {
            int64:n = raw utf8_len(b => int64);
            int64:k = 1i64;
            while (k < n) decreases n - k {
                discard(raw cursor_bump(@p.c));
                k = k + 1i64;
            }
            int64:cp = raw decode_at(pat, at);
            if ((raw extended(p)) && (raw is_wide_space(cp))) { e = raw ambiguous(at, n, cp); }
            else { e = raw byte_mode(p, at, n, cp, false); }
            if (e == NIL) { drop class_one(out, @cf, p.f.flags, cp, at, n); }
        }
        if (e != NIL) { pass e; }
    }
    uint32:why = 0u32;
    if (cf.lead) { why = CH_RBRACKET =>! uint32; }
    pass raw pattern_error(PatternErrorKind.UnclosedClass, cf.open, 1i64, why);
};

// ---- the walk --------------------------------------------------------------

func:parse_run = PatternError?(uint8[]:pat, Ast->:out, Parser->:p) never fails {
    while (!(raw cursor_at_end(@p.c))) decreases pat.len - p.c.pos {
        int64:at = p.c.pos;
        int32:b = raw cursor_bump(@p.c);
        PatternError?:e = NIL;
        if ((raw extended(p)) && ((raw is_space(b)) || (b == CH_HASH))) {
            // under `x`, between two constructs: white space, skipped, or a comment (Y-42)
            if (b == CH_HASH) { drop skip_comment(p); }
        }
        else if (b == CH_PIPE) {
            drop close_alt(out, @p.f, at);
            p.f.cat_pos = p.c.pos;
        }
        else if (b == CH_LPAREN) { e = raw open_group(pat, out, p, at); }
        else if (b == CH_RPAREN) { e = raw close_group(out, p, at); }
        else if ((b == CH_STAR) || (b == CH_PLUS) || (b == CH_QUESTION) || (b == CH_LBRACE)) {
            e = raw quantify(out, p, at, b);
        }
        else if (b == CH_DOT) { drop atom(out, @p.f, AstKind.Dot, 0i64, at, 1i64); }
        else if (b == CH_CARET) { drop atom(out, @p.f, AstKind.Anchor, 0i64, at, 1i64); }
        else if (b == CH_DOLLAR) { drop atom(out, @p.f, AstKind.Anchor, 1i64, at, 1i64); }
        else if (b == CH_BACKSLASH) { e = raw escape(pat, out, p, at); }
        else if (b == CH_LBRACKET) { e = raw parse_class(pat, out, p, at); }
        else { e = raw literal(pat, out, p, at, b); }
        if (e != NIL) { pass e; }
    }
    if (p.stack.count > 0i64) {
        pass raw pattern_error(PatternErrorKind.UnclosedGroup, p.f.open, 1i64,
                               p.stack.count =>! uint32);
    }
    int64:root = raw close_body(out, @p.f, pat.len);
    drop ast_set_root(out, root);
    pass NIL;
};

// obligation: never fails
//
// THE PARSE (Y-28 … Y-33). Appends the pattern's nodes to `out` and sets its
// root, answering `NIL`; or answers the first `PatternError` and leaves `out`'s
// root as it was -- its nodes are then partial, and the caller frees them. Pass
// an `Ast` fresh from `ast_init`; the pattern's bytes must outlive the AST,
// which holds names by offset (Y-26).
pub func:parse_pattern = PatternError?(uint8[]:pat, Ast->:out) never fails {
    PatternError?:long = raw parse_check_length(pat);
    if (long != NIL) { pass long; }
    PatternError?:bad = raw parse_check_encoding(pat);
    if (bad != NIL) { pass bad; }
    Parser:p = Parser{ c: raw cursor_init(pat), f: raw frame(AST_NONE, 0i64, 0i64, 0i64, AST_FLAG_U),
                       next_cap: 1i64, stack: raw vec_init::<Frame>(8i64),
                       names: raw vec_init::<GroupName>(4i64),
                       classes: raw vec_init::<ClassFrame>(4i64) };
    PatternError?:e = raw parse_run(pat, out, @p);
    drop vec_free(@p.stack);
    drop vec_free(@p.names);
    drop vec_free(@p.classes);
    pass e;
};

// ---- the inverse: text to a pattern (`SYNTAX.md` Y-24, Y-45; RX-211) ---------------------------

// A byte `regex_escape` writes a `\` before: Y-28's metacharacters and their closers, `\ . + * ? ( ) | [
// ] { } ^ $`; `&`, `-` and `~`, which make a class's operators and ranges; `#`; and the six white-space
// bytes `x` skips (Y-42) -- every byte that means something somewhere in a pattern, in a class or out, under
// `x` or not. Not `<` or `>`: a `\` before either is refused (RX-205), and each is itself everywhere.
// *(2026-10-08, cycle 0.1.6a -- RX-214: and `:`, which straight after a `[` begins a POSIX class (Y-38): a text
// that began `:alpha:`, put straight after a nested class's `[`, was read as the class `[:alpha:]` with no
// error, and in the outermost class it was refused (RX-200). `\:` is `:` everywhere (Y-2).)*
func:is_escaped = bool(int32:b) never fails {
    if ((b == CH_BACKSLASH) || (b == CH_DOT) || (b == CH_PLUS) || (b == CH_STAR) || (b == CH_QUESTION)) { pass true; }
    if ((b == CH_LPAREN) || (b == CH_RPAREN) || (b == CH_PIPE) || (b == CH_LBRACKET) || (b == CH_RBRACKET)) { pass true; }
    if ((b == CH_LBRACE) || (b == CH_RBRACE) || (b == CH_CARET) || (b == CH_DOLLAR) || (b == CH_HASH)) { pass true; }
    if ((b == CH_AMP) || (b == CH_MINUS) || (b == CH_TILDE) || (b == CH_COLON)) { pass true; }
    pass raw is_space(b);
};

// obligation: never fails
//
// A pattern that matches exactly `text` (Y-24, Y-45): each of its codepoints a `Literal` of itself, or in
// a class a member, under `x` or not. A `\` goes before each byte `is_escaped` names; each white-space
// codepoint past ASCII that `x` refuses (Y-42) is written `\x{…}`; every other byte is copied. A text that
// is not well-formed UTF-8 is copied with only its ASCII escaped, so its pattern is refused
// `InvalidPatternEncoding` where the text breaks (Y-28), never read as a codepoint the text does not hold.
pub func:regex_escape = string(string:text) never fails {
    uint8[]:t = string_bytes(text);
    PatternError?:bad = raw parse_check_encoding(t);
    Bytes:b = raw bytes_init(t.len + 16i64);
    int64:i = 0i64;
    while (i < t.len) decreases t.len - i {
        int32:c = t[i] => int32;
        int64:n = 1i64;
        if (raw is_escaped(c)) {
            drop bytes_push(@b, CH_BACKSLASH =>! uint8);
            drop bytes_push(@b, t[i]);
        }
        else if (((c => int64) >= U8_CONT_LO) && (bad == NIL)) {
            n = raw utf8_len(c => int64);
            int64:cp = raw decode_at(t, i);
            if (raw is_wide_space(cp)) {
                drop bytes_extend_str(@b, "\\x{");
                drop hex(@b, cp, 1i64);
                drop bytes_push(@b, CH_RBRACE =>! uint8);
            }
            else { drop bytes_extend(@b, t[i...i + n]); }
        }
        else { drop bytes_push(@b, t[i]); }
        i = i + n;
    }
    pass raw bytes_copy_string(@b);
};
