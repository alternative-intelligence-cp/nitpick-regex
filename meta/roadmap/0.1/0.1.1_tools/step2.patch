+    pass NIL;
+};
+
+// ---- the walk --------------------------------------------------------------
+
+func:parse_run = PatternError?(uint8[]:pat, Ast->:out, Parser->:p) never fails {
+    while (!(raw cursor_at_end(@p.c))) decreases pat.len - p.c.pos {
+        int64:at = p.c.pos;
+        int32:b = raw cursor_bump(@p.c);
+        PatternError?:e = NIL;
+        if (b == CH_PIPE) {
+            drop close_alt(out, @p.f, at);
+            p.f.cat_pos = p.c.pos;
+        }
+        else if (b == CH_LPAREN) { e = raw open_group(pat, out, p, at); }
+        else if (b == CH_RPAREN) { e = raw close_group(out, p, at); }
+        else if ((b == CH_STAR) || (b == CH_PLUS) || (b == CH_QUESTION) || (b == CH_LBRACE)) {
+            e = raw quantify(out, p, at, b);
+        }
+        else if (b == CH_DOT) { drop atom(out, @p.f, AstKind.Dot, 0i64, at, 1i64); }
+        else if (b == CH_CARET) { drop atom(out, @p.f, AstKind.Anchor, 0i64, at, 1i64); }
+        else if (b == CH_DOLLAR) { drop atom(out, @p.f, AstKind.Anchor, 1i64, at, 1i64); }
+        else if (b == CH_BACKSLASH) { e = raw escape(pat, out, p, at); }
+        else if (b == CH_LBRACKET) {
+            // cycle 0.1.3's: until then, provisionally unclosed (Y-31)
+            e = raw pattern_error(PatternErrorKind.UnclosedClass, at, 1i64, 0u32);
+        }
+        else { drop literal(pat, out, p, at, b); }
+        if (e != NIL) { pass e; }
+    }
+    if (p.stack.count > 0i64) {
+        pass raw pattern_error(PatternErrorKind.UnclosedGroup, p.f.open, 1i64,
+                               p.stack.count =>! uint32);
+    }
+    int64:root = raw close_body(out, @p.f, pat.len);
+    drop ast_set_root(out, root);
+    pass NIL;
+};
+
+// obligation: never fails
+//
+// THE PARSE (Y-28 … Y-33). Appends the pattern's nodes to `out` and sets its
+// root, answering `NIL`; or answers the first `PatternError` and leaves `out`'s
+// root as it was -- its nodes are then partial, and the caller frees them. Pass
+// an `Ast` fresh from `ast_init`; the pattern's bytes must outlive the AST,
+// which holds names by offset (Y-26).
+pub func:parse_pattern = PatternError?(uint8[]:pat, Ast->:out) never fails {
+    PatternError?:long = raw parse_check_length(pat);
+    if (long != NIL) { pass long; }
+    PatternError?:bad = raw parse_check_encoding(pat);
+    if (bad != NIL) { pass bad; }
+    Parser:p = Parser{ c: raw cursor_init(pat), f: raw frame(AST_NONE, 0i64, 0i64, 0i64, AST_FLAG_U),
+                       next_cap: 1i64, stack: raw vec_init::<Frame>(8i64),
+                       names: raw vec_init::<GroupName>(4i64) };
+    PatternError?:e = raw parse_run(pat, out, @p);
+    drop vec_free(@p.stack);
+    drop vec_free(@p.names);
+    pass e;
+};
