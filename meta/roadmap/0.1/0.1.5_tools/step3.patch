@@ -980,9 +981,18 @@ func:escape_refused = PatternError?(uint8[]:pat, int64:at) never fails {
 // that name a group or a position (Y-44) -- `\1` … `\9` and `\k`, which match again what a group captured,
 // are `BackreferenceUnsupported`, and `\G` and `\Z`, anchors nregex does not keep, `UnsupportedAnchor`; each
 // at the `\`, spanning it and `d`, its detail `d`. `NIL` for any other escape. A digit here is never `0`,
-// which `escape_cp` has read.
-func:declined_escape = PatternError?(int64:at, int32:d) never fails {
