+// expect-exit: 0
+//
+// THE REPETITION PRODUCT, REFUSED ON THE WAY DOWN AT THE QUANTIFIER THAT TAKES IT PAST THE BOUND.
+// Cycle 0.2.2, RX-232 and RX-233; `HIR.md` H-8, `SAFETY.md` S-13 (RX-015).
+//
+// WHAT IT PINS. Each case parses a pattern through `syntax.npk` and builds it through `hir.npk`.
+// `refused` asks the build to answer the `Repeat` whose quantifier begins at the byte named, the
+// root unset, and `hir_build_refusal` to make that `RepeatProductTooLarge` there, spanning the
+// quantifier, `NREGEX_REPEAT_PRODUCT` its detail; `built` asks the build to answer HIR_NONE, the
+// root set, no refusal, and the dump the text named -- every `Repeat` as written, nothing expanded
+// (H-7); `stopped` asks it to stop at the node named, which no refusal is.
+//
+// THE CASES. 1 … 3, the cycle README's pattern, `((a{1000}){1000}){1000}`: refused at its second
+// `{1000}`, byte 10, where the product first passes 100 000 -- second in the order written and on
+// the way down alike (RX-233) -- and its sentence to the letter (`SYNTAX.md` Y-34). 10 … 13, the
+// bound's edges: a product exactly on it built, one past it refused. 20 … 25, each form's factor:
+// `*`, `+` and `?` count 1, `{n,}` its minimum, `{n,m}` its maximum, `{0}` 1, and a lazy
+// quantifier's span holds its `?`. 30 … 33, the order: the first crossing in the walk, a list's
+// every member under the product around it, an alternative too, and the outer factor met first,
+// so `(a{1000}b{1000}){1000}` is refused at its first `{1000}`, not its last; the product is a
+// path's, so two nests each on the bound are built. 40, 41: under `x`, white space and a comment
+// between an atom and its quantifier, the offset still the `{`. 50 … 52, a refusal and a stop: the
+// first the walk meets is the answer, and a stop is no refusal. 60: 250 groups deep, each `{2}`,
+// refused at the seventeenth factor from the outside, 2^17. 70: an AST whose bound no pattern
+// can write -- 2^62, set by hand under a `{9}` -- refused with no multiply, so nothing overflows.
+// A case that differs exits with its number; the program exits 0 only after every `hir_free` and
+// `ast_free`, and D-151 traps a `wild` block still live at exit (96).
+mod:hir_build_product;
+
+use "../../src/core/core.npk".*;
+use "../../src/syntax/syntax.npk".*;
+use "../../src/hir/hir.npk".*;
+
+// Whether `b` holds exactly the bytes of `want`.
+func:same = bool(Bytes->:b, fixed uint8[]:want) never fails {
+    if ((raw bytes_len(b)) != want.len) { pass false; }
+    int64:i = 0i64;
+    while (i < want.len) decreases want.len - i {
+        if ((raw bytes_get(b, i)) != want[i]) { pass false; }
+        i = i + 1i64;
+    }
+    pass true;
+};
+
+// Whether the string `got` is `want`, byte for byte.
+func:same_text = bool(string:got, string:want) never fails {
+    fixed uint8[]:g = string_bytes(got);
+    fixed uint8[]:w = string_bytes(want);
+    if (g.len != w.len) { pass false; }
+    int64:i = 0i64;
+    while (i < w.len) decreases w.len - i {
+        if (g[i] != w[i]) { pass false; }
+        i = i + 1i64;
+    }
+    pass true;
