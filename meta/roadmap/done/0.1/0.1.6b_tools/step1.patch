+            fl.append(f"{where}: Y-25's table lists `{kind}` twice. One row per kind (RX-219).")
+            continue
+        listed[kind] = cell
+        if kind not in kinds:
+            fl.append(f"{where}: Y-25's table lists `{kind}`, which `PatternErrorKind` does not declare. Strike the "
