+use "../../src/core/core.npk".*;
+use "../../src/syntax/syntax.npk".*;
+
+func:refused = bool(string:pattern, PatternErrorKind:kind, int64:off, int64:len, uint32:detail) never fails {
+    Ast:t = raw ast_init(8i64);
+    PatternError?:r = raw parse_pattern(string_bytes(pattern), @t);
+    drop ast_free(@t);
+    if (r == NIL) { pass false; }
+    PatternError:e = r ?? raw pattern_error(PatternErrorKind.PatternTooLong, 0i64, 0i64, 0u32);
+    if (e.kind != kind)     { pass false; }
+    if (e.offset != off)    { pass false; }
+    if (e.span_len != len)  { pass false; }
+    pass e.detail == detail;
+};
+
+func:run = int32() never fails {
+    // unclosed: at the innermost open `[`; detail `]` when its first member is a `]`
+    if (!(raw refused("[", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))              { pass 1i32; }
+    if (!(raw refused("[a", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))             { pass 2i32; }
+    if (!(raw refused("[]", PatternErrorKind.UnclosedClass, 0i64, 1i64, 93u32)))            { pass 3i32; }
+    if (!(raw refused("[^]", PatternErrorKind.UnclosedClass, 0i64, 1i64, 93u32)))           { pass 4i32; }
+    if (!(raw refused("[^]a", PatternErrorKind.UnclosedClass, 0i64, 1i64, 93u32)))          { pass 5i32; }
+    if (!(raw refused("[a[b]", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))          { pass 6i32; }
+    if (!(raw refused("[a[b", PatternErrorKind.UnclosedClass, 2i64, 1i64, 0u32)))           { pass 7i32; }
+    if (!(raw refused("a[b-", PatternErrorKind.UnclosedClass, 1i64, 1i64, 0u32)))           { pass 8i32; }
+    if (!(raw refused("[[:alpha:]", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))     { pass 9i32; }
+    if (!(raw refused("[\\]", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))           { pass 10i32; }
+    if (!(raw refused("[a&&", PatternErrorKind.UnclosedClass, 0i64, 1i64, 0u32)))           { pass 11i32; }
