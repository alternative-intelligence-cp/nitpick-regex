diff --git a/tests/unit/hir_unit.npk b/tests/unit/hir_unit.npk
new file mode 100644
index 0000000000000000000000000000000000000000..b26cd403bdd5cf162fad1a1e2e3eff2f85d51b2b
--- /dev/null
+++ b/tests/unit/hir_unit.npk
@@ -0,0 +1,179 @@
+// expect-exit: 0
+//
+// THE HIR ARENA: A HUNDRED NODES IN, EVERY FIELD OUT, THROUGH THE LAYER ENTRY -- ITS
+// RANGES, ITS GROUPS AND THEIR NAMES -- AND FREED, SO A LEAKED `wild` BLOCK TRAPS.
+// Cycle 0.2.0, RX-223 and RX-224; `HIR.md` H-2 … H-4.
+//
+// WHAT IT PINS. `ordinal` is an EXHAUSTIVE `pick` over `HirKind`, no `(*)`, one arm per
+// kind in H-4's order: a kind dropped, added or moved is a red run. A hundred nodes go in
+// from capacity 1, so the arena grows under them, each kind in turn and every field
+// distinct from its neighbours' (12: `hir_push` answers the new index); each comes back
+// through `hir_get` field for field (20 to 25). `hir_set` rewrites one node and leaves its
+// neighbour alone (30, 31); `hir_set_root` sets the sealed root (32); `hir_free` resets it
+// (33). Three ranges in and out (40 to 43). A fresh arena holds group 0, the whole match,
+// with no name (50, 51); three groups added answer 1, 2 and 3 (52) and hold their names'
+// places in `Hir.names` (53 to 55), and `hir_put_name` copies each name out, nothing for
+// the unnamed one (56 to 58). The constants are RX-223's values (60 to 68), and a `GroupInfo`
+// is 16 bytes (69). The program exits
+// 0 only after `hir_free`, and D-151 traps a `wild` block still live at exit -- so a
+// `hir_free` that freed nothing, or a missing one, is red (96).
+mod:hir_unit;
+
+use "../../src/core/core.npk".*;
+use "../../src/hir/hir.npk".*;
+
+func:ordinal = int64(HirKind:k) never fails {
+    int64:n = -1i64;
+    pick (k) {
+        (HirKind.Empty) { n = 0i64; },
+        (HirKind.Literal) { n = 1i64; },
+        (HirKind.Class) { n = 2i64; },
+        (HirKind.Concat) { n = 3i64; },
+        (HirKind.Alternate) { n = 4i64; },
+        (HirKind.Repeat) { n = 5i64; },
+        (HirKind.Group) { n = 6i64; },
+        (HirKind.Anchor) { n = 7i64; },
+        (HirKind.WordBoundary) { n = 8i64; }
+    }
+    pass n;
+};
+
+// Whether `b` holds exactly the bytes of `want`.
+func:same = bool(Bytes->:b, string:want) never fails {
+    uint8[]:w = string_bytes(want);
+    if ((raw bytes_len(b)) != w.len) { pass false; }
+    int64:i = 0i64;
+    while (i < w.len) decreases w.len - i {
+        if ((raw bytes_get(b, i)) != w[i]) { pass false; }
+        i = i + 1i64;
+    }
+    pass true;
+};
+
+func:nodes = int32() never fails {
+    Hir:h = raw hir_init(1i64);
+    if ((raw hir_len(h)) != 0i64)   { pass 10i32; }
+    if (h.root != HIR_NONE)         { pass 11i32; }
+    int64:i = 0i64;
+    int64:kk = 0i64;
+    while (i < 100i64) decreases 100i64 - i {
+        HirNode:n = HirNode{ kind: (kk =>! int32) =>! HirKind, flags: (i =>! uint32) + 7u32,
+                             a: i * 7i64, b: i * 11i64, c: 0i64 - i, next: i - 1i64 };
+        int64:at = raw hir_push(@h, n);
+        if (at != i) { pass 12i32; }
+        i = i + 1i64;
+        kk = kk + 1i64;
+        if (kk == 9i64) { kk = 0i64; }
+    }
+    if ((raw hir_len(h)) != 100i64) { pass 13i32; }
+    i = 0i64;
+    kk = 0i64;
+    while (i < 100i64) decreases 100i64 - i {
+        HirNode:g = raw hir_get(h, i);
+        if ((raw ordinal(g.kind)) != kk)         { pass 20i32; }
+        if (g.flags != (i =>! uint32) + 7u32)    { pass 21i32; }
+        if (g.a != i * 7i64)                     { pass 22i32; }
+        if (g.b != i * 11i64)                    { pass 23i32; }
+        if (g.c != 0i64 - i)                     { pass 24i32; }
+        if (g.next != i - 1i64)                  { pass 25i32; }
+        i = i + 1i64;
+        kk = kk + 1i64;
+        if (kk == 9i64) { kk = 0i64; }
+    }
+    HirNode:m = raw hir_get(h, 50i64);
+    m.next = 99i64;
+    drop hir_set(@h, 50i64, m);
+    HirNode:m2 = raw hir_get(h, 50i64);
+    if (m2.next != 99i64)                        { pass 30i32; }
+    HirNode:m3 = raw hir_get(h, 51i64);
+    if (m3.next != 50i64)                        { pass 31i32; }
+    drop hir_set_root(@h, 99i64);
+    if (h.root != 99i64)                         { pass 32i32; }
+    drop hir_free(@h);
+    if (h.root != HIR_NONE)                      { pass 33i32; }
+    pass 0i32;
