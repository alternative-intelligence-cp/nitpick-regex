diff --git a/tests/unit/hir_normalise_gate.npk b/tests/unit/hir_normalise_gate.npk
new file mode 100644
index 0000000000000000000000000000000000000000..1afa3eeacf9eb4f69ffa45fa69a44706a9eb7418
--- /dev/null
+++ b/tests/unit/hir_normalise_gate.npk
@@ -0,0 +1,644 @@
+// expect-exit: 0
+//
+// THE GATE: A GENERATED CORPUS OF PATTERN PAIRS, STRUCTURALLY EQUAL AND TEXTUALLY DIFFERENT, WHOSE
+// DUMPS ARE ONE TEXT BYTE FOR BYTE -- AND NEAR MISSES WHOSE DUMPS ARE NOT. Cycle 0.2.3, RX-235 …
+// RX-237; `HIR.md` H-13 and H-14, and the cycle README's Gate.
+//
+// WHAT IT GENERATES. TREES trees, a fixed seed, each a random tree ALREADY IN NORMAL FORM, as RX-235
+// defines it -- no `Concat` piece a `Concat` or an `Empty`, no alternative an `Alternate`, every class
+// of two members or more, in literals from `a` … `l` and `é`, classes over `a` … `l`, groups, named
+// or not, repetitions whose factors multiply to at most 81, anchors and boundaries, and a literal in
+// byte mode -- four deep at most. Each tree is written three ways: as its EXPECTED DUMP, H-15's text,
+// reckoned here from the tree; as a PLAIN pattern, one spelling for each node; and as a NOISY one, the
+// same tree with RX-235's identities applied to its text -- a run of pieces or of alternatives in a
+// `(?:…)`, a `(?:)` among the pieces, a literal as a class or an escape, a class's members split,
+// overlapped, doubled and reordered, a quantifier respelt, an anchor's other name. Each is parsed,
+// built and normalised, and its dump must be the expected text, byte for byte (11, 12): so the two
+// patterns of a pair -- textually different (13) -- produce one dump. A pair whose BUILT dumps differ
+// is one only normalisation could join; there must be many (16).
+//
+// AND THE OTHER HALF. Each tree is also mutated once outside the identities -- two alternatives
+// swapped, a literal's byte bit flipped, an `Empty` alternative dropped, a repetition's laziness
+// flipped -- and its normal dump must differ from the tree's (14) and be its own expected text (15):
+// a normaliser that reordered, merged a byte into a codepoint, or dropped what is not concatenation's
+// identity, joins what this half keeps apart. And FLOORS on every kind of noise and mutation, so the
+// pass cannot be green by looking nowhere (17).
+//
+// THE GENERATOR RECURSES, and so do its writers: their depth is the generator's own bound, four, not
+// an input's (`SAFETY.md` S-18), and `check_no_recursion` reads `src/`, not `tests/` (RX-192). A case
+// that differs exits with its number; the program exits 0 only after every `hir_free` and `ast_free`.
+mod:hir_normalise_gate;
+
+use "../../src/core/core.npk".*;
+use "../../src/syntax/syntax.npk".*;
+use "../../src/hir/hir.npk".*;
+
+fixed int64:TREES = 3000i64;
+fixed int64:DEPTH = 4i64;
+fixed int64:PAIRS_FLOOR = 3000i64;       // pairs whose two patterns differ as text: every one
+fixed int64:JOINED_FLOOR = 1500i64;      // pairs whose BUILT dumps differ: only normalisation joins them
+fixed int64:NOISE_FLOOR = 500i64;        // each kind of noise applied at least this often
+fixed int64:MUTANT_FLOOR = 100i64;       // each kind of mutation applied at least this often
+
+// The kinds of node a tree holds.
+fixed int64:G_LIT = 0i64;      // `val` the letter, 0 … 11 for `a` … `l`, 12 for `é`; `val2` 1 in byte mode
+fixed int64:G_CLS = 1i64;      // `val` the members over `a` … `l`, a mask, two at least
+fixed int64:G_CAT = 2i64;
+fixed int64:G_ALT = 3i64;
+fixed int64:G_REP = 4i64;      // `val` the minimum, `val2` the maximum or -1, `lazy` 1 when lazy
+fixed int64:G_GRP = 5i64;      // `val` 1 when named
+fixed int64:G_ANC = 6i64;      // `val` 0 `^`, 1 `$`
+fixed int64:G_WB = 7i64;       // `val` 0 `\b`, 1 `\B`
+fixed int64:G_EMPTY = 8i64;
+
+// Where a node stands, which decides what it may be (RX-235's normal form) and how it is written.
+fixed int64:AT_ANY = 0i64;     // the root, a group's body, inside a `(?:…)`: anything
+fixed int64:AT_PIECE = 1i64;   // a piece of a `Concat`: no `Concat`, no `Empty`
+fixed int64:AT_ALT = 2i64;     // an alternative: no `Alternate`
+fixed int64:AT_ATOM = 3i64;    // what a repetition holds: no `Empty`, anchor or boundary
+
+#[derive(Copy)]
+struct:GNode = {
+    int64:kind;
+    int64:val;
+    int64:val2;
+    int64:lazy;
+    int64:first;         // the first child
+    int64:next;          // the next sibling
+    int64:count;         // how many children
+};
+
+// The generator's state: the seed, the group numbering a writer walks, and what was applied.
+#[derive(Copy)]
+struct:Gen = {
+    uint64:rng;
+    int64:group;         // the last group number a writer gave
+    int64:wraps;         // noise: a run of pieces in a `(?:…)`
+    int64:altwraps;      // noise: a run of alternatives in a `(?:…)`
+    int64:empties;       // noise: a `(?:)` among the pieces, or for an `Empty`
+    int64:litcls;        // noise: a literal written as a class or an escape
+    int64:clsnoise;      // noise: a class's members split, overlapped, doubled or reordered
+    int64:quants;        // noise: a quantifier respelt, or an anchor's other name
+};
+
+// xorshift64 (Marsaglia), as `parse_fuzz.npk` writes it.
+func:next_rng = uint64(uint64:s) never fails {
+    uint64:x = s;
+    x = x ^ (x << 13u64);
+    x = x ^ (x >> 7u64);
+    x = x ^ (x << 17u64);
+    pass x;
+};
+
+// A draw below `n`, at most 64, by subtraction: a unit that divided would owe two arms more.
+func:roll = int64(Gen->:g, int64:n) never fails {
+    g.rng = raw next_rng(g.rng);
+    int64:v = ((g.rng >> 20u64) & 63u64) =>! int64;
+    while (v >= n) decreases v { v = v - n; }
+    pass v;
+};
+
+func:add = int64(Vec<GNode>->:t, int64:kind, int64:val, int64:val2) never fails {
+    drop vec_push(t, GNode{ kind: kind, val: val, val2: val2, lazy: 0i64, first: -1i64, next: -1i64, count: 0i64 });
+    pass t.count - 1i64;
+};
+
+// Appends `c` to `p`'s children.
+func:adopt = NIL(Vec<GNode>->:t, int64:p, int64:c) never fails {
+    GNode:x = raw vec_get(<-t, p);
+    if (x.first < 0i64) { x.first = c; }
+    else {
+        int64:m = x.first;
+        GNode:y = raw vec_get(<-t, m);
+        while (y.next >= 0i64) decreases t.count - m {
+            m = y.next;
+            y = raw vec_get(<-t, m);
+        }
+        y.next = c;
+        drop vec_set(t, m, y);
+    }
+    x.count = x.count + 1i64;
+    drop vec_set(t, p, x);
+    pass NIL;
+};
+
+func:popcount = int64(int64:mask) never fails {
+    int64:n = 0i64;
+    int64:i = 0i64;
+    while (i < 12i64) decreases 12i64 - i {
+        if (((mask >> i) & 1i64) != 0i64) { n = n + 1i64; }
+        i = i + 1i64;
+    }
+    pass n;
+};
+
+// A random node in normal form for where it stands, `depth` levels left.
+func:gen = int64(Vec<GNode>->:t, Gen->:g, int64:depth, int64:at) never fails {
+    int64:k = raw roll(g, 16i64);
+    if (depth <= 0i64) { k = 9i64 + (raw roll(g, 7i64)); }
+    if ((k < 3i64) && (at != AT_PIECE)) {                       // a concatenation of two or three pieces
+        int64:n = raw add(t, G_CAT, 0i64, 0i64);
+        int64:pieces = 2i64 + (raw roll(g, 2i64));
+        int64:i = 0i64;
+        while (i < pieces) decreases pieces - i {
+            drop adopt(t, n, raw gen(t, g, depth - 1i64, AT_PIECE));
+            i = i + 1i64;
+        }
+        pass n;
+    }
+    if ((k < 5i64) && (at != AT_ALT)) {                         // an alternation of two or three
+        int64:n = raw add(t, G_ALT, 0i64, 0i64);
+        int64:alts = 2i64 + (raw roll(g, 2i64));
+        int64:i = 0i64;
+        while (i < alts) decreases alts - i {
+            drop adopt(t, n, raw gen(t, g, depth - 1i64, AT_ALT));
+            i = i + 1i64;
+        }
+        pass n;
+    }
+    if (k < 7i64) {                                             // a repetition: `*`, `+`, `?`, `{2}`, `{2,}`, `{1,3}`
+        int64:q = raw roll(g, 6i64);
+        int64:lo = 0i64;
+        int64:hi = -1i64;
+        if (q == 1i64) { lo = 1i64; }
+        else if (q == 2i64) { hi = 1i64; }
+        else if (q == 3i64) { lo = 2i64; hi = 2i64; }
+        else if (q == 4i64) { lo = 2i64; }
+        else if (q == 5i64) { lo = 1i64; hi = 3i64; }
+        int64:n = raw add(t, G_REP, lo, hi);
+        GNode:x = raw vec_get(<-t, n);
+        x.lazy = raw roll(g, 2i64);
+        drop vec_set(t, n, x);
+        drop adopt(t, n, raw gen(t, g, depth - 1i64, AT_ATOM));
+        pass n;
+    }
+    if (k < 9i64) {                                             // a group, named or not
+        int64:n = raw add(t, G_GRP, raw roll(g, 2i64), 0i64);
+        drop adopt(t, n, raw gen(t, g, depth - 1i64, AT_ANY));
+        pass n;
+    }
+    if ((k == 9i64) && (at != AT_PIECE) && (at != AT_ATOM)) { pass raw add(t, G_EMPTY, 0i64, 0i64); }
+    if (((k == 10i64) || (k == 9i64)) && (at != AT_ATOM)) {
+        if ((raw roll(g, 2i64)) == 0i64) { pass raw add(t, G_ANC, raw roll(g, 2i64), 0i64); }
+        pass raw add(t, G_WB, raw roll(g, 2i64), 0i64);
+    }
+    if ((k == 11i64) || (k == 12i64)) {                         // a class of two members or more
+        g.rng = raw next_rng(g.rng);
+        int64:mask = ((g.rng >> 24u64) & 4095u64) =>! int64;
+        if ((raw popcount(mask)) < 2i64) { mask = mask | 3i64; }
+        pass raw add(t, G_CLS, mask, 0i64);
+    }
+    int64:c = raw roll(g, 13i64);
+    int64:byte = 0i64;
+    if ((c < 12i64) && ((raw roll(g, 8i64)) == 0i64)) { byte = 1i64; }
+    pass raw add(t, G_LIT, c, byte);
+};
+
+func:cp_of = int64(int64:c) never fails {
+    if (c == 12i64) { pass 233i64; }
+    pass 97i64 + c;
+};
+
+// Writes a codepoint of the alphabet as itself, UTF-8 for `é`.
+func:put_cp = NIL(Bytes->:b, int64:c) never fails {
+    if (c == 12i64) {
+        drop bytes_push(b, 195u8);
+        drop bytes_push(b, 169u8);
+        pass NIL;
+    }
+    drop bytes_push(b, (97i64 + c) =>! uint8);
+    pass NIL;
+};
+
+func:put_hex = NIL(Bytes->:b, int64:v) never fails {
+    int64:hi = (v >> 4i64) & 15i64;
+    int64:lo = v & 15i64;
+    if (hi < 10i64) { drop bytes_push(b, (48i64 + hi) =>! uint8); } else { drop bytes_push(b, (87i64 + hi) =>! uint8); }
+    if (lo < 10i64) { drop bytes_push(b, (48i64 + lo) =>! uint8); } else { drop bytes_push(b, (87i64 + lo) =>! uint8); }
+    pass NIL;
+};
+
+// A class's members over `a` … `l` as a pattern writes them: plain, its runs in order, `a-c` or
+// `a`; noisy, every member in some range, the ranges split, overlapped and doubled, in any order.
+func:put_class = NIL(Bytes->:b, Gen->:g, int64:mask, bool:noisy) never fails {
+    drop bytes_push(b, 91u8);
+    if (!noisy) {
+        int64:i = 0i64;
+        while (i < 12i64) decreases 12i64 - i {
+            if (((mask >> i) & 1i64) != 0i64) {
+                int64:j = i;
+                while ((j < 11i64) && (((mask >> (j + 1i64)) & 1i64) != 0i64)) decreases 11i64 - j { j = j + 1i64; }
+                drop put_cp(b, i);
+                if (j > i) { drop bytes_push(b, 45u8); drop put_cp(b, j); }
+                i = j;
+            }
+            i = i + 1i64;
+        }
+    }
+    else {
+        g.clsnoise = g.clsnoise + 1i64;
+        int64:left = mask;
+        int64:guard = 0i64;
+        while ((left != 0i64) && (guard < 64i64)) decreases 64i64 - guard {
+            guard = guard + 1i64;
+            int64:s = raw roll(g, 12i64);
+            if (((mask >> s) & 1i64) != 0i64) {
+                int64:e = s;
+                while ((e < 11i64) && (((mask >> (e + 1i64)) & 1i64) != 0i64) && ((raw roll(g, 3i64)) != 0i64))
+                      decreases 11i64 - e { e = e + 1i64; }
+                drop put_cp(b, s);
+                if (e > s) { drop bytes_push(b, 45u8); drop put_cp(b, e); }
+                int64:m = s;
+                while (m <= e) decreases e - m + 1i64 {
+                    left = left & (~(1i64 << m));
+                    m = m + 1i64;
+                }
+            }
+        }
+        // anything the draws missed, in order
+        int64:i = 0i64;
+        while (i < 12i64) decreases 12i64 - i {
+            if (((left >> i) & 1i64) != 0i64) { drop put_cp(b, i); }
+            i = i + 1i64;
+        }
+    }
+    drop bytes_push(b, 93u8);
+    pass NIL;
+};
+
+// Writes node `i` as a pattern, standing where `at` says.
+func:put_pat = NIL(Vec<GNode>->:t, Gen->:g, int64:i, int64:at, bool:noisy, Bytes->:b) never fails {
+    GNode:x = raw vec_get(<-t, i);
+    if (x.kind == G_LIT) {
+        if (x.val2 != 0i64) { drop bytes_extend_str(b, "(?-u:"); }
+        int64:how = 0i64;
+        if (noisy) { how = raw roll(g, 4i64); }
+        if (how == 1i64) { g.litcls = g.litcls + 1i64; drop bytes_push(b, 91u8); drop put_cp(b, x.val); drop bytes_push(b, 93u8); }
+        else if (how == 2i64) { g.litcls = g.litcls + 1i64; drop bytes_push(b, 91u8); drop put_cp(b, x.val); drop put_cp(b, x.val); drop bytes_push(b, 93u8); }
+        else if (how == 3i64) { g.litcls = g.litcls + 1i64; drop bytes_extend_str(b, "\\x"); drop put_hex(b, raw cp_of(x.val)); }
+        else { drop put_cp(b, x.val); }
+        if (x.val2 != 0i64) { drop bytes_push(b, 41u8); }
+        pass NIL;
+    }
+    if (x.kind == G_CLS) { drop put_class(b, g, x.val, noisy); pass NIL; }
+    if (x.kind == G_ANC) {
+        bool:other = noisy && ((raw roll(g, 2i64)) == 0i64);
+        if (other) { g.quants = g.quants + 1i64; }
+        if (x.val == 0i64) { if (other) { drop bytes_extend_str(b, "\\A"); } else { drop bytes_push(b, 94u8); } }
+        else { if (other) { drop bytes_extend_str(b, "\\z"); } else { drop bytes_push(b, 36u8); } }
+        pass NIL;
+    }
+    if (x.kind == G_WB) {
+        if (x.val == 0i64) { drop bytes_extend_str(b, "\\b"); } else { drop bytes_extend_str(b, "\\B"); }
+        pass NIL;
+    }
+    if (x.kind == G_EMPTY) {
+        if (noisy && ((raw roll(g, 2i64)) == 0i64)) { g.empties = g.empties + 1i64; drop bytes_extend_str(b, "(?:)"); }
+        pass NIL;
+    }
+    if (x.kind == G_GRP) {
+        g.group = g.group + 1i64;
+        if (x.val != 0i64) {
+            drop bytes_extend_str(b, "(?<g");
+            drop bytes_put_uint(b, g.group =>! uint64);
+            drop bytes_push(b, 62u8);
+        }
+        else { drop bytes_push(b, 40u8); }
+        drop put_pat(t, g, x.first, AT_ANY, noisy, b);
+        drop bytes_push(b, 41u8);
+        pass NIL;
+    }
+    if (x.kind == G_REP) {
+        GNode:c = raw vec_get(<-t, x.first);
+        bool:wrap = (c.kind == G_CAT) || (c.kind == G_ALT) || (c.kind == G_REP)
+                    || (noisy && ((raw roll(g, 4i64)) == 0i64));
+        if (wrap) { drop bytes_extend_str(b, "(?:"); }
+        drop put_pat(t, g, x.first, AT_ANY, noisy, b);
+        if (wrap) { drop bytes_push(b, 41u8); }
+        bool:other = noisy && ((raw roll(g, 2i64)) == 0i64);
+        if (other) { g.quants = g.quants + 1i64; }
+        if ((x.val == 0i64) && (x.val2 == -1i64) && (!other)) { drop bytes_push(b, 42u8); }
+        else if ((x.val == 1i64) && (x.val2 == -1i64) && (!other)) { drop bytes_push(b, 43u8); }
+        else if ((x.val == 0i64) && (x.val2 == 1i64) && (!other)) { drop bytes_push(b, 63u8); }
+        else {
+            drop bytes_push(b, 123u8);
+            drop bytes_put_uint(b, x.val =>! uint64);
+            if (x.val2 != x.val) {
+                drop bytes_push(b, 44u8);
+                if (x.val2 >= 0i64) { drop bytes_put_uint(b, x.val2 =>! uint64); }
+            }
+            else if (other) { drop bytes_push(b, 44u8); drop bytes_put_uint(b, x.val2 =>! uint64); }
+            drop bytes_push(b, 125u8);
+        }
+        if (x.lazy != 0i64) { drop bytes_push(b, 63u8); }
+        pass NIL;
+    }
+    if (x.kind == G_ALT) {
+        bool:paren = at == AT_PIECE;
+        if (paren) { drop bytes_extend_str(b, "(?:"); }
+        int64:ws = -1i64;
+        int64:we = -1i64;
+        if (noisy && ((raw roll(g, 2i64)) == 0i64)) {
+            g.altwraps = g.altwraps + 1i64;
+            ws = raw roll(g, x.count);
+            we = ws + (raw roll(g, x.count - ws));
+        }
+        int64:m = x.first;
+        int64:k = 0i64;
+        while (m >= 0i64) decreases x.count - k {
+            if (k > 0i64) { drop bytes_push(b, 124u8); }
+            if (k == ws) { drop bytes_extend_str(b, "(?:"); }
+            drop put_pat(t, g, m, AT_ALT, noisy, b);
+            if (k == we) { drop bytes_push(b, 41u8); }
+            GNode:y = raw vec_get(<-t, m);
+            m = y.next;
+            k = k + 1i64;
+        }
+        if (paren) { drop bytes_push(b, 41u8); }
+        pass NIL;
+    }
+    // a concatenation
+    int64:ws = -1i64;
+    int64:we = -1i64;
+    int64:ins = -1i64;
+    if (noisy && ((raw roll(g, 2i64)) == 0i64)) {
+        g.wraps = g.wraps + 1i64;
+        ws = raw roll(g, x.count);
+        we = ws + (raw roll(g, x.count - ws));
+    }
+    if (noisy && ((raw roll(g, 3i64)) == 0i64)) {
+        g.empties = g.empties + 1i64;
+        ins = raw roll(g, x.count + 1i64);
+    }
+    int64:m = x.first;
+    int64:k = 0i64;
+    while (m >= 0i64) decreases x.count - k {
+        if (k == ins) { drop bytes_extend_str(b, "(?:)"); }
+        if (k == ws) { drop bytes_extend_str(b, "(?:"); }
+        drop put_pat(t, g, m, AT_PIECE, noisy, b);
+        if (k == we) { drop bytes_push(b, 41u8); }
+        GNode:y = raw vec_get(<-t, m);
+        m = y.next;
+        k = k + 1i64;
+    }
+    if (ins == x.count) { drop bytes_extend_str(b, "(?:)"); }
+    pass NIL;
+};
+
+// Writes node `i`'s expected normal form as H-15's text: the tree is in normal form already.
+func:put_dump = NIL(Vec<GNode>->:t, Gen->:g, int64:i, Bytes->:b) never fails {
+    GNode:x = raw vec_get(<-t, i);
+    if (x.kind == G_LIT) {
+        drop bytes_extend_str(b, "(literal ");
+        if (x.val2 != 0i64) { drop bytes_extend_str(b, "byte "); }
+        drop bytes_put_uint(b, (raw cp_of(x.val)) =>! uint64);
+        drop bytes_push(b, 41u8);
+        pass NIL;
+    }
+    if (x.kind == G_CLS) {
+        drop bytes_extend_str(b, "(class");
+        int64:s = 0i64;
+        while (s < 12i64) decreases 12i64 - s {
+            if (((x.val >> s) & 1i64) != 0i64) {
+                int64:e = s;
+                while ((e < 11i64) && (((x.val >> (e + 1i64)) & 1i64) != 0i64)) decreases 11i64 - e { e = e + 1i64; }
+                drop bytes_push(b, 32u8);
+                drop bytes_put_uint(b, (97i64 + s) =>! uint64);
+                drop bytes_push(b, 45u8);
+                drop bytes_put_uint(b, (97i64 + e) =>! uint64);
+                s = e;
+            }
+            s = s + 1i64;
+        }
+        drop bytes_push(b, 41u8);
+        pass NIL;
+    }
+    if (x.kind == G_ANC) {
+        if (x.val == 0i64) { drop bytes_extend_str(b, "(anchor text-start)"); } else { drop bytes_extend_str(b, "(anchor text-end)"); }
+        pass NIL;
+    }
+    if (x.kind == G_WB) {
+        if (x.val == 0i64) { drop bytes_extend_str(b, "(wordboundary)"); } else { drop bytes_extend_str(b, "(wordboundary not)"); }
+        pass NIL;
+    }
+    if (x.kind == G_EMPTY) { drop bytes_extend_str(b, "(empty)"); pass NIL; }
+    if (x.kind == G_GRP) {
+        g.group = g.group + 1i64;
+        drop bytes_extend_str(b, "(group ");
+        drop bytes_put_uint(b, g.group =>! uint64);
+        if (x.val != 0i64) {
+            drop bytes_extend_str(b, " g");
+            drop bytes_put_uint(b, g.group =>! uint64);
+        }
+        drop bytes_push(b, 32u8);
+        drop put_dump(t, g, x.first, b);
+        drop bytes_push(b, 41u8);
+        pass NIL;
+    }
+    if (x.kind == G_REP) {
+        drop bytes_extend_str(b, "(repeat ");
+        if (x.lazy != 0i64) { drop bytes_extend_str(b, "lazy "); }
+        drop bytes_put_uint(b, x.val =>! uint64);
+        if (x.val2 < 0i64) { drop bytes_extend_str(b, " -"); }
+        else { drop bytes_push(b, 32u8); drop bytes_put_uint(b, x.val2 =>! uint64); }
+        drop bytes_push(b, 32u8);
+        drop put_dump(t, g, x.first, b);
+        drop bytes_push(b, 41u8);
+        pass NIL;
+    }
+    if (x.kind == G_ALT) { drop bytes_extend_str(b, "(alternate"); } else { drop bytes_extend_str(b, "(concat"); }
+    int64:m = x.first;
+    int64:k = 0i64;
+    while (m >= 0i64) decreases x.count - k {
+        drop bytes_push(b, 32u8);
+        drop put_dump(t, g, m, b);
+        GNode:y = raw vec_get(<-t, m);
+        m = y.next;
+        k = k + 1i64;
+    }
+    drop bytes_push(b, 41u8);
+    pass NIL;
+};
+
+// The text of a whole tree, as a pattern or as its expected dump; groups numbered from 1.
+func:pattern_of = string(Vec<GNode>->:t, Gen->:g, int64:root, bool:noisy) never fails {
+    Bytes:b = raw bytes_init(64i64);
+    g.group = 0i64;
+    drop put_pat(t, g, root, AT_ANY, noisy, @b);
+    pass raw bytes_copy_string(@b);
+};
+
+// The noisy text, never the plain one: when the draws leave a tree as it was -- a lone `\b` has no
+// other spelling -- the whole pattern goes in a `(?:…)`, which the build already erases.
+func:noisy_of = string(Vec<GNode>->:t, Gen->:g, int64:root, string:plain) never fails {
+    string:q = raw pattern_of(t, g, root, true);
+    if (!(string_equals(q, plain))) { pass q; }
+    g.wraps = g.wraps + 1i64;
+    pass string_concat(string_concat("(?:", q), ")");
+};
+
+func:dump_of = string(Vec<GNode>->:t, Gen->:g, int64:root) never fails {
+    Bytes:b = raw bytes_init(64i64);
+    g.group = 0i64;
+    drop put_dump(t, g, root, @b);
+    pass raw bytes_copy_string(@b);
+};
+
+// Parses, builds and normalises `pattern`, its normal dump into `nb` and its built one into `bb`:
+// 0, or the case's number when the pattern does not parse or build.
+func:normal_of = int32(string:pattern, Bytes->:nb, Bytes->:bb) never fails {
+    fixed uint8[]:pat = string_bytes(pattern);
+    Ast:t = raw ast_init(8i64);
+    int32:r = 0i32;
+    if ((raw parse_pattern(pat, @t)) != NIL) { r = 10i32; }
+    else {
+        Hir:h = raw hir_init(8i64);
+        if ((raw hir_build(pat, t, @h)) != HIR_NONE) { r = 10i32; }
+        else {
+            drop hir_dump(@h, bb);
+            Hir:n = raw hir_init(8i64);
+            drop hir_normalise(@h, @n);
+            drop hir_dump(@n, nb);
+            drop hir_free(@n);
+        }
+        drop hir_free(@h);
+    }
+    drop ast_free(@t);
+    pass r;
+};
+
+func:same_text = bool(Bytes->:b, string:s) never fails {
+    fixed uint8[]:w = string_bytes(s);
+    if ((raw bytes_len(b)) != w.len) { pass false; }
+    int64:i = 0i64;
+    while (i < w.len) decreases w.len - i {
+        if ((raw bytes_get(b, i)) != w[i]) { pass false; }
+        i = i + 1i64;
+    }
+    pass true;
+};
+
+func:same_bytes = bool(Bytes->:a, Bytes->:b) never fails {
+    int64:n = raw bytes_len(a);
+    if (n != (raw bytes_len(b))) { pass false; }
+    int64:i = 0i64;
+    while (i < n) decreases n - i {
+        if ((raw bytes_get(a, i)) != (raw bytes_get(b, i))) { pass false; }
+        i = i + 1i64;
+    }
+    pass true;
+};
+
+// One mutation outside the identities, of kind `kind`, at the first node it applies to; answers
+// whether one did. 0: an alternation's first two alternatives swapped, where their texts differ; 1: a
+// literal's byte bit flipped, `a` … `l` only; 2: a concatenation's first two pieces swapped, where
+// their texts differ; 3: a repetition's laziness flipped.
+func:mutate = bool(Vec<GNode>->:t, Gen->:g, int64:kind) never fails {
+    int64:i = 0i64;
+    while (i < t.count) decreases t.count - i {
+        GNode:x = raw vec_get(<-t, i);
+        if ((kind == 1i64) && (x.kind == G_LIT) && (x.val < 12i64)) {
+            x.val2 = 1i64 - x.val2;
+            drop vec_set(t, i, x);
+            pass true;
+        }
+        if ((kind == 3i64) && (x.kind == G_REP)) {
+            x.lazy = 1i64 - x.lazy;
+            drop vec_set(t, i, x);
+            pass true;
+        }
+        if (((kind == 0i64) && (x.kind == G_ALT)) || ((kind == 2i64) && (x.kind == G_CAT))) {
+            // the first two members swapped, by relinking, when their expected texts differ
+            int64:a = x.first;
+            GNode:ya = raw vec_get(<-t, a);
+            int64:c = ya.next;
+            GNode:yc = raw vec_get(<-t, c);
+            string:sa = raw dump_of(t, g, a);
+            string:sc = raw dump_of(t, g, c);
+            if (!(string_equals(sa, sc))) {
+                ya.next = yc.next;
+                yc.next = a;
+                drop vec_set(t, a, ya);
+                drop vec_set(t, c, yc);
+                x.first = c;
+                drop vec_set(t, i, x);
+                pass true;
+            }
+        }
+        i = i + 1i64;
+    }
+    pass false;
+};
+
+func:run = int32() never fails {
+    Gen:g = Gen{ rng: 1442695040888963407u64, group: 0i64, wraps: 0i64, altwraps: 0i64, empties: 0i64,
+                 litcls: 0i64, clsnoise: 0i64, quants: 0i64 };
+    int64:pairs = 0i64;
+    int64:joined = 0i64;
+    int64[4]:mutants = [0i64, 0i64, 0i64, 0i64];
+    int64:n = 0i64;
+    while (n < TREES) decreases TREES - n {
+        Vec<GNode>:t = raw vec_init::<GNode>(32i64);
+        int64:root = raw gen(@t, @g, DEPTH, AT_ANY);
+        string:want = raw dump_of(@t, @g, root);
+        string:plain = raw pattern_of(@t, @g, root, false);
+        string:noisy = raw noisy_of(@t, @g, root, plain);
+        Bytes:pn = raw bytes_init(64i64);
+        Bytes:pb = raw bytes_init(64i64);
+        Bytes:qn = raw bytes_init(64i64);
+        Bytes:qb = raw bytes_init(64i64);
+        int32:r = raw normal_of(plain, @pn, @pb);
+        if (r != 0i32) { pass r; }
+        if (!(raw same_text(@pn, want))) { pass 11i32; }
+        r = raw normal_of(noisy, @qn, @qb);
+        if (r != 0i32) { pass r; }
+        if (!(raw same_text(@qn, want))) { pass 12i32; }
+        if (!(string_equals(plain, noisy))) {
+            pairs = pairs + 1i64;
+            if (!(raw same_bytes(@pb, @qb))) { joined = joined + 1i64; }
+        }
+        // the other half: one mutation, its kind in turn
+        int64:kind = n & 3i64;
+        if (raw mutate(@t, @g, kind)) {
+            mutants[kind] = mutants[kind] + 1i64;
+            string:mwant = raw dump_of(@t, @g, root);
+            string:mpat = raw pattern_of(@t, @g, root, (n & 4i64) != 0i64);
+            Bytes:mn = raw bytes_init(64i64);
+            Bytes:mb = raw bytes_init(64i64);
+            r = raw normal_of(mpat, @mn, @mb);
+            if (r != 0i32) { pass r; }
+            if (raw same_bytes(@mn, @pn)) { pass 14i32; }
+            if (!(raw same_text(@mn, mwant))) { pass 15i32; }
+        }
+        drop vec_free(@t);
+        n = n + 1i64;
+    }
+    if (pairs < PAIRS_FLOOR) { pass 13i32; }
+    if (joined < JOINED_FLOOR) { pass 16i32; }
+    if ((g.wraps < NOISE_FLOOR) || (g.altwraps < NOISE_FLOOR) || (g.empties < NOISE_FLOOR) || (g.litcls < NOISE_FLOOR)
+        || (g.clsnoise < NOISE_FLOOR) || (g.quants < NOISE_FLOOR)) { pass 17i32; }
+    if ((mutants[0] < MUTANT_FLOOR) || (mutants[1] < MUTANT_FLOOR) || (mutants[2] < MUTANT_FLOOR) || (mutants[3] < MUTANT_FLOOR)) { pass 17i32; }
+    pass 0i32;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    exit raw run();
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (DecreasesViolated) { exit 108i32; },
+        (LimitViolated)     { exit 109i32; },
+        (ShiftRange)        { exit 115i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
