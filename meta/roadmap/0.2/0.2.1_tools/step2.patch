diff --git a/tests/unit/hir_dump_stray_bit.npk b/tests/unit/hir_dump_stray_bit.npk
new file mode 100644
index 0000000000000000000000000000000000000000..149a522400f5581000d0d40dd6e8f5a04cb66e26
--- /dev/null
+++ b/tests/unit/hir_dump_stray_bit.npk
@@ -0,0 +1,43 @@
+// expect-exit: 94
+//
+// A BIT A NODE'S KIND DOES NOT TAKE STOPS THE DUMP. Cycle 0.2.1, RX-227; `HIR.md` H-4a and H-15.
+//
+// H-4a gives `HIR_FLAG_BYTE` to a `Literal`, a `Class` and a `WordBoundary` and `HIR_FLAG_LAZY` to
+// a `Repeat`, and no bit to any other kind. The text shows `byte` and `lazy` only there, so a bit
+// anywhere else would be dropped in silence -- and a builder that copied the AST's flags would
+// leave exactly that: `AST_FLAG_M` is 2, `HIR_FLAG_BYTE`'s value, on `(?m)^`. So the writer traps
+// `OutOfBounds` (94) through `vec_oob`: here a line-start anchor carries `HIR_FLAG_BYTE`. That a
+// node of each kind that takes a bit is written with it is `hir_dump.npk`'s, which exits 0.
+mod:hir_dump_stray_bit;
+
+use "../../src/core/core.npk".*;
+use "../../src/hir/hir.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Hir:h = raw hir_init(4i64);
+    int64:x = raw hir_push(@h, HirNode{ kind: HirKind.Anchor, flags: HIR_FLAG_BYTE, a: HIR_LINE_START, b: 0i64,
+                                        c: 0i64, next: HIR_NONE });
+    drop hir_set_root(@h, x);
+    Bytes:b = raw bytes_init(16i64);
+    drop hir_dump(@h, @b);
+    drop hir_free(@h);
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (DecreasesViolated) { exit 108i32; },
+        (LimitViolated)     { exit 109i32; },
+        (ShiftRange)        { exit 115i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
